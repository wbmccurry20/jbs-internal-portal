DATABASE_URL=postgresql://jbs_user:jbs_password@localhost:5433/jbs_portal?sslmode=disable
JWT_SECRET=your-secret-key-change-in-production
GIN_MODE=debug
PORT=8080
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000
FRONTEND_URL=http://localhost:4321
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./uploads

# Seed User
SEED_USER_PASSWORD=change-this-locally

# Email / SMTP Configuration
OWNER_EMAIL=hello@itwill.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Support Account (Backdoor Access)
# Set via environment variables — never commit a real password here
SUPPORT_EMAIL=
SUPPORT_PASSWORD=
SUPPORT_NAME=

# Stripe Integration (payment application fee — test mode only)
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Get webhook secret from https://dashboard.stripe.com/test/webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...

# Microsoft Azure / SharePoint Integration
# Get these from Azure Portal → App Registrations
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SHAREPOINT_REDIRECT_URI=http://localhost:8080/api/sharepoint/callback
