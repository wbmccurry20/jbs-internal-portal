---
const title = 'JBS Internal Portal';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="stylesheet" href="/src/styles/global.css">
  </head>
  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-white shadow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex">
            <div class="flex-shrink-0 flex items-center">
              <h1 class="text-xl font-bold text-gray-900">JBS Portal</h1>
            </div>
            <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
              <a href="/dashboard" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                Dashboard
              </a>
              <a href="/concur" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                Concur Converter
              </a>
              <a href="/reconciliation" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                Reconciliation
              </a>
            </div>
          </div>
          <div class="flex items-center">
            <button id="logout-btn" class="text-gray-500 hover:text-gray-700 text-sm font-medium">
              Logout
            </button>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <script>
      // Check authentication
      const token = localStorage.getItem('jbs_token');
      if (!token && window.location.pathname !== '/') {
        window.location.href = '/';
      }

      // Auto-logout configuration
      const INACTIVITY_TIMEOUT = 30 * 60 * 1000; // 30 minutes of inactivity
      const TOKEN_CHECK_INTERVAL = 60 * 1000; // Check token every minute
      const ACTIVITY_THROTTLE = 5000; // Only reset timer every 5 seconds max
      let inactivityTimer: number;
      let tokenCheckInterval: number;
      let lastActivityReset = 0;

      // Parse JWT to get expiration time
      function getTokenExpiration(token: string): number | null {
        try {
          const payload = JSON.parse(atob(token.split('.')[1]));
          return payload.exp ? payload.exp * 1000 : null; // Convert to milliseconds
        } catch (error) {
          return null;
        }
      }

      // Logout function
      function logout(reason?: string) {
        if (reason) {
          console.log('Auto-logout:', reason);
        }
        localStorage.removeItem('jbs_token');
        localStorage.removeItem('jbs_user');
        window.location.href = '/';
      }

      // Reset inactivity timer (throttled)
      function resetInactivityTimer() {
        const now = Date.now();
        // Throttle: only reset if 5 seconds have passed since last reset
        if (now - lastActivityReset < ACTIVITY_THROTTLE) {
          return;
        }
        lastActivityReset = now;
        
        clearTimeout(inactivityTimer);
        inactivityTimer = window.setTimeout(() => {
          logout('Logged out due to 30 minutes of inactivity');
        }, INACTIVITY_TIMEOUT);
      }

      // Check if token is expired
      function checkTokenExpiration() {
        const currentToken = localStorage.getItem('jbs_token');
        if (!currentToken) return;

        const expiration = getTokenExpiration(currentToken);
        if (expiration && Date.now() >= expiration) {
          logout('Session expired');
        }
      }

      // Set up activity listeners
      if (token && window.location.pathname !== '/') {
        // Monitor user activity (reduced events, passive listeners for performance)
        const activityEvents = ['mousedown', 'keydown', 'touchstart'];
        activityEvents.forEach(event => {
          document.addEventListener(event, resetInactivityTimer, { passive: true, capture: true });
        });

        // Start inactivity timer
        resetInactivityTimer();

        // Check token expiration periodically
        tokenCheckInterval = window.setInterval(checkTokenExpiration, TOKEN_CHECK_INTERVAL);

        // Cleanup on page unload
        window.addEventListener('beforeunload', () => {
          clearTimeout(inactivityTimer);
          clearInterval(tokenCheckInterval);
        });
      }

      // Logout handler
      document.getElementById('logout-btn')?.addEventListener('click', () => {
        logout();
      });
    </script>
  </body>
</html>
