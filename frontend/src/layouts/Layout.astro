---
import '../styles/global.css';
const title = 'JBS Internal Portal';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-gray-50 min-h-screen font-sans">
    <nav class="bg-white shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-20">
          <!-- Logo and primary navigation -->
          <div class="flex items-center space-x-8">
            <!-- Logo -->
            <div class="flex-shrink-0 flex items-center">
              <a href="/dashboard" class="flex items-center">
                <img src="/jbs-logo.svg" alt="JBS Construction" class="h-12 w-auto">
              </a>
            </div>

            <!-- Desktop navigation - items shown/hidden by role via JS -->
            <div class="hidden md:flex md:space-x-1">
              <a href="/dashboard" class="nav-link group" id="nav-dashboard">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
                Dashboard
              </a>
              
              <a href="/jobs" class="nav-link group hidden" id="nav-jobs">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                Jobs
              </a>
              
              <a href="/bids" class="nav-link group hidden" id="nav-bids">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                Bids
              </a>
              
              <a href="/superintendents" class="nav-link group hidden" id="nav-supers">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                Superintendents
              </a>
              
              <a href="/licensing" class="nav-link group hidden" id="nav-licensing">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                Licensing
              </a>

              <a href="/training" class="nav-link group hidden" id="nav-training">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                Training
              </a>

              <a href="/users" class="nav-link group hidden" id="nav-users">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                Users
              </a>

              <!-- Finance Tools dropdown -->
              <div class="relative group hidden" id="nav-finance">
                <button class="nav-link inline-flex items-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  Finance
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
                
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  <div class="bg-white rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 py-1">
                    <a href="/concur" class="dropdown-item">
                      <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                      </svg>
                      Concur Converter
                    </a>
                    <a href="/reconciliation" class="dropdown-item">
                      <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                      </svg>
                      Reconciliation
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right side: User menu and logout -->
          <div class="flex items-center space-x-4">
            <!-- User info -->
            <div class="hidden sm:flex items-center space-x-3">
              <div class="text-right">
                <p id="user-name" class="text-sm font-semibold text-gray-900"></p>
                <p id="user-role" class="text-xs text-gray-500 capitalize"></p>
              </div>
              <div class="h-10 w-10 rounded-full bg-primary-500 flex items-center justify-center text-white font-semibold">
                <span id="user-initials"></span>
              </div>
            </div>

            <!-- Logout button -->
            <button id="logout-btn" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
              </svg>
              Logout
            </button>

            <!-- Mobile menu button -->
            <button id="mobile-menu-btn" class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-primary-600 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary-500">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 bg-white">
        <div class="pt-2 pb-3 space-y-1">
          <a href="/dashboard" class="mobile-nav-link" id="mobile-nav-dashboard">Dashboard</a>
          <a href="/jobs" class="mobile-nav-link hidden" id="mobile-nav-jobs">Jobs</a>
          <a href="/bids" class="mobile-nav-link hidden" id="mobile-nav-bids">Bids</a>
          <a href="/superintendents" class="mobile-nav-link hidden" id="mobile-nav-supers">Superintendents</a>
          <a href="/licensing" class="mobile-nav-link hidden" id="mobile-nav-licensing">Licensing</a>
          <a href="/training" class="mobile-nav-link hidden" id="mobile-nav-training">Training</a>
          <a href="/users" class="mobile-nav-link hidden" id="mobile-nav-users">Manage Users</a>
          <div class="border-t border-gray-200 my-2 hidden" id="mobile-nav-finance-divider"></div>
          <a href="/concur" class="mobile-nav-link hidden" id="mobile-nav-concur">Concur Converter</a>
          <a href="/reconciliation" class="mobile-nav-link hidden" id="mobile-nav-reconciliation">Reconciliation</a>
        </div>
      </div>
    </nav>

    <style>
      .nav-link {
        @apply inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 rounded-lg transition-colors;
      }
      
      .nav-link.active {
        @apply text-primary-600 bg-primary-50;
      }
      
      .dropdown-item {
        @apply flex items-center px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors;
      }
      
      .mobile-nav-link {
        @apply block pl-6 pr-4 py-3 text-base font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 border-l-4 border-transparent hover:border-primary-500;
      }
    </style>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <script>
      // Check authentication
      const token = localStorage.getItem('jbs_token');
      if (!token && window.location.pathname !== '/') {
        window.location.href = '/';
      }

      // Display user info
      const userStr = localStorage.getItem('jbs_user');
      if (userStr) {
        try {
          const user = JSON.parse(userStr);
          const nameEl = document.getElementById('user-name');
          const roleEl = document.getElementById('user-role');
          const initialsEl = document.getElementById('user-initials');
          
          if (nameEl && user.name) {
            nameEl.textContent = user.name;
          }
          // Display friendly role labels
          const roleLabels: Record<string, string> = {
            'executive': 'Executive',
            'hr_admin': 'HR Admin',
            'finance': 'Finance',
            'project_manager': 'Project Manager',
            'construction_admin': 'Construction Admin',
            'trainee': 'Trainee',
            'support': 'IT Support',
          };
          if (roleEl && user.role) {
            roleEl.textContent = roleLabels[user.role] || user.role;
          }
          if (initialsEl && user.name) {
            const names = user.name.split(' ');
            const initials = names.length >= 2 
              ? names[0][0] + names[names.length - 1][0]
              : names[0][0];
            initialsEl.textContent = initials.toUpperCase();
          }

          // RBAC nav visibility
          const role = user.role;
          const show = (ids: string[]) => ids.forEach(id => {
            document.getElementById(id)?.classList.remove('hidden');
          });

          // Everyone gets dashboard
          // Role-specific nav items:
          if (role === 'executive' || role === 'support') {
            // Full access to everything
            show(['nav-jobs', 'nav-bids', 'nav-supers', 'nav-licensing', 'nav-training', 'nav-users', 'nav-finance',
                  'mobile-nav-jobs', 'mobile-nav-bids', 'mobile-nav-supers', 'mobile-nav-licensing', 'mobile-nav-training', 'mobile-nav-users',
                  'mobile-nav-finance-divider', 'mobile-nav-concur', 'mobile-nav-reconciliation']);
          } else if (role === 'hr_admin') {
            show(['nav-jobs', 'nav-bids', 'nav-supers', 'nav-licensing', 'nav-training', 'nav-users',
                  'mobile-nav-jobs', 'mobile-nav-bids', 'mobile-nav-supers', 'mobile-nav-licensing', 'mobile-nav-training', 'mobile-nav-users']);
          } else if (role === 'finance') {
            show(['nav-jobs', 'nav-bids', 'nav-finance',
                  'mobile-nav-jobs', 'mobile-nav-bids', 'mobile-nav-finance-divider', 'mobile-nav-concur', 'mobile-nav-reconciliation']);
          } else if (role === 'project_manager') {
            show(['nav-jobs', 'nav-bids', 'nav-supers', 'nav-licensing', 'nav-training',
                  'mobile-nav-jobs', 'mobile-nav-bids', 'mobile-nav-supers', 'mobile-nav-licensing', 'mobile-nav-training']);
            // Trainees see their schedule; PMs see their own training too
            const trainingNav = document.getElementById('nav-training');
            const mobileTrainingNav = document.getElementById('mobile-nav-training');
            if (trainingNav) {
              trainingNav.setAttribute('href', '/training/schedule');
              trainingNav.lastChild && (trainingNav.lastChild.textContent = ' My Training');
            }
            if (mobileTrainingNav) {
              mobileTrainingNav.setAttribute('href', '/training/schedule');
              mobileTrainingNav.textContent = 'My Training';
            }
          } else if (role === 'construction_admin') {
            show(['nav-jobs', 'nav-bids', 'nav-supers', 'nav-licensing', 'nav-training',
                  'mobile-nav-jobs', 'mobile-nav-bids', 'mobile-nav-supers', 'mobile-nav-licensing', 'mobile-nav-training']);
            const trainingNav = document.getElementById('nav-training');
            const mobileTrainingNav = document.getElementById('mobile-nav-training');
            if (trainingNav) {
              trainingNav.setAttribute('href', '/training/schedule');
              trainingNav.lastChild && (trainingNav.lastChild.textContent = ' My Training');
            }
            if (mobileTrainingNav) {
              mobileTrainingNav.setAttribute('href', '/training/schedule');
              mobileTrainingNav.textContent = 'My Training';
            }
          } else if (role === 'trainee') {
            show(['nav-training', 'mobile-nav-training']);
            const trainingNav = document.getElementById('nav-training');
            const mobileTrainingNav = document.getElementById('mobile-nav-training');
            if (trainingNav) {
              trainingNav.setAttribute('href', '/training/schedule');
              trainingNav.lastChild && (trainingNav.lastChild.textContent = ' My Training');
            }
            if (mobileTrainingNav) {
              mobileTrainingNav.setAttribute('href', '/training/schedule');
              mobileTrainingNav.textContent = 'My Training';
            }
          }
        } catch (error) {
          console.error('Error parsing user data:', error);
        }
      }

      // Mobile menu toggle
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      
      mobileMenuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });

      // Highlight active nav link
      const currentPath = window.location.pathname;
      document.querySelectorAll('.nav-link, .mobile-nav-link').forEach(link => {
        const href = link.getAttribute('href');
        if (href && currentPath.startsWith(href) && href !== '/') {
          link.classList.add('active');
        }
        if (href === '/dashboard' && currentPath === '/dashboard') {
          link.classList.add('active');
        }
      });

      // Auto-logout configuration
      const INACTIVITY_TIMEOUT = 30 * 60 * 1000; // 30 minutes of inactivity
      const TOKEN_CHECK_INTERVAL = 60 * 1000; // Check token every minute
      const ACTIVITY_THROTTLE = 5000; // Only reset timer every 5 seconds max
      let inactivityTimer: number;
      let tokenCheckInterval: number;
      let lastActivityReset = 0;

      // Parse JWT to get expiration time
      function getTokenExpiration(token: string): number | null {
        try {
          const payload = JSON.parse(atob(token.split('.')[1]));
          return payload.exp ? payload.exp * 1000 : null; // Convert to milliseconds
        } catch (error) {
          return null;
        }
      }

      // Logout function
      function logout(reason?: string) {
        localStorage.removeItem('jbs_token');
        localStorage.removeItem('jbs_user');
        window.location.href = '/';
      }

      // Reset inactivity timer (throttled)
      function resetInactivityTimer() {
        const now = Date.now();
        // Throttle: only reset if 5 seconds have passed since last reset
        if (now - lastActivityReset < ACTIVITY_THROTTLE) {
          return;
        }
        lastActivityReset = now;
        
        clearTimeout(inactivityTimer);
        inactivityTimer = window.setTimeout(() => {
          logout('Logged out due to 30 minutes of inactivity');
        }, INACTIVITY_TIMEOUT);
      }

      // Check if token is expired
      function checkTokenExpiration() {
        const currentToken = localStorage.getItem('jbs_token');
        if (!currentToken) return;

        const expiration = getTokenExpiration(currentToken);
        if (expiration && Date.now() >= expiration) {
          logout('Session expired');
        }
      }

      // Set up activity listeners
      if (token && window.location.pathname !== '/') {
        // Monitor user activity (reduced events, passive listeners for performance)
        const activityEvents = ['mousedown', 'keydown', 'touchstart'];
        activityEvents.forEach(event => {
          document.addEventListener(event, resetInactivityTimer, { passive: true, capture: true });
        });

        // Start inactivity timer
        resetInactivityTimer();

        // Check token expiration periodically
        tokenCheckInterval = window.setInterval(checkTokenExpiration, TOKEN_CHECK_INTERVAL);

        // Cleanup on page unload
        window.addEventListener('beforeunload', () => {
          clearTimeout(inactivityTimer);
          clearInterval(tokenCheckInterval);
        });
      }

      // Logout handler
      document.getElementById('logout-btn')?.addEventListener('click', () => {
        logout();
      });
    </script>
  </body>
</html>
