---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'JBS Internal Portal' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>
  <body class="bg-gray-50 min-h-screen font-sans">
    <nav class="bg-jbs-dark border-b border-white/10">
      <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-14">
          <!-- Logo and primary navigation -->
          <div class="flex items-center">
            <!-- Logo -->
            <div class="flex-shrink-0 flex items-center mr-6">
              <a href="/dashboard" id="logo-link" class="flex items-center">
                <img src="/jbs_new_logo.png" alt="JBS" class="h-7 w-auto" style="mix-blend-mode:screen;filter:brightness(1.1);">
              </a>
            </div>

            <!-- Desktop navigation -->
            <div class="hidden lg:flex lg:items-center lg:space-x-1">
              <a href="/dashboard" class="nav-link hidden" id="nav-dashboard">Dashboard</a>
              <a href="/jobs" class="nav-link hidden" id="nav-jobs">Jobs</a>
              <a href="/bids" class="nav-link hidden" id="nav-bids">Bids</a>
              <a href="/email-automation" class="nav-link hidden" id="nav-email">Email</a>
              <a href="/superintendents" class="nav-link hidden" id="nav-supers">Supers</a>
              <a href="/licensing" class="nav-link hidden" id="nav-licensing">Licensing</a>
              <a href="/training" class="nav-link hidden" id="nav-training">Training</a>
              <a href="/users" class="nav-link hidden" id="nav-users">Users</a>

              <!-- Finance Tools dropdown -->
              <div class="relative group hidden" id="nav-finance">
                <button class="nav-link inline-flex items-center">
                  Finance
                  <svg class="w-3.5 h-3.5 ml-1 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
                <div class="absolute left-0 mt-0 pt-2 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                  <div class="bg-white rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 py-1">
                    <a href="/concur" class="dropdown-item">Concur Converter</a>
                    <a href="/reconciliation" class="dropdown-item">Reconciliation</a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right side: User profile dropdown -->
          <div class="flex items-center space-x-3">
            <!-- User dropdown -->
            <div class="relative hidden sm:block" id="user-menu-wrapper">
              <button id="user-menu-btn" class="flex items-center space-x-2 px-2 py-1.5 rounded-lg hover:bg-white/10 transition-colors">
                <div class="h-8 w-8 rounded-full bg-primary-500 flex items-center justify-center text-white text-xs font-semibold">
                  <span id="user-initials"></span>
                </div>
                <div class="text-left">
                  <p id="user-name" class="text-sm font-medium text-white leading-tight"></p>
                  <p id="user-role" class="text-xs text-white/50 leading-tight"></p>
                </div>
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div id="user-dropdown" class="absolute right-0 mt-1 w-48 bg-white rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 py-1 hidden z-50">
                <a href="/dashboard" class="dropdown-item" id="home-link">Home</a>
                <hr class="my-1 border-gray-100">
                <button id="logout-btn" class="dropdown-item w-full text-left text-red-600 hover:text-red-700 hover:bg-red-50">
                  Sign Out
                </button>
              </div>
            </div>

            <!-- Mobile: just avatar + hamburger -->
            <div class="sm:hidden flex items-center space-x-2">
              <div class="h-8 w-8 rounded-full bg-primary-500 flex items-center justify-center text-white text-xs font-semibold">
                <span id="user-initials-mobile"></span>
              </div>
            </div>

            <!-- Mobile menu button -->
            <button id="mobile-menu-btn" class="lg:hidden inline-flex items-center justify-center p-1.5 rounded-md text-white/60 hover:text-white hover:bg-white/10 focus:outline-none">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-jbs-dark">
        <div class="py-2 space-y-0.5">
          <a href="/dashboard" class="mobile-nav-link hidden" id="mobile-nav-dashboard">Dashboard</a>
          <a href="/jobs" class="mobile-nav-link hidden" id="mobile-nav-jobs">Jobs</a>
          <a href="/bids" class="mobile-nav-link hidden" id="mobile-nav-bids">Bids</a>
          <a href="/email-automation" class="mobile-nav-link hidden" id="mobile-nav-email">Email</a>
          <a href="/superintendents" class="mobile-nav-link hidden" id="mobile-nav-supers">Superintendents</a>
          <a href="/licensing" class="mobile-nav-link hidden" id="mobile-nav-licensing">Licensing</a>
          <a href="/training" class="mobile-nav-link hidden" id="mobile-nav-training">Training</a>
          <a href="/users" class="mobile-nav-link hidden" id="mobile-nav-users">Manage Users</a>
          <div class="border-t border-gray-100 my-1 hidden" id="mobile-nav-finance-divider"></div>
          <a href="/concur" class="mobile-nav-link hidden" id="mobile-nav-concur">Concur Converter</a>
          <a href="/reconciliation" class="mobile-nav-link hidden" id="mobile-nav-reconciliation">Reconciliation</a>
        </div>
        <div class="border-t border-gray-200 py-3 px-4">
          <div class="flex items-center space-x-3 mb-3">
            <div class="h-9 w-9 rounded-full bg-primary-500 flex items-center justify-center text-white text-sm font-semibold">
              <span id="mobile-user-initials"></span>
            </div>
            <div>
              <p id="mobile-user-name" class="text-sm font-medium text-white"></p>
              <p id="mobile-user-role" class="text-xs text-white/50"></p>
            </div>
          </div>
          <button id="mobile-logout-btn" class="w-full text-left text-sm font-medium text-red-600 hover:text-red-700 py-2">
            Sign Out
          </button>
        </div>
      </div>
    </nav>

    <style>
      .nav-link {
        @apply inline-flex items-center px-3 py-1.5 text-sm font-medium text-white/70 hover:text-white hover:bg-white/10 rounded-md transition-colors;
      }
      
      .nav-link.active {
        @apply text-white bg-primary-500/20;
      }
      
      .dropdown-item {
        @apply block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors;
      }
      
      .mobile-nav-link {
        @apply block px-4 py-2.5 text-sm font-medium text-white/70 hover:text-white hover:bg-white/10;
      }

      .mobile-nav-link.active {
        @apply text-white bg-primary-500/20;
      }
    </style>

    <main class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <script>
      // Check authentication
      const token = localStorage.getItem('jbs_token');
      if (!token && window.location.pathname !== '/') {
        window.location.href = '/';
      }

      // Display user info
      const userStr = localStorage.getItem('jbs_user');
      if (userStr) {
        try {
          const user = JSON.parse(userStr);
          const nameEl = document.getElementById('user-name');
          const roleEl = document.getElementById('user-role');
          const initialsEl = document.getElementById('user-initials');
          
          if (nameEl && user.name) {
            nameEl.textContent = user.name;
          }
          // Display friendly role labels
          const roleLabels: Record<string, string> = {
            'executive': 'Executive',
            'hr_admin': 'HR Admin',
            'finance': 'Finance',
            'project_manager': 'Project Manager',
            'construction_admin': 'Construction Admin',
            'trainee': 'Trainee',
            'support': 'IT Support',
          };
          if (roleEl && user.role) {
            roleEl.textContent = roleLabels[user.role] || user.role;
          }
          if (initialsEl && user.name) {
            const names = user.name.split(' ');
            const initials = names.length >= 2 
              ? names[0][0] + names[names.length - 1][0]
              : names[0][0];
            initialsEl.textContent = initials.toUpperCase();
          }

          // Mobile initials
          const mobileInitials = document.getElementById('user-initials-mobile');
          if (mobileInitials && user.name) {
            const names = user.name.split(' ');
            const initials = names.length >= 2 ? names[0][0] + names[names.length - 1][0] : names[0][0];
            mobileInitials.textContent = initials.toUpperCase();
          }

          // Mobile menu user info
          const mobileUserName = document.getElementById('mobile-user-name');
          const mobileUserRole = document.getElementById('mobile-user-role');
          const mobileUserInitials = document.getElementById('mobile-user-initials');
          if (mobileUserName) mobileUserName.textContent = user.name || '';
          if (mobileUserRole && user.role) {
            mobileUserRole.textContent = roleLabels[user.role] || user.role;
          }
          if (mobileUserInitials && user.name) {
            const names = user.name.split(' ');
            const initials = names.length >= 2 ? names[0][0] + names[names.length - 1][0] : names[0][0];
            mobileUserInitials.textContent = initials.toUpperCase();
          }

          // RBAC nav visibility + role-based home routing
          const role = user.role;
          const show = (ids: string[]) => ids.forEach(id => {
            document.getElementById(id)?.classList.remove('hidden');
          });

          // Role-based landing page
          const landingPages: Record<string, string> = {
            executive: '/dashboard',
            support: '/dashboard',
            hr_admin: '/training',
            finance: '/concur',
            project_manager: '/jobs',
            construction_admin: '/jobs',
            trainee: '/training',
          };
          const homePage = landingPages[role] || '/jobs';
          const logoLink = document.getElementById('logo-link');
          const homeLink = document.getElementById('home-link');
          if (logoLink) logoLink.setAttribute('href', homePage);
          if (homeLink) homeLink.setAttribute('href', homePage);

          // Role-specific nav items:
          if (role === 'executive' || role === 'support') {
            // Execs get Dashboard nav + everything
            show(['nav-dashboard', 'mobile-nav-dashboard',
                  'nav-jobs', 'nav-bids', 'nav-email', 'nav-supers', 'nav-licensing', 'nav-training', 'nav-users', 'nav-finance',
                  'mobile-nav-jobs', 'mobile-nav-bids', 'mobile-nav-email', 'mobile-nav-supers', 'mobile-nav-licensing', 'mobile-nav-training', 'mobile-nav-users',
                  'mobile-nav-finance-divider', 'mobile-nav-concur', 'mobile-nav-reconciliation']);
          } else if (role === 'hr_admin') {
            show(['nav-jobs', 'nav-bids', 'nav-supers', 'nav-licensing', 'nav-training', 'nav-users',
                  'mobile-nav-jobs', 'mobile-nav-bids', 'mobile-nav-supers', 'mobile-nav-licensing', 'mobile-nav-training', 'mobile-nav-users']);
          } else if (role === 'finance') {
            show(['nav-jobs', 'nav-bids', 'nav-finance',
                  'mobile-nav-jobs', 'mobile-nav-bids', 'mobile-nav-finance-divider', 'mobile-nav-concur', 'mobile-nav-reconciliation']);
          } else if (role === 'project_manager') {
            show(['nav-jobs', 'nav-bids', 'nav-supers', 'nav-licensing', 'nav-training',
                  'mobile-nav-jobs', 'mobile-nav-bids', 'mobile-nav-supers', 'mobile-nav-licensing', 'mobile-nav-training']);
            // Trainees see their schedule; PMs see their own training too
            const trainingNav = document.getElementById('nav-training');
            const mobileTrainingNav = document.getElementById('mobile-nav-training');
            if (trainingNav) {
              trainingNav.setAttribute('href', '/training/schedule');
              trainingNav.lastChild && (trainingNav.lastChild.textContent = ' My Training');
            }
            if (mobileTrainingNav) {
              mobileTrainingNav.setAttribute('href', '/training/schedule');
              mobileTrainingNav.textContent = 'My Training';
            }
          } else if (role === 'construction_admin') {
            show(['nav-jobs', 'nav-bids', 'nav-email', 'nav-supers', 'nav-licensing', 'nav-training',
                  'mobile-nav-jobs', 'mobile-nav-bids', 'mobile-nav-email', 'mobile-nav-supers', 'mobile-nav-licensing', 'mobile-nav-training']);
            const trainingNav = document.getElementById('nav-training');
            const mobileTrainingNav = document.getElementById('mobile-nav-training');
            if (trainingNav) {
              trainingNav.setAttribute('href', '/training/schedule');
              trainingNav.lastChild && (trainingNav.lastChild.textContent = ' My Training');
            }
            if (mobileTrainingNav) {
              mobileTrainingNav.setAttribute('href', '/training/schedule');
              mobileTrainingNav.textContent = 'My Training';
            }
          } else if (role === 'trainee') {
            show(['nav-training', 'mobile-nav-training']);
            const trainingNav = document.getElementById('nav-training');
            const mobileTrainingNav = document.getElementById('mobile-nav-training');
            if (trainingNav) {
              trainingNav.setAttribute('href', '/training/schedule');
              trainingNav.lastChild && (trainingNav.lastChild.textContent = ' My Training');
            }
            if (mobileTrainingNav) {
              mobileTrainingNav.setAttribute('href', '/training/schedule');
              mobileTrainingNav.textContent = 'My Training';
            }
          }
        } catch (error) {
          console.error('Error parsing user data:', error);
        }
      }

      // User dropdown toggle
      const userMenuBtn = document.getElementById('user-menu-btn');
      const userDropdown = document.getElementById('user-dropdown');
      userMenuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        userDropdown?.classList.toggle('hidden');
      });
      // Close dropdown when clicking outside
      document.addEventListener('click', () => {
        userDropdown?.classList.add('hidden');
      });

      // Mobile menu toggle
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      
      mobileMenuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });

      // Mobile logout
      document.getElementById('mobile-logout-btn')?.addEventListener('click', () => {
        localStorage.removeItem('jbs_token');
        localStorage.removeItem('jbs_user');
        window.location.href = '/';
      });

      // Highlight active nav link
      const currentPath = window.location.pathname;
      document.querySelectorAll('.nav-link, .mobile-nav-link').forEach(link => {
        const href = link.getAttribute('href');
        if (href && currentPath.startsWith(href) && href !== '/') {
          link.classList.add('active');
        }
        if (href === '/dashboard' && currentPath === '/dashboard') {
          link.classList.add('active');
        }
      });

      // Auto-logout configuration
      const INACTIVITY_TIMEOUT = 30 * 60 * 1000; // 30 minutes of inactivity
      const TOKEN_CHECK_INTERVAL = 60 * 1000; // Check token every minute
      const ACTIVITY_THROTTLE = 5000; // Only reset timer every 5 seconds max
      let inactivityTimer: number;
      let tokenCheckInterval: number;
      let lastActivityReset = 0;

      // Parse JWT to get expiration time
      function getTokenExpiration(token: string): number | null {
        try {
          const payload = JSON.parse(atob(token.split('.')[1]));
          return payload.exp ? payload.exp * 1000 : null; // Convert to milliseconds
        } catch (error) {
          return null;
        }
      }

      // Logout function
      function logout(reason?: string) {
        localStorage.removeItem('jbs_token');
        localStorage.removeItem('jbs_user');
        window.location.href = '/';
      }

      // Reset inactivity timer (throttled)
      function resetInactivityTimer() {
        const now = Date.now();
        // Throttle: only reset if 5 seconds have passed since last reset
        if (now - lastActivityReset < ACTIVITY_THROTTLE) {
          return;
        }
        lastActivityReset = now;
        
        clearTimeout(inactivityTimer);
        inactivityTimer = window.setTimeout(() => {
          logout('Logged out due to 30 minutes of inactivity');
        }, INACTIVITY_TIMEOUT);
      }

      // Check if token is expired
      function checkTokenExpiration() {
        const currentToken = localStorage.getItem('jbs_token');
        if (!currentToken) return;

        const expiration = getTokenExpiration(currentToken);
        if (expiration && Date.now() >= expiration) {
          logout('Session expired');
        }
      }

      // Set up activity listeners
      if (token && window.location.pathname !== '/') {
        // Monitor user activity (reduced events, passive listeners for performance)
        const activityEvents = ['mousedown', 'keydown', 'touchstart'];
        activityEvents.forEach(event => {
          document.addEventListener(event, resetInactivityTimer, { passive: true, capture: true });
        });

        // Start inactivity timer
        resetInactivityTimer();

        // Check token expiration periodically
        tokenCheckInterval = window.setInterval(checkTokenExpiration, TOKEN_CHECK_INTERVAL);

        // Cleanup on page unload
        window.addEventListener('beforeunload', () => {
          clearTimeout(inactivityTimer);
          clearInterval(tokenCheckInterval);
        });
      }

      // Logout handler
      document.getElementById('logout-btn')?.addEventListener('click', () => {
        logout();
      });
    </script>
  </body>
</html>
