---
// Simplified US Map SVG with state paths
// States positioned roughly geographically
---

<svg id="us-map-svg" viewBox="0 0 1000 600" class="w-full h-auto">
  <defs>
    <style>
      .state-path {
        stroke: #fff;
        stroke-width: 1.5;
        cursor: pointer;
        transition: all 0.2s;
      }
      .state-path:hover {
        opacity: 0.8;
        stroke-width: 2.5;
      }
      .state-no-license { fill: #e5e7eb; }
      .state-active { fill: #10b981; }
      .state-expiring { fill: #f59e0b; }
      .state-expired { fill: #ef4444; }
    </style>
  </defs>
  
  <!-- West Coast -->
  <g id="WA" data-state="Washington">
    <rect class="state-path state-no-license" x="50" y="30" width="80" height="60" rx="3"/>
    <text x="90" y="65" text-anchor="middle" fill="white" font-size="14" font-weight="bold" pointer-events="none">WA</text>
  </g>
  
  <g id="OR" data-state="Oregon">
    <rect class="state-path state-no-license" x="50" y="95" width="80" height="60" rx="3"/>
