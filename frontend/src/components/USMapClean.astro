---
// Clean Interactive US Map - Actually Works
---

<div class="map-container">
  <style is:global>
    .map-container {
      background: white;
      border-radius: 0.5rem;
      padding: 1.5rem;
      border: 1px solid #E5E7EB;
    }

    .map-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #F3F4F6;
    }

    .map-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: #111827;
    }

    .map-coverage {
      font-size: 1.5rem;
      font-weight: 700;
      color: #0088CC;
    }

    .map-legend {
      display: flex;
      gap: 1.5rem;
      font-size: 0.875rem;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .legend-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
    }

    .dot-active { background: #22C55E; }
    .dot-expiring { background: #EAB308; }
    .dot-expired { background: #EF4444; }
    .dot-none { background: #D1D5DB; }

    .states-list {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .state-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      background: white;
      border: 1px solid #E5E7EB;
      border-radius: 0.375rem;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .state-item:hover {
      border-color: #0088CC;
      box-shadow: 0 2px 8px rgba(0, 136, 204, 0.15);
    }

    .state-code {
      font-weight: 700;
      font-size: 0.875rem;
      color: #111827;
    }

    .state-status {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .status-active { background: #22C55E; }
    .status-expiring { background: #EAB308; }
    .status-expired { background: #EF4444; }
    .status-none { background: #D1D5DB; }

    .state-right {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }

    .license-count {
      font-size: 0.625rem;
      font-weight: 700;
      color: #0088CC;
      background: #E0F2FE;
      border-radius: 9999px;
      padding: 0 0.375rem;
      line-height: 1.25rem;
      min-width: 1.25rem;
      text-align: center;
    }

    .search-box {
      position: relative;
      margin-bottom: 1.5rem;
      max-width: 400px;
    }

    .search-input {
      width: 100%;
      padding: 0.75rem 1rem 0.75rem 2.75rem;
      border: 1px solid #E5E7EB;
      border-radius: 0.375rem;
      font-size: 0.875rem;
    }

    .search-input:focus {
      outline: none;
      border-color: #0088CC;
      box-shadow: 0 0 0 3px rgba(0, 136, 204, 0.1);
    }

    .search-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: #9CA3AF;
    }
  </style>

  <div class="map-header">
    <div class="map-title">State License Coverage</div>
    <div class="map-coverage">
      <span id="licensed-count-clean">0</span><span style="color: #6B7280; font-weight: 500;">/50</span>
    </div>
    <div class="map-legend">
      <div class="legend-item">
        <div class="legend-dot dot-active"></div>
        <span><span id="active-count-clean">0</span> Active</span>
      </div>
      <div class="legend-item">
        <div class="legend-dot dot-expiring"></div>
        <span><span id="expiring-count-clean">0</span> Expiring</span>
      </div>
      <div class="legend-item">
        <div class="legend-dot dot-expired"></div>
        <span><span id="expired-count-clean">0</span> Expired</span>
      </div>
      <div class="legend-item">
        <div class="legend-dot dot-none"></div>
        <span><span id="none-count-clean">50</span> No License</span>
      </div>
    </div>
  </div>

  <div class="search-box">
    <svg class="search-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <input 
      type="text" 
      id="state-search-clean" 
      class="search-input" 
      placeholder="Search states..."
    />
  </div>

  <div id="states-list-clean" class="states-list"></div>
</div>

<script>
  interface License {
    id?: number;
    state: string;
    expiration_date?: string | null;
    status?: string;
    license_type?: string;
    city?: string | null;
    is_city_license?: boolean;
    license_number?: string | null;
  }

  interface StateItem {
    code: string;
    name: string;
  }

  // Returns worst-case status across all licenses for a state
  function aggregateStateStatus(licenses: License[]): string {
    if (!licenses || licenses.length === 0) return 'none';
    if (licenses.some(l => l.status === 'expired')) return 'expired';
    if (licenses.some(l => l.status === 'expiring')) return 'expiring';
    return 'active';
  }

  const states: StateItem[] = [
    { code: 'AL', name: 'Alabama' },
    { code: 'AK', name: 'Alaska' },
    { code: 'AZ', name: 'Arizona' },
    { code: 'AR', name: 'Arkansas' },
    { code: 'CA', name: 'California' },
    { code: 'CO', name: 'Colorado' },
    { code: 'CT', name: 'Connecticut' },
    { code: 'DE', name: 'Delaware' },
    { code: 'FL', name: 'Florida' },
    { code: 'GA', name: 'Georgia' },
    { code: 'HI', name: 'Hawaii' },
    { code: 'ID', name: 'Idaho' },
    { code: 'IL', name: 'Illinois' },
    { code: 'IN', name: 'Indiana' },
    { code: 'IA', name: 'Iowa' },
    { code: 'KS', name: 'Kansas' },
    { code: 'KY', name: 'Kentucky' },
    { code: 'LA', name: 'Louisiana' },
    { code: 'ME', name: 'Maine' },
    { code: 'MD', name: 'Maryland' },
    { code: 'MA', name: 'Massachusetts' },
    { code: 'MI', name: 'Michigan' },
    { code: 'MN', name: 'Minnesota' },
    { code: 'MS', name: 'Mississippi' },
    { code: 'MO', name: 'Missouri' },
    { code: 'MT', name: 'Montana' },
    { code: 'NE', name: 'Nebraska' },
    { code: 'NV', name: 'Nevada' },
    { code: 'NH', name: 'New Hampshire' },
    { code: 'NJ', name: 'New Jersey' },
    { code: 'NM', name: 'New Mexico' },
    { code: 'NY', name: 'New York' },
    { code: 'NC', name: 'North Carolina' },
    { code: 'ND', name: 'North Dakota' },
    { code: 'OH', name: 'Ohio' },
    { code: 'OK', name: 'Oklahoma' },
    { code: 'OR', name: 'Oregon' },
    { code: 'PA', name: 'Pennsylvania' },
    { code: 'RI', name: 'Rhode Island' },
    { code: 'SC', name: 'South Carolina' },
    { code: 'SD', name: 'South Dakota' },
    { code: 'TN', name: 'Tennessee' },
    { code: 'TX', name: 'Texas' },
    { code: 'UT', name: 'Utah' },
    { code: 'VT', name: 'Vermont' },
    { code: 'VA', name: 'Virginia' },
    { code: 'WA', name: 'Washington' },
    { code: 'WV', name: 'West Virginia' },
    { code: 'WI', name: 'Wisconsin' },
    { code: 'WY', name: 'Wyoming' }
  ];

  let currentLicenseMap: { [key: string]: License[] } = {};

  (window as any).renderCleanMap = function(licenses: License[] = []) {
    const container = document.getElementById('states-list-clean');
    const searchInput = document.getElementById('state-search-clean') as HTMLInputElement | null;

    if (!container) return;

    // Group all licenses by state (supports multiple per state)
    currentLicenseMap = {};
    licenses.forEach(license => {
      if (!currentLicenseMap[license.state]) {
        currentLicenseMap[license.state] = [];
      }
      currentLicenseMap[license.state].push(license);
    });

    // Count states in each status bucket
    let activeStates = 0, expiringStates = 0, expiredStates = 0, noneCount = 0;

    container.innerHTML = '';

    states.forEach(state => {
      const stateLicenses = currentLicenseMap[state.code] || [];
      const licenseCount = stateLicenses.length;
      let statusClass = 'status-none';

      if (licenseCount > 0) {
        const aggregated = aggregateStateStatus(stateLicenses);
        if (aggregated === 'expired') {
          statusClass = 'status-expired';
          expiredStates++;
        } else if (aggregated === 'expiring') {
          statusClass = 'status-expiring';
          expiringStates++;
        } else {
          statusClass = 'status-active';
          activeStates++;
        }
      } else {
        noneCount++;
      }

      const item = document.createElement('div');
      item.className = 'state-item';
      item.dataset.code = state.code;
      item.dataset.name = state.name;

      item.innerHTML = `
        <span class="state-code">${state.code}</span>
        <div class="state-right">
          ${licenseCount > 0 ? `<span class="license-count">${licenseCount}</span>` : ''}
          <div class="state-status ${statusClass}"></div>
        </div>
      `;

      item.addEventListener('click', () => {
        if (typeof (window as any).openStatePanel === 'function') {
          (window as any).openStatePanel(state.code, state.name);
        }
      });

      container.appendChild(item);
    });

    // Update header legend counts (per-state, not per-license)
    const licensedCount = activeStates + expiringStates + expiredStates;
    document.getElementById('licensed-count-clean')!.textContent = String(licensedCount);
    document.getElementById('active-count-clean')!.textContent = String(activeStates);
    document.getElementById('expiring-count-clean')!.textContent = String(expiringStates);
    document.getElementById('expired-count-clean')!.textContent = String(expiredStates);
    document.getElementById('none-count-clean')!.textContent = String(noneCount);

    // Bind search once
    if (searchInput && !searchInput.dataset.listenerBound) {
      searchInput.dataset.listenerBound = 'true';
      searchInput.addEventListener('input', (e) => {
        const term = (e.target as HTMLInputElement).value.toLowerCase();
        document.querySelectorAll('.state-item').forEach(el => {
          const item = el as HTMLElement;
          const code = item.dataset.code?.toLowerCase() || '';
          const name = item.dataset.name?.toLowerCase() || '';
          item.style.display = (code.includes(term) || name.includes(term)) ? '' : 'none';
        });
      });
    }
  };

  // Initialize with empty data
  (window as any).renderCleanMap([]);
</script>
