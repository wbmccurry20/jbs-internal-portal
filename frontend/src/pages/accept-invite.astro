---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accept Invite · JBS Portal</title>
  </head>
  <body class="bg-jbs-canvas">
    <div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-md w-full space-y-6 bg-white p-8 rounded-2xl border border-black/5 shadow-card">
        <div>
          <div class="mx-auto mb-4 w-56">
            <img src="/jbs_new_logo.png" alt="JBS" class="h-auto w-full" />
          </div>
          <p class="page-header__eyebrow text-center">Account setup</p>
          <h2 class="text-center text-3xl uppercase tracking-[0.04em] text-jbs-dark" id="page-title">
            Set Up Your Account
          </h2>
          <p class="mt-1 text-center text-sm text-slate-600" id="page-subtitle">
            Loading...
          </p>
        </div>

        <!-- Loading state -->
        <div id="loading-state" class="py-8 text-center">
          <div class="mx-auto inline-block h-8 w-8 animate-spin rounded-full border-b-2 border-jbs-blue"></div>
          <p class="mt-2 text-sm text-slate-500">Verifying your invite...</p>
        </div>

        <!-- Invalid/expired token state -->
        <div id="invalid-state" class="hidden py-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-100">
            <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <h3 class="text-lg font-medium text-jbs-dark">Invite Link Invalid</h3>
          <p class="mt-2 text-sm text-slate-500">This invite link is expired or has already been used. Please ask your administrator to send a new invite.</p>
          <a href="/" class="mt-4 inline-block text-sm font-medium text-jbs-blue hover:text-jbs-blue-hover">← Go to Login</a>
        </div>

        <!-- Set password form -->
        <form id="accept-form" class="hidden space-y-5">
          <div>
            <label for="password" class="field-label">Create your password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="10"
              autocomplete="new-password"
              class="form-input"
              placeholder="Minimum 10 characters"
            />
          </div>
          <div>
            <label for="confirm-password" class="field-label">Confirm password</label>
            <input
              id="confirm-password"
              name="confirm-password"
              type="password"
              required
              minlength="10"
              autocomplete="new-password"
              class="form-input"
              placeholder="Re-enter your password"
            />
          </div>

          <div class="rounded-lg border border-black/5 bg-slate-50 p-3">
            <p class="mb-2 text-xs font-medium uppercase tracking-[0.12em] text-slate-700">Password requirements:</p>
            <ul class="space-y-1 text-xs text-slate-600">
              <li id="req-length" class="flex items-center gap-1.5"><span class="req-icon">○</span> At least 10 characters</li>
              <li id="req-upper" class="flex items-center gap-1.5"><span class="req-icon">○</span> One uppercase letter</li>
              <li id="req-lower" class="flex items-center gap-1.5"><span class="req-icon">○</span> One lowercase letter</li>
              <li id="req-number" class="flex items-center gap-1.5"><span class="req-icon">○</span> One number</li>
              <li id="req-match" class="flex items-center gap-1.5"><span class="req-icon">○</span> Passwords match</li>
            </ul>
          </div>

          <div id="error-message" class="hidden rounded-md border border-red-200 bg-red-50 px-3 py-2 text-center">
            <p class="text-sm font-medium text-red-700"></p>
          </div>

          <button type="submit" id="submit-btn" disabled class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-50">
            Activate My Account
          </button>
        </form>

        <!-- Success state -->
        <div id="success-state" class="hidden py-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[#edf7ef]">
            <svg class="h-6 w-6 text-[#2f6f4d]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-lg font-medium text-jbs-dark">Account Activated!</h3>
          <p class="mt-2 text-sm text-slate-500">Your password has been set. You can now log in.</p>
          <a href="/" class="btn-primary mt-4 px-6">
            Go to Login →
          </a>
        </div>
      </div>
    </div>

    <script>
      import { validateInviteToken, acceptInvite } from '../lib/api';

      const params = new URLSearchParams(window.location.search);
      const token = params.get('token');

      const loadingState = document.getElementById('loading-state')!;
      const invalidState = document.getElementById('invalid-state')!;
      const acceptForm = document.getElementById('accept-form') as HTMLFormElement;
      const successState = document.getElementById('success-state')!;
      const pageTitle = document.getElementById('page-title')!;
      const pageSubtitle = document.getElementById('page-subtitle')!;
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      const confirmInput = document.getElementById('confirm-password') as HTMLInputElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const errorDiv = document.getElementById('error-message')!;
      const errorText = errorDiv.querySelector('p')!;

      // Validate token on page load
      async function init() {
        if (!token) {
          showInvalid();
          return;
        }

        try {
          const result = await validateInviteToken(token);
          if (result.valid && result.name) {
            pageTitle.textContent = `Welcome, ${result.name}!`;
            pageSubtitle.textContent = 'Create a password to activate your account';
            loadingState.classList.add('hidden');
            acceptForm.classList.remove('hidden');
          } else {
            showInvalid();
          }
        } catch {
          showInvalid();
        }
      }

      function showInvalid() {
        loadingState.classList.add('hidden');
        invalidState.classList.remove('hidden');
        pageTitle.textContent = 'Invalid Invite';
        pageSubtitle.textContent = '';
      }

      // Real-time password validation
      function checkRequirements() {
        const pw = passwordInput.value;
        const confirm = confirmInput.value;

        const checks = {
          'req-length': pw.length >= 10,
          'req-upper': /[A-Z]/.test(pw),
          'req-lower': /[a-z]/.test(pw),
          'req-number': /[0-9]/.test(pw),
          'req-match': pw.length > 0 && pw === confirm,
        };

        let allPassed = true;
        for (const [id, passed] of Object.entries(checks)) {
          const el = document.getElementById(id)!;
          const icon = el.querySelector('.req-icon')!;
          if (passed) {
            icon.textContent = '✓';
            el.classList.add('text-green-600');
            el.classList.remove('text-gray-500');
          } else {
            icon.textContent = '○';
            el.classList.remove('text-green-600');
            el.classList.add('text-gray-500');
            allPassed = false;
          }
        }

        submitBtn.disabled = !allPassed;
      }

      passwordInput.addEventListener('input', checkRequirements);
      confirmInput.addEventListener('input', checkRequirements);

      // Submit form
      acceptForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorDiv.classList.add('hidden');

        const pw = passwordInput.value;
        const confirm = confirmInput.value;

        if (pw !== confirm) {
          errorText.textContent = 'Passwords do not match';
          errorDiv.classList.remove('hidden');
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Activating...';

        try {
          await acceptInvite(token!, pw);
          acceptForm.classList.add('hidden');
          successState.classList.remove('hidden');
          pageTitle.textContent = 'You\'re All Set!';
          pageSubtitle.textContent = '';
        } catch (err) {
          errorText.textContent = err instanceof Error ? err.message : 'Something went wrong';
          errorDiv.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Activate My Account';
        }
      });

      init();
    </script>
  </body>
</html>
