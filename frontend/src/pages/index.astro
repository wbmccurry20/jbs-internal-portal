---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login · JBS Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>
  <body class="bg-jbs-canvas font-sans">
    <div class="flex min-h-screen">
      <div class="relative hidden w-full flex-col justify-between overflow-hidden bg-jbs-dark p-12 lg:flex lg:w-1/2 xl:w-2/5">
        <div class="absolute -right-12 top-0 h-72 w-72 rotate-45 bg-white/5"></div>
        <div class="absolute -bottom-16 left-0 h-64 w-64 rotate-45 bg-jbs-blue/10"></div>

        <div class="relative z-10">
          <img src="/jbs_new_logo.png" alt="JBS" class="logo-dark-bg h-12 w-auto" />
        </div>

        <div class="relative z-10 max-w-sm">
          <div class="mb-8 h-1 w-12 bg-jbs-blue"></div>
          <h1 class="mb-4 text-5xl font-bold uppercase leading-[0.9] tracking-[0.04em] text-white sm:text-6xl">
            WE'RE JBS
            <span class="mt-2 block text-jbs-blue">BUILT DIFFERENT.</span>
          </h1>
          <p class="max-w-xs text-sm leading-relaxed text-white/60">
            The internal operating system for jobs, bids, licensing, training, and financial workflows across JBS.
          </p>
        </div>

        <div class="relative z-10">
          <p class="text-xs uppercase tracking-[0.2em] text-white/30">JBS Construction Group © 2026</p>
        </div>
      </div>

      <div class="flex flex-1 items-center justify-center px-6 py-12 lg:px-16">
        <div class="w-full max-w-sm">
          <div class="mb-8 lg:hidden">
            <img src="/jbs_new_logo.png" alt="JBS" class="mx-auto h-10 w-auto" />
          </div>

          <div class="mb-8">
            <p class="page-header__eyebrow mb-2 text-center lg:text-left">Portal access</p>
            <h2 class="text-3xl uppercase tracking-[0.04em] text-jbs-dark">Sign in</h2>
            <p class="mt-1 text-sm text-slate-600">Authorized users only.</p>
          </div>

          <form id="login-form" class="space-y-5">
            <div>
              <label for="email" class="field-label">Email address</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="form-input"
                placeholder="you@jbsconstructiongroup.com"
              />
            </div>
            <div>
              <label for="password" class="field-label">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                class="form-input"
                placeholder="••••••••"
              />
            </div>

            <div id="error-message" class="toast-error hidden" aria-live="polite">
              <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <p class="font-medium"></p>
            </div>

<<<<<<< HEAD
            <button type="submit" id="submit-btn" class="btn-primary w-full gap-2">
              <span id="btn-text">Sign In</span>
              <svg id="btn-spinner" class="hidden h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </button>
          </form>

          <p class="mt-8 text-center text-xs text-slate-500">
            Access issues? Contact <a href="mailto:hello@itwill.dev" class="text-jbs-blue hover:text-jbs-blue-hover">IT Support</a>
          </p>
        </div>
      </div>
    </div>

    <script>
      import { getServerUrl } from '../utils/api';

      const API_URL = getServerUrl();

      function getLandingPage(role: string): string {
        switch (role) {
          case 'executive': return '/dashboard';
          case 'hr_admin': return '/training';
          case 'finance': return '/concur';
          case 'project_manager': return '/jobs';
          case 'construction_admin': return '/jobs';
          case 'trainee': return '/training';
          case 'support': return '/dashboard';
          default: return '/jobs';
        }
      }

      const token = localStorage.getItem('jbs_token');
      if (token) {
        const userStr = localStorage.getItem('jbs_user');
        let role = '';
        try { role = userStr ? JSON.parse(userStr).role : ''; } catch {}
        window.location.href = getLandingPage(role);
      }

      document.getElementById('login-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();

        const email = (document.getElementById('email') as HTMLInputElement).value;
        const password = (document.getElementById('password') as HTMLInputElement).value;
        const errorDiv = document.getElementById('error-message');
        const errorText = errorDiv?.querySelector('p');
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
        const btnText = document.getElementById('btn-text');
        const btnSpinner = document.getElementById('btn-spinner');

        if (errorDiv) errorDiv.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Signing in...';
        if (btnSpinner) btnSpinner.classList.remove('hidden');

        if (!API_URL) {
          if (errorDiv && errorText) {
            errorDiv.classList.remove('hidden');
            errorText.textContent = 'Configuration error. Please contact support.';
          }
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Sign In';
          if (btnSpinner) btnSpinner.classList.add('hidden');
          return;
        }

        try {
          const response = await fetch(`${API_URL}/api/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });

          if (!response.ok) {
            let errorMessage = 'Login failed';
            try {
              const data = await response.json();
              errorMessage = data.error || errorMessage;
            } catch {
              errorMessage = response.status === 401
                ? 'Invalid email or password.'
                : 'The login service is unavailable right now.';
            }
            throw new Error(errorMessage);
          }

          const data = await response.json();
          localStorage.setItem('jbs_token', data.token);
          localStorage.setItem('jbs_user', JSON.stringify(data.user));
          window.location.href = getLandingPage(data.user?.role || '');
        } catch (error) {
          if (errorDiv && errorText) {
            errorDiv.classList.remove('hidden');
            errorText.textContent = error instanceof Error
              ? error.message
              : 'Login request failed. Please check that the backend is running and the portal configuration is correct.';
          }
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Sign In';
          if (btnSpinner) btnSpinner.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>
