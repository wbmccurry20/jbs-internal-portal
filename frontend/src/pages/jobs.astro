---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="space-y-6">
    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Jobs</h1>
        <p class="mt-2 text-sm text-gray-600">Manage all construction jobs and projects</p>
      </div>
      <button id="create-job-btn" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 shadow-sm transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        New Job
      </button>
    </div>

    <!-- Filters and search -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search</label>
          <input 
            type="text" 
            id="search" 
            placeholder="Search jobs..." 
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
          >
        </div>
        <div>
          <label for="status-filter" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
          <select id="status-filter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="">All Statuses</option>
            <option value="active">Active</option>
            <option value="completed">Completed</option>
            <option value="on-hold">On Hold</option>
          </select>
        </div>
        <div>
          <label for="sort" class="block text-sm font-medium text-gray-700 mb-1">Sort By</label>
          <select id="sort" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="updated">Recently Updated</option>
            <option value="number">Job Number</option>
            <option value="name">Project Name</option>
            <option value="value">Contract Value</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Jobs list -->
    <div id="jobs-container" class="space-y-4">
      <!-- Loading state -->
      <div id="loading" class="text-center py-12">
        <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600"></div>
        <p class="mt-4 text-gray-600">Loading jobs...</p>
      </div>
    </div>
  </div>

  <!-- Job Modal (hidden by default) -->
  <div id="job-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-full max-w-2xl shadow-lg rounded-lg bg-white">
      <div class="flex justify-between items-center mb-4">
        <h3 id="modal-title" class="text-2xl font-bold text-gray-900">New Job</h3>
        <button id="close-modal" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="job-form" class="space-y-4">
        <input type="hidden" id="job-id">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="job-number" class="block text-sm font-medium text-gray-700 mb-1">Job Number *</label>
            <input type="text" id="job-number" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status *</label>
            <select id="status" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="active">Active</option>
              <option value="completed">Completed</option>
              <option value="on-hold">On Hold</option>
            </select>
          </div>
        </div>

        <div>
          <label for="project-name" class="block text-sm font-medium text-gray-700 mb-1">Project Name *</label>
          <input type="text" id="project-name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div>
          <label for="address" class="block text-sm font-medium text-gray-700 mb-1">Address</label>
          <input type="text" id="address" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div>
            <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City</label>
            <input type="text" id="city" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="state" class="block text-sm font-medium text-gray-700 mb-1">State</label>
            <input type="text" id="state" maxlength="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="zip" class="block text-sm font-medium text-gray-700 mb-1">ZIP</label>
            <input type="text" id="zip" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="contract-value" class="block text-sm font-medium text-gray-700 mb-1">Contract Value</label>
            <input type="number" id="contract-value" step="0.01" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="superintendent" class="block text-sm font-medium text-gray-700 mb-1">Superintendent</label>
            <input type="text" id="superintendent" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
          <textarea id="notes" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"></textarea>
        </div>

        <div class="flex justify-end space-x-3 pt-4">
          <button type="button" id="cancel-btn" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium">
            Cancel
          </button>
          <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-medium">
            Save Job
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL || (import.meta.env.DEV ? 'http://localhost:8080/api' : '');
    const token = localStorage.getItem('jbs_token');

    function escapeHtml(str: string): string {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    const userStr = localStorage.getItem('jbs_user');
    let currentUser: any = null;

    if (userStr) {
      try {
        currentUser = JSON.parse(userStr);
      } catch (error) {
        console.error('Error parsing user:', error);
      }
    }

    let jobs: any[] = [];
    let filteredJobs: any[] = [];
    let editingJobId: number | null = null;

    // Fetch jobs
    async function fetchJobs() {
      try {
        const response = await fetch(`${API_URL}/jobs`, {
          headers: {
            'Authorization': `Bearer ${token}`
          }
        });

        if (!response.ok) throw new Error('Failed to fetch jobs');
        
        jobs = await response.json();
        filteredJobs = jobs;
        renderJobs();
      } catch (error) {
        console.error('Error fetching jobs:', error);
        showError('Failed to load jobs');
      }
    }

    // Render jobs
    function renderJobs() {
      const container = document.getElementById('jobs-container');
      const loading = document.getElementById('loading');
      
      if (loading) loading.classList.add('hidden');
      
      if (!container) return;

      if (filteredJobs.length === 0) {
        container.innerHTML = `
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
            <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <h3 class="mt-4 text-lg font-medium text-gray-900">No jobs found</h3>
            <p class="mt-2 text-sm text-gray-500">Get started by creating a new job.</p>
          </div>
        `;
        return;
      }

      const canDelete = currentUser?.role === 'executive' || currentUser?.role === 'support';

      container.innerHTML = filteredJobs.map(job => `
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
          <div class="flex justify-between items-start">
            <div class="flex-1">
              <div class="flex items-center space-x-3 mb-2">
                <h3 class="text-xl font-semibold text-gray-900">${escapeHtml(job.job_number)}</h3>
                <span class="px-3 py-1 text-xs font-semibold rounded-full ${getStatusColor(job.status)}">${escapeHtml(job.status)}</span>
              </div>
              <p class="text-lg text-gray-700 mb-2">${escapeHtml(job.job_name || 'Untitled Project')}</p>
              <div class="text-sm text-gray-600 space-y-1">
                ${job.address ? `<p>📍 ${escapeHtml(job.address)}${job.city ? `, ${escapeHtml(job.city)}` : ''}${job.state ? `, ${escapeHtml(job.state)}` : ''}</p>` : ''}
                ${job.superintendent?.name ? `<p>👷 ${escapeHtml(job.superintendent.name)}</p>` : ''}
                ${job.contract_value ? `<p>💰 $${parseFloat(job.contract_value).toLocaleString()}</p>` : ''}
              </div>
              ${job.notes ? `<p class="mt-3 text-sm text-gray-500 italic">${escapeHtml(job.notes)}</p>` : ''}
            </div>
            <div class="flex space-x-2 ml-4">
              <button onclick="editJob(${job.id})" class="p-2 text-primary-600 hover:bg-primary-50 rounded-lg transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </button>
              ${canDelete ? `
                <button onclick="deleteJob(${job.id})" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </button>
              ` : ''}
            </div>
          </div>
        </div>
      `).join('');
    }

    function getStatusColor(status: string): string {
      const colors: any = {
        'active': 'bg-green-100 text-green-800',
        'completed': 'bg-blue-100 text-blue-800',
        'on-hold': 'bg-yellow-100 text-yellow-800'
      };
      return colors[status] || 'bg-gray-100 text-gray-800';
    }

    // Filter and search
    document.getElementById('search')?.addEventListener('input', (e: any) => {
      const query = e.target.value.toLowerCase();
      applyFilters();
    });

    document.getElementById('status-filter')?.addEventListener('change', applyFilters);
    document.getElementById('sort')?.addEventListener('change', applyFilters);

    function applyFilters() {
      const search = (document.getElementById('search') as HTMLInputElement)?.value.toLowerCase() || '';
      const status = (document.getElementById('status-filter') as HTMLSelectElement)?.value || '';
      const sort = (document.getElementById('sort') as HTMLSelectElement)?.value || 'updated';

      filteredJobs = jobs.filter(job => {
        const matchesSearch = !search || 
          job.job_number?.toLowerCase().includes(search) ||
          job.job_name?.toLowerCase().includes(search) ||
          job.superintendent?.toLowerCase().includes(search);
        
        const matchesStatus = !status || job.status === status;
        
        return matchesSearch && matchesStatus;
      });

      // Sort
      filteredJobs.sort((a, b) => {
        if (sort === 'number') return (a.job_number || '').localeCompare(b.job_number || '');
        if (sort === 'name') return (a.project_name || '').localeCompare(b.project_name || '');
        if (sort === 'value') return (parseFloat(b.contract_value || 0) - parseFloat(a.contract_value || 0));
        return new Date(b.updated_at || 0).getTime() - new Date(a.updated_at || 0).getTime();
      });

      renderJobs();
    }

    // Modal handling
    const modal = document.getElementById('job-modal');
    const form = document.getElementById('job-form');

    document.getElementById('create-job-btn')?.addEventListener('click', () => {
      editingJobId = null;
      (document.getElementById('modal-title') as HTMLElement).textContent = 'New Job';
      (form as HTMLFormElement)?.reset();
      modal?.classList.remove('hidden');
    });

    document.getElementById('close-modal')?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    document.getElementById('cancel-btn')?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    // Edit job
    (window as any).editJob = function(id: number) {
      const job = jobs.find(j => j.id === id);
      if (!job) return;

      editingJobId = id;
      (document.getElementById('modal-title') as HTMLElement).textContent = 'Edit Job';
      (document.getElementById('job-number') as HTMLInputElement).value = job.job_number || '';
      (document.getElementById('project-name') as HTMLInputElement).value = job.job_name || '';
      (document.getElementById('address') as HTMLInputElement).value = job.address || '';
      (document.getElementById('city') as HTMLInputElement).value = job.city || '';
      (document.getElementById('state') as HTMLInputElement).value = job.state || '';
      (document.getElementById('zip') as HTMLInputElement).value = job.zip || '';
      (document.getElementById('status') as HTMLSelectElement).value = job.status || 'active';
      (document.getElementById('contract-value') as HTMLInputElement).value = job.contract_value || '';
      (document.getElementById('superintendent') as HTMLInputElement).value = job.superintendent || '';
      (document.getElementById('notes') as HTMLTextAreaElement).value = job.notes || '';

      modal?.classList.remove('hidden');
    };

    // Delete job
    (window as any).deleteJob = async function(id: number) {
      if (!confirm('Are you sure you want to delete this job?')) return;

      try {
        const response = await fetch(`${API_URL}/jobs/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${token}`
          }
        });

        if (!response.ok) throw new Error('Failed to delete job');
        
        showSuccess('Job deleted successfully');
        await fetchJobs();
      } catch (error) {
        console.error('Error deleting job:', error);
        showError('Failed to delete job');
      }
    };

    // Submit form
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = {
        job_number: (document.getElementById('job-number') as HTMLInputElement).value,
        job_name: (document.getElementById('project-name') as HTMLInputElement).value,
        address: (document.getElementById('address') as HTMLInputElement).value || null,
        city: (document.getElementById('city') as HTMLInputElement).value || null,
        state: (document.getElementById('state') as HTMLInputElement).value || null,
        zip: (document.getElementById('zip') as HTMLInputElement).value || null,
        status: (document.getElementById('status') as HTMLSelectElement).value,
        contract_value: (document.getElementById('contract-value') as HTMLInputElement).value || null,
        superintendent: (document.getElementById('superintendent') as HTMLInputElement).value || null,
        notes: (document.getElementById('notes') as HTMLTextAreaElement).value || null
      };

      try {
        const url = editingJobId ? `${API_URL}/jobs/${editingJobId}` : `${API_URL}/jobs`;
        const method = editingJobId ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method,
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        if (!response.ok) throw new Error(`Failed to ${editingJobId ? 'update' : 'create'} job`);
        
        showSuccess(`Job ${editingJobId ? 'updated' : 'created'} successfully`);
        modal?.classList.add('hidden');
        await fetchJobs();
      } catch (error) {
        console.error('Error saving job:', error);
        showError(`Failed to ${editingJobId ? 'update' : 'create'} job`);
      }
    });

    function showSuccess(message: string) {
      // Simple alert for now - can be replaced with toast notification
      alert(message);
    }

    function showError(message: string) {
      alert(message);
    }

    // Initial load
    fetchJobs();
  </script>
</Layout>
