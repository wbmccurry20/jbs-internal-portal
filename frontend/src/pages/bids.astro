---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bid Pipeline">
  <div class="space-y-6">
    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Bid Pipeline</h1>
        <p class="mt-2 text-sm text-gray-600">Track and manage bid opportunities</p>
      </div>
      <button id="create-bid-btn" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 shadow-sm transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        New Bid
      </button>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search</label>
          <input 
            type="text" 
            id="search" 
            placeholder="Search location, client..." 
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
          >
        </div>
        <div>
          <label for="status-filter" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
          <select id="status-filter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="">All Statuses</option>
            <option value="in_progress">In Progress</option>
            <option value="complete">Complete</option>
            <option value="did_not_bid">Did Not Bid</option>
            <option value="no_access">No Access</option>
            <option value="not_started">Not Started</option>
            <option value="not_bidding">Not Bidding</option>
          </select>
        </div>
        <div>
          <label for="client-filter" class="block text-sm font-medium text-gray-700 mb-1">Client</label>
          <select id="client-filter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="">All Clients</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Pipeline columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
      <!-- Not Started -->
      <div class="bg-gray-50 rounded-lg p-4">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900 flex items-center">
            <span class="w-3 h-3 rounded-full bg-gray-400 mr-2"></span>
            Not Started
          </h3>
          <span id="count-not_started" class="text-sm font-medium text-gray-500">0</span>
        </div>
        <div id="column-not_started" class="space-y-3 min-h-[200px]"></div>
      </div>

      <!-- In Progress -->
      <div class="bg-gray-50 rounded-lg p-4">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900 flex items-center">
            <span class="w-3 h-3 rounded-full bg-blue-500 mr-2"></span>
            In Progress
          </h3>
          <span id="count-in_progress" class="text-sm font-medium text-gray-500">0</span>
        </div>
        <div id="column-in_progress" class="space-y-3 min-h-[200px]"></div>
      </div>

      <!-- Complete -->
      <div class="bg-gray-50 rounded-lg p-4">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900 flex items-center">
            <span class="w-3 h-3 rounded-full bg-green-500 mr-2"></span>
            Complete
          </h3>
          <span id="count-complete" class="text-sm font-medium text-gray-500">0</span>
        </div>
        <div id="column-complete" class="space-y-3 min-h-[200px]"></div>
      </div>

      <!-- Did Not Bid -->
      <div class="bg-gray-50 rounded-lg p-4">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900 flex items-center">
            <span class="w-3 h-3 rounded-full bg-yellow-500 mr-2"></span>
            Did Not Bid
          </h3>
          <span id="count-did_not_bid" class="text-sm font-medium text-gray-500">0</span>
        </div>
        <div id="column-did_not_bid" class="space-y-3 min-h-[200px]"></div>
      </div>

      <!-- No Access -->
      <div class="bg-gray-50 rounded-lg p-4">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900 flex items-center">
            <span class="w-3 h-3 rounded-full bg-red-500 mr-2"></span>
            No Access
          </h3>
          <span id="count-no_access" class="text-sm font-medium text-gray-500">0</span>
        </div>
        <div id="column-no_access" class="space-y-3 min-h-[200px]"></div>
      </div>

      <!-- Not Bidding -->
      <div class="bg-gray-50 rounded-lg p-4">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900 flex items-center">
            <span class="w-3 h-3 rounded-full bg-orange-500 mr-2"></span>
            Not Bidding
          </h3>
          <span id="count-not_bidding" class="text-sm font-medium text-gray-500">0</span>
        </div>
        <div id="column-not_bidding" class="space-y-3 min-h-[200px]"></div>
      </div>
    </div>

    <!-- Loading state -->
    <div id="loading" class="text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600"></div>
      <p class="mt-4 text-gray-600">Loading bids...</p>
    </div>
  </div>

  <!-- Bid Modal -->
  <div id="bid-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-full max-w-2xl shadow-lg rounded-lg bg-white">
      <div class="flex justify-between items-center mb-4">
        <h3 id="modal-title" class="text-2xl font-bold text-gray-900">New Bid</h3>
        <button id="close-modal" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="bid-form" class="space-y-4">
        <input type="hidden" id="bid-id">
        
        <div>
          <label for="location" class="block text-sm font-medium text-gray-700 mb-1">Location *</label>
          <input type="text" id="location" required placeholder="e.g. Orlando, FL" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City</label>
            <input type="text" id="city" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="state" class="block text-sm font-medium text-gray-700 mb-1">State</label>
            <input type="text" id="state" maxlength="2" placeholder="FL" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="client-id" class="block text-sm font-medium text-gray-700 mb-1">Client</label>
            <select id="client-id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="">Select client...</option>
            </select>
          </div>
          <div>
            <label for="bid-amount" class="block text-sm font-medium text-gray-700 mb-1">Bid Amount</label>
            <input type="number" id="bid-amount" step="0.01" placeholder="0.00" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="due-date" class="block text-sm font-medium text-gray-700 mb-1">Due Date</label>
            <input type="date" id="due-date" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
            <select id="status" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="in_progress">In Progress</option>
              <option value="complete">Complete</option>
              <option value="not_started">Not Started</option>
              <option value="did_not_bid">Did Not Bid</option>
              <option value="no_access">No Access</option>
              <option value="not_bidding">Not Bidding</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="awarded" class="block text-sm font-medium text-gray-700 mb-1">Awarded</label>
            <select id="awarded" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="">Pending</option>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
          <div>
            <label for="assigned-to" class="block text-sm font-medium text-gray-700 mb-1">Assigned To</label>
            <input type="text" id="assigned-to" placeholder="Name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
          <textarea id="notes" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"></textarea>
        </div>

        <div class="flex justify-end space-x-3 pt-4">
          <button type="button" id="cancel-btn" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium">
            Cancel
          </button>
          <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-medium">
            Save Bid
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { escapeHtml } from '../utils/html';
    import { getApiUrl } from '../utils/api';
    import { toast } from '../utils/toast';

    const API_URL = getApiUrl();
    const token = localStorage.getItem('jbs_token');

    interface Bid {
      id: number;
      location: string;
      city: string;
      state: string;
      client_id: number | null;
      client?: { id: number; name: string };
      bid_amount: number | null;
      due_date: string | null;
      assigned_to_name: string;
      status: string;
      awarded: string;
      notes: string;
      archived: boolean;
    }

    let bids: Bid[] = [];
    let filteredBids: Bid[] = [];
    let editingBidId: number | null = null;

    // Build client dropdowns from loaded bid data
    function populateClientDropdowns() {
      const clientMap = new Map<number, string>();
      bids.forEach(bid => {
        if (bid.client?.id && bid.client?.name) {
          clientMap.set(bid.client.id, bid.client.name);
        }
      });
      const clients = Array.from(clientMap, ([id, name]) => ({ id, name })).sort((a, b) => a.name.localeCompare(b.name));

      const filterEl = document.getElementById('client-filter') as HTMLSelectElement;
      if (filterEl) {
        const current = filterEl.value;
        filterEl.innerHTML = '<option value="">All Clients</option>' + 
          clients.map(c => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
        filterEl.value = current;
      }

      const formEl = document.getElementById('client-id') as HTMLSelectElement;
      if (formEl) {
        formEl.innerHTML = '<option value="">Select client...</option>' + 
          clients.map(c => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
      }
    }

    // Fetch bids from API
    async function fetchBids() {
      try {
        const response = await fetch(`${API_URL}/bids`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!response.ok) throw new Error('Failed to fetch bids');
        
        bids = await response.json();
        populateClientDropdowns();
        applyFilters();
        
        const loading = document.getElementById('loading');
        if (loading) loading.classList.add('hidden');
      } catch (error) {
        console.error('Error fetching bids:', error);
        toast.error('Failed to load bids');
      }
    }

    // Render bids into pipeline columns
    function renderBids() {
      const statuses = ['not_started', 'in_progress', 'complete', 'did_not_bid', 'no_access', 'not_bidding'];
      
      statuses.forEach(status => {
        const column = document.getElementById(`column-${status}`);
        const countEl = document.getElementById(`count-${status}`);
        if (!column) return;

        const statusBids = filteredBids.filter(bid => bid.status === status);
        if (countEl) countEl.textContent = statusBids.length.toString();

        if (statusBids.length === 0) {
          column.innerHTML = '<div class="text-center py-8 text-gray-400 text-sm">No bids</div>';
          return;
        }

        column.innerHTML = statusBids.map(bid => `
          <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow cursor-pointer" onclick="editBid(${bid.id})">
            <h4 class="font-semibold text-gray-900 mb-1">${escapeHtml(bid.location || 'Untitled Bid')}</h4>
            <p class="text-sm text-gray-600 mb-2">${escapeHtml(bid.client?.name || 'No client')}</p>
            <div class="flex items-center justify-between text-sm">
              ${bid.bid_amount ? `<span class="font-semibold text-primary-600">$${parseFloat(String(bid.bid_amount)).toLocaleString()}</span>` : '<span class="text-gray-400">No amount</span>'}
              ${bid.due_date ? `<span class="text-gray-500">${formatDate(bid.due_date)}</span>` : ''}
            </div>
            ${bid.awarded === 'Yes' ? '<div class="mt-2"><span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800">✓ Awarded</span></div>' : ''}
            ${bid.awarded === 'No' ? '<div class="mt-2"><span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-red-100 text-red-800">✗ Not Awarded</span></div>' : ''}
          </div>
        `).join('');
      });
    }

    function formatDate(dateStr: string): string {
      return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    // Filter listeners
    document.getElementById('search')?.addEventListener('input', applyFilters);
    document.getElementById('status-filter')?.addEventListener('change', applyFilters);
    document.getElementById('client-filter')?.addEventListener('change', applyFilters);

    function applyFilters() {
      const search = (document.getElementById('search') as HTMLInputElement)?.value.toLowerCase() || '';
      const statusFilter = (document.getElementById('status-filter') as HTMLSelectElement)?.value || '';
      const clientFilter = (document.getElementById('client-filter') as HTMLSelectElement)?.value || '';

      filteredBids = bids.filter(bid => {
        const matchesSearch = !search || 
          bid.location?.toLowerCase().includes(search) ||
          bid.client?.name?.toLowerCase().includes(search) ||
          bid.notes?.toLowerCase().includes(search);
        const matchesStatus = !statusFilter || bid.status === statusFilter;
        const matchesClient = !clientFilter || String(bid.client_id) === clientFilter;
        return matchesSearch && matchesStatus && matchesClient;
      });

      renderBids();
    }

    // Modal
    const modal = document.getElementById('bid-modal');
    const form = document.getElementById('bid-form') as HTMLFormElement;

    document.getElementById('create-bid-btn')?.addEventListener('click', () => {
      editingBidId = null;
      (document.getElementById('modal-title') as HTMLElement).textContent = 'New Bid';
      form?.reset();
      modal?.classList.remove('hidden');
    });

    document.getElementById('close-modal')?.addEventListener('click', () => modal?.classList.add('hidden'));
    document.getElementById('cancel-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));

    // Edit bid — populate form from real backend fields
    (window as any).editBid = function(id: number) {
      const bid = bids.find(b => b.id === id);
      if (!bid) return;

      editingBidId = id;
      (document.getElementById('modal-title') as HTMLElement).textContent = 'Edit Bid';
      (document.getElementById('location') as HTMLInputElement).value = bid.location || '';
      (document.getElementById('city') as HTMLInputElement).value = bid.city || '';
      (document.getElementById('state') as HTMLInputElement).value = bid.state || '';
      (document.getElementById('client-id') as HTMLSelectElement).value = bid.client_id ? String(bid.client_id) : '';
      (document.getElementById('bid-amount') as HTMLInputElement).value = bid.bid_amount ? String(bid.bid_amount) : '';
      (document.getElementById('due-date') as HTMLInputElement).value = bid.due_date ? bid.due_date.split('T')[0] : '';
      (document.getElementById('status') as HTMLSelectElement).value = bid.status || 'in_progress';
      (document.getElementById('awarded') as HTMLSelectElement).value = bid.awarded || '';
      (document.getElementById('assigned-to') as HTMLInputElement).value = bid.assigned_to_name || '';
      (document.getElementById('notes') as HTMLTextAreaElement).value = bid.notes || '';

      modal?.classList.remove('hidden');
    };

    // Submit — send fields that match the backend CreateBidRequest / UpdateBidRequest
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const clientIdVal = (document.getElementById('client-id') as HTMLSelectElement).value;
      const bidAmountVal = (document.getElementById('bid-amount') as HTMLInputElement).value;
      const dueDateVal = (document.getElementById('due-date') as HTMLInputElement).value;

      const data: Record<string, any> = {
        location: (document.getElementById('location') as HTMLInputElement).value,
        city: (document.getElementById('city') as HTMLInputElement).value || '',
        state: (document.getElementById('state') as HTMLInputElement).value || '',
        client_id: clientIdVal ? parseInt(clientIdVal) : null,
        bid_amount: bidAmountVal ? parseFloat(bidAmountVal) : null,
        due_date: dueDateVal ? dueDateVal + 'T00:00:00Z' : null,
        status: (document.getElementById('status') as HTMLSelectElement).value,
        awarded: (document.getElementById('awarded') as HTMLSelectElement).value || '',
        assigned_to_name: (document.getElementById('assigned-to') as HTMLInputElement).value || '',
        notes: (document.getElementById('notes') as HTMLTextAreaElement).value || '',
      };

      try {
        const url = editingBidId ? `${API_URL}/bids/${editingBidId}` : `${API_URL}/bids`;
        const method = editingBidId ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method,
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        if (!response.ok) {
          const err = await response.json().catch(() => ({}));
          throw new Error(err.error || 'Failed to save bid');
        }
        
        modal?.classList.add('hidden');
        await fetchBids();
      } catch (error: any) {
        console.error('Error saving bid:', error);
        toast.error(error.message || 'Failed to save bid');
      }
    });

    // Initial load
    fetchBids();
  </script>
</Layout>
