---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <div class="space-y-6">
    <div class="flex justify-between items-center">
      <h1 class="text-3xl font-bold text-gray-900">Concur to Foundation Converter</h1>
    </div>

    <!-- Upload Form -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Upload Concur Export</h2>
      
      <form id="upload-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">
            Concur Excel File (.xlsx, .xls)
          </label>
          <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md hover:border-primary transition-colors">
            <div class="space-y-1 text-center">
              <svg
                class="mx-auto h-12 w-12 text-gray-400"
                stroke="currentColor"
                fill="none"
                viewBox="0 0 48 48"
                aria-hidden="true"
              >
                <path
                  d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <div class="flex text-sm text-gray-600">
                <label
                  for="file-upload"
                  class="relative cursor-pointer bg-white rounded-md font-medium text-primary hover:text-blue-500 focus-within:outline-none"
                >
                  <span>Upload a file</span>
                  <input id="file-upload" name="file-upload" type="file" class="sr-only" accept=".xlsx,.xls" />
                </label>
                <p class="pl-1">or drag and drop</p>
              </div>
              <p class="text-xs text-gray-500">Excel files only (.xlsx, .xls)</p>
            </div>
          </div>
          <p id="file-name" class="mt-2 text-sm text-gray-500"></p>
        </div>

        <div>
          <label for="vendor-id" class="block text-sm font-medium text-gray-700">
            Vendor ID
          </label>
          <input
            type="text"
            id="vendor-id"
            name="vendor-id"
            value="138"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm"
            placeholder="Enter vendor ID (default: 138)"
          />
          <p class="mt-1 text-xs text-gray-500">Foundation vendor number for these expenses</p>
        </div>

        <div id="upload-status" class="hidden">
          <div class="rounded-md bg-blue-50 p-4">
            <p class="text-sm text-blue-700">Processing...</p>
          </div>
        </div>

        <div id="upload-error" class="hidden">
          <div class="rounded-md bg-red-50 p-4">
            <p class="text-sm text-red-700"></p>
          </div>
        </div>

        <div id="upload-success" class="hidden">
          <div class="rounded-md bg-green-50 p-4 space-y-2">
            <p class="text-sm font-medium text-green-800">Conversion Completed!</p>
            <p class="text-sm text-green-700" id="success-message"></p>
            <button
              id="download-btn"
              type="button"
              class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-green-600 hover:bg-green-700"
            >
              Download Foundation CSV
            </button>
          </div>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Convert to Foundation Format
        </button>
      </form>
    </div>

    <!-- Conversion History -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Recent Conversions</h2>
      <div id="history-list" class="space-y-2">
        <p class="text-sm text-gray-500">Loading...</p>
      </div>
    </div>
  </div>

  <script>
    import { toast } from '../../utils/toast';
    import { ErrorHandler } from '../../utils/errorHandler';
    import { setButtonLoading } from '../../utils/loading';
    
    const API_URL = import.meta.env.PUBLIC_API_URL?.replace('/api', '') || 'http://localhost:8080';
    const token = localStorage.getItem('jbs_token');

    // Redirect to login if not authenticated
    if (!token) {
      window.location.href = '/';
    }

    let selectedFile: File | null = null;
    let currentJobId: number | null = null;

    // File input handler
    const fileInput = document.getElementById('file-upload') as HTMLInputElement;
    fileInput?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files[0]) {
        selectedFile = target.files[0];
        document.getElementById('file-name')!.textContent = `Selected: ${selectedFile.name}`;
      }
    });

    // Form submission
    document.getElementById('upload-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!selectedFile) {
        ErrorHandler.handleValidationError('File', 'Please select a file');
        return;
      }

      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const statusDiv = document.getElementById('upload-status');
      const errorDiv = document.getElementById('upload-error');
      const successDiv = document.getElementById('upload-success');

      // Reset states
      statusDiv?.classList.remove('hidden');
      errorDiv?.classList.add('hidden');
      successDiv?.classList.add('hidden');
      setButtonLoading(submitBtn, true);

      try {
        const formData = new FormData();
        formData.append('file', selectedFile);
        
        // Get vendor ID from input
        const vendorIdInput = document.getElementById('vendor-id') as HTMLInputElement;
        const vendorId = vendorIdInput?.value || '138';
        formData.append('vendor_id', vendorId);

        const response = await fetch(`${API_URL}/api/concur/upload`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
          },
          body: formData,
        });

        const data = await response.json();

        if (!response.ok) {
          if (response.status === 401) {
            ErrorHandler.handleAuthError(response);
            return;
          }
          throw new Error(data.error || 'Upload failed');
        }

        // Success
        currentJobId = data.job_id;
        let successMsg = `Processed ${data.rows_processed} rows`;
        if (data.rows_skipped > 0) {
          successMsg += `, skipped ${data.rows_skipped} rows`;
        }
        
        document.getElementById('success-message')!.textContent = successMsg;
        statusDiv?.classList.add('hidden');
        successDiv?.classList.remove('hidden');
        toast.success('File converted successfully!');

        // Reload history
        loadHistory();

      } catch (error) {
        statusDiv?.classList.add('hidden');
        errorDiv?.classList.remove('hidden');
        errorDiv!.querySelector('p')!.textContent = error instanceof Error ? error.message : 'An error occurred';
        ErrorHandler.handle(error, 'Failed to convert file');
      } finally {
        setButtonLoading(submitBtn, false);
      }
    });

    // Download button
    document.getElementById('download-btn')?.addEventListener('click', async () => {
      if (currentJobId) {
        try {
          const response = await fetch(`${API_URL}/api/download/${currentJobId}`, {
            headers: {
              'Authorization': `Bearer ${token}`,
            },
          });

          if (!response.ok) {
            throw new Error('Download failed');
          }

          // Get the blob and download it
          const blob = await response.blob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `foundation_${currentJobId}.csv`;
          document.body.appendChild(a);
          a.click();
          window.URL.revokeObjectURL(url);
          document.body.removeChild(a);
          toast.success('File downloaded successfully');
        } catch (error) {
          ErrorHandler.handle(error, 'Failed to download file');
        }
      }
    });

    // Download file function (available globally for history links)
    (window as any).downloadFile = async (jobId: number) => {
      try {
        const response = await fetch(`${API_URL}/api/download/${jobId}`, {
          headers: {
            'Authorization': `Bearer ${token}`,
          },
        });

        if (!response.ok) {
          throw new Error('Download failed');
        }

        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `foundation_${jobId}.csv`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
        toast.success('File downloaded successfully');
      } catch (error) {
        ErrorHandler.handle(error, 'Failed to download file');
      }
    };

    // Load conversion history
    async function loadHistory() {
      try {
        const response = await fetch(`${API_URL}/api/concur/history`, {
          headers: {
            'Authorization': `Bearer ${token}`,
          },
        });

        if (response.ok) {
          const jobs = await response.json();
          const historyList = document.getElementById('history-list');
          
          if (jobs.length === 0) {
            historyList!.innerHTML = '<p class="text-sm text-gray-500">No conversions yet</p>';
            return;
          }

          historyList!.innerHTML = jobs.map((job: any) => `
            <div class="flex justify-between items-center py-2 px-3 bg-gray-50 rounded">
              <div>
                <p class="text-sm font-medium text-gray-900">${job.filename}</p>
                <p class="text-xs text-gray-500">${new Date(job.created_at).toLocaleString()}</p>
              </div>
              <div class="flex items-center space-x-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                  job.status === 'completed' ? 'bg-green-100 text-green-800' :
                  job.status === 'failed' ? 'bg-red-100 text-red-800' :
                  'bg-yellow-100 text-yellow-800'
                }">
                  ${job.status}
                </span>
                ${job.status === 'completed' ? `
                  <button onclick="downloadFile(${job.id})" class="text-sm text-primary hover:text-blue-700">
                    Download
                  </button>
                ` : ''}
              </div>
            </div>
          `).join('');
        }
      } catch (error) {
        console.error('Failed to load history:', error);
      }
    }

    loadHistory();
  </script>
</Layout>
