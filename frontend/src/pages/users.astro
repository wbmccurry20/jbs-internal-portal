---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Manage Users - JBS Portal">
  <div class="space-y-6">
    <div class="flex justify-between items-center">
      <h1 class="text-3xl font-bold text-gray-900">User Management</h1>
      <a href="/dashboard" class="text-sm text-gray-600 hover:text-gray-900">
        ← Back to Dashboard
      </a>
    </div>

    <!-- Add User Form -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-xl font-semibold mb-4">Create New User</h2>
      <form id="create-user-form" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
          <input type="text" id="name" required class="w-full px-3 py-2 border border-gray-300 rounded-md" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" id="email" required class="w-full px-3 py-2 border border-gray-300 rounded-md" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Password (min 8 chars)</label>
          <input type="password" id="password" required minlength="8" class="w-full px-3 py-2 border border-gray-300 rounded-md" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
          <select id="role" required class="w-full px-3 py-2 border border-gray-300 rounded-md">
            <option value="employee">Employee</option>
            <option value="trainee">Trainee</option>
            <option value="owner">Owner</option>
            <option value="finance">Finance / Accountant</option>
          </select>
        </div>
        <div class="md:col-span-2">
          <button type="submit" class="bg-primary text-white px-4 py-2 rounded-md hover:bg-blue-700">
            Create User
          </button>
        </div>
      </form>
    </div>

    <!-- Users List -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-xl font-semibold mb-4">All Users</h2>
      <div id="loading" class="text-center py-4">Loading users...</div>
      <div id="users-list" class="hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Created</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
            </tr>
          </thead>
          <tbody id="users-tbody" class="bg-white divide-y divide-gray-200">
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    import { listUsers, createUser, deleteUser, resetUserPassword } from '../lib/api';
    import { toast } from '../utils/toast';
    import { ErrorHandler } from '../utils/errorHandler';
    import { createTableSkeleton, setButtonLoading } from '../utils/loading';

    const token = localStorage.getItem('jbs_token');
    if (!token) {
      window.location.href = '/';
    }

    // Load users
    async function loadUsers() {
      const tbody = document.getElementById('users-tbody');
      const loadingDiv = document.getElementById('loading');
      const usersListDiv = document.getElementById('users-list');

      try {
        // Show skeleton
        if (tbody) {
          tbody.innerHTML = Array.from({ length: 5 }, () => `
            <tr class="animate-pulse">
              <td class="px-6 py-4"><div class="h-4 bg-gray-200 rounded w-32"></div></td>
              <td class="px-6 py-4"><div class="h-4 bg-gray-200 rounded w-48"></div></td>
              <td class="px-6 py-4"><div class="h-4 bg-gray-200 rounded w-24"></div></td>
              <td class="px-6 py-4"><div class="h-4 bg-gray-200 rounded w-24"></div></td>
              <td class="px-6 py-4"><div class="h-4 bg-gray-200 rounded w-32"></div></td>
            </tr>
          `).join('');
        }

        loadingDiv?.classList.add('hidden');
        usersListDiv?.classList.remove('hidden');

        const users = await listUsers();

        tbody!.innerHTML = users.map(user => {
          const safeId = Number(user.id);
          const safeName = escapeHtml(user.name);
          const safeEmail = escapeHtml(user.email);
          const safeRole = escapeHtml(user.role);
          const safeDate = new Date(user.created_at).toLocaleDateString();
          const isProtected = user.email === 'hello@itwill.dev';

          const actions = isProtected
            ? '<span class="text-gray-400">Protected</span>'
            : `<button data-action="reset" data-id="${safeId}" class="text-yellow-600 hover:text-yellow-900">Reset Password</button>
               <button data-action="delete" data-id="${safeId}" data-email="${safeEmail}" class="text-red-600 hover:text-red-900">Delete</button>`;

          return `<tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${safeName}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${safeEmail}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${safeRole}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${safeDate}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">${actions}</td>
          </tr>`;
        }).join('');

        // Attach event listeners instead of inline onclick handlers
        tbody!.querySelectorAll('[data-action="reset"]').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = Number((btn as HTMLElement).dataset.id);
            (window as any).resetPassword(id);
          });
        });
        tbody!.querySelectorAll('[data-action="delete"]').forEach(btn => {
          btn.addEventListener('click', () => {
            const el = btn as HTMLElement;
            (window as any).deleteUserConfirm(Number(el.dataset.id), el.dataset.email || '');
          });
        });
      } catch (error) {
        loadingDiv!.textContent = 'Failed to load users';
        loadingDiv?.classList.remove('hidden');
        ErrorHandler.handle(error, 'Failed to load users');
      }
    }

    // Create user
    document.getElementById('create-user-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

      try {
        setButtonLoading(submitBtn, true);

        const name = (document.getElementById('name') as HTMLInputElement).value;
        const email = (document.getElementById('email') as HTMLInputElement).value;
        const password = (document.getElementById('password') as HTMLInputElement).value;
        const role = (document.getElementById('role') as HTMLSelectElement).value;

        await createUser(email, password, name, role);

        toast.success('User created successfully!');
        form.reset();
        loadUsers();
      } catch (error) {
        ErrorHandler.handle(error, 'Failed to create user');
      } finally {
        setButtonLoading(submitBtn, false);
      }
    });

    // Delete user (make available globally)
    (window as any).deleteUserConfirm = async (userId: number, email: string) => {
      if (confirm(`Are you sure you want to delete user: ${email}?`)) {
        try {
          await deleteUser(userId);
          toast.success('User deleted successfully');
          loadUsers();
        } catch (error) {
          ErrorHandler.handle(error, 'Failed to delete user');
        }
      }
    };

    // Reset password (make available globally)
    (window as any).resetPassword = async (userId: number) => {
      const newPassword = prompt('Enter new password (min 8 characters):');
      if (newPassword && newPassword.length >= 8) {
        try {
          await resetUserPassword(userId, newPassword);
          toast.success('Password reset successfully');
        } catch (error) {
          ErrorHandler.handle(error, 'Failed to reset password');
        }
      } else if (newPassword) {
        ErrorHandler.handleValidationError('Password', 'Must be at least 8 characters');
      }
    };

    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str || '';
      return div.innerHTML;
    }

    loadUsers();
  </script>
</Layout>
