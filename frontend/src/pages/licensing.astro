---
import Layout from '../layouts/Layout.astro';
import USMapClean from '../components/USMapClean.astro';
---

<Layout>
  <div class="space-y-6">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">State Licensing</h1>
        <p class="mt-2 text-sm text-gray-600">Manage licenses across all states</p>
      </div>
      <button id="add-license-btn" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 shadow-sm transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        Add License
      </button>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
        <div class="text-sm text-gray-600">Total States</div>
        <div id="total-states" class="text-2xl font-bold text-gray-900">-</div>
      </div>
      <div class="bg-green-50 p-4 rounded-lg shadow-sm border border-green-200">
        <div class="text-sm text-green-700">Active</div>
        <div id="active-count" class="text-2xl font-bold text-green-900">-</div>
      </div>
      <div class="bg-yellow-50 p-4 rounded-lg shadow-sm border border-yellow-200">
        <div class="text-sm text-yellow-700">Expiring Soon</div>
        <div id="expiring-count" class="text-2xl font-bold text-yellow-900">-</div>
      </div>
      <div class="bg-red-50 p-4 rounded-lg shadow-sm border border-red-200">
        <div class="text-sm text-red-700">Expired</div>
        <div id="expired-count" class="text-2xl font-bold text-red-900">-</div>
      </div>
    </div>

    <!-- License Dashboard -->
    <div>
      <USMapClean />
    </div>

    <!-- License List -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div id="licenses-container" class="overflow-x-auto">
        <div id="loading" class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600"></div>
          <p class="mt-4 text-gray-600">Loading licenses...</p>
        </div>
      </div>
    </div>

    <!-- SharePoint Document Browser -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.5 3.5l-8 4.04v8.92l8 4.04 8-4.04V7.54l-8-4.04zm0 2.08l5.53 2.79-5.53 2.79L6.97 8.37l5.53-2.79zM6.5 9.73l5 2.53v5.01l-5-2.53V9.73zm11 5.01l-5 2.53v-5.01l5-2.53v5.01z"/>
          </svg>
          <div>
            <h2 class="text-lg font-semibold text-gray-900">SharePoint Documents</h2>
            <p class="text-xs text-gray-500">Browse licensing documents on SharePoint</p>
          </div>
        </div>
        <div id="sp-connection" class="flex items-center gap-3">
          <span id="sp-status-badge" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
            Checking...
          </span>
          <button id="sp-connect-btn" class="hidden inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors">
            <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            Connect Microsoft
          </button>
          <button id="sp-disconnect-btn" class="hidden inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 transition-colors">
            Disconnect
          </button>
        </div>
      </div>

      <!-- Breadcrumb -->
      <div id="sp-breadcrumb" class="hidden px-6 py-2 bg-gray-50 border-b border-gray-200">
        <nav class="flex items-center text-sm text-gray-500">
          <button class="sp-crumb hover:text-blue-600 font-medium" data-path="">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/></svg>
            Licensing
          </button>
          <span id="sp-crumb-trail"></span>
        </nav>
      </div>

      <!-- File browser content -->
      <div id="sp-browser" class="hidden">
        <div id="sp-loading" class="hidden text-center py-8">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
          <p class="mt-2 text-sm text-gray-500">Loading files...</p>
        </div>
        <div id="sp-items" class="divide-y divide-gray-100"></div>
        <div id="sp-empty" class="hidden text-center py-8 text-gray-400 text-sm">
          This folder is empty
        </div>
      </div>

      <!-- Not connected state -->
      <div id="sp-not-connected" class="hidden text-center py-10 px-6">
        <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
        </svg>
        <p class="mt-3 text-sm text-gray-600">Connect your Microsoft account to browse licensing documents on SharePoint</p>
        <p class="mt-1 text-xs text-gray-400">Files stay on SharePoint — nothing is downloaded or copied</p>
      </div>

      <!-- Not configured state -->
      <div id="sp-not-configured" class="hidden text-center py-10 px-6">
        <svg class="mx-auto h-12 w-12 text-yellow-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
        </svg>
        <p class="mt-3 text-sm text-gray-600">SharePoint integration is not configured</p>
        <p class="mt-1 text-xs text-gray-400">Azure environment variables need to be set by an administrator</p>
      </div>
    </div>
  </div>

  <!-- Add/Edit License Modal -->
  <div id="license-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-full max-w-2xl shadow-lg rounded-lg bg-white">
      <div class="flex justify-between items-center mb-4">
        <h3 id="modal-title" class="text-2xl font-bold text-gray-900">Add License</h3>
        <button id="close-modal" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="license-form" class="space-y-4">
        <input type="hidden" id="license-id">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="state" class="block text-sm font-medium text-gray-700 mb-1">State *</label>
            <select id="state" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="">Select State</option>
              <option value="AL">Alabama</option>
              <option value="AK">Alaska</option>
              <option value="AZ">Arizona</option>
              <option value="AR">Arkansas</option>
              <option value="CA">California</option>
              <option value="CO">Colorado</option>
              <option value="CT">Connecticut</option>
              <option value="DE">Delaware</option>
              <option value="FL">Florida</option>
              <option value="GA">Georgia</option>
              <option value="HI">Hawaii</option>
              <option value="ID">Idaho</option>
              <option value="IL">Illinois</option>
              <option value="IN">Indiana</option>
              <option value="IA">Iowa</option>
              <option value="KS">Kansas</option>
              <option value="KY">Kentucky</option>
              <option value="LA">Louisiana</option>
              <option value="ME">Maine</option>
              <option value="MD">Maryland</option>
              <option value="MA">Massachusetts</option>
              <option value="MI">Michigan</option>
              <option value="MN">Minnesota</option>
              <option value="MS">Mississippi</option>
              <option value="MO">Missouri</option>
              <option value="MT">Montana</option>
              <option value="NE">Nebraska</option>
              <option value="NV">Nevada</option>
              <option value="NH">New Hampshire</option>
              <option value="NJ">New Jersey</option>
              <option value="NM">New Mexico</option>
              <option value="NY">New York</option>
              <option value="NC">North Carolina</option>
              <option value="ND">North Dakota</option>
              <option value="OH">Ohio</option>
              <option value="OK">Oklahoma</option>
              <option value="OR">Oregon</option>
              <option value="PA">Pennsylvania</option>
              <option value="RI">Rhode Island</option>
              <option value="SC">South Carolina</option>
              <option value="SD">South Dakota</option>
              <option value="TN">Tennessee</option>
              <option value="TX">Texas</option>
              <option value="UT">Utah</option>
              <option value="VT">Vermont</option>
              <option value="VA">Virginia</option>
              <option value="WA">Washington</option>
              <option value="WV">West Virginia</option>
              <option value="WI">Wisconsin</option>
              <option value="WY">Wyoming</option>
            </select>
          </div>
          <div>
            <label for="license-type" class="block text-sm font-medium text-gray-700 mb-1">License Type *</label>
            <input type="text" id="license-type" required placeholder="e.g., General Contractor" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City</label>
            <input type="text" id="city" placeholder="Leave blank for state-level license" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div class="flex items-end pb-2">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="is-city-license" class="w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500">
              <span class="text-sm font-medium text-gray-700">City License</span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="license-number" class="block text-sm font-medium text-gray-700 mb-1">License Number</label>
            <input type="text" id="license-number" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="entity-name" class="block text-sm font-medium text-gray-700 mb-1">Entity Name</label>
            <input type="text" id="entity-name" placeholder="JBS Construction Group" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="issue-date" class="block text-sm font-medium text-gray-700 mb-1">Issue Date</label>
            <input type="date" id="issue-date" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="expiration-date" class="block text-sm font-medium text-gray-700 mb-1">Expiration Date</label>
            <input type="date" id="expiration-date" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
            <select id="status" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="">Auto-calculate</option>
              <option value="active">Active</option>
              <option value="expiring">Expiring Soon</option>
              <option value="expired">Expired</option>
            </select>
          </div>
          <div>
            <label for="renewal-fee" class="block text-sm font-medium text-gray-700 mb-1">Renewal Fee ($)</label>
            <input type="number" id="renewal-fee" step="0.01" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
          <textarea id="notes" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"></textarea>
        </div>

        <div class="flex justify-end space-x-3 pt-4">
          <button type="button" id="cancel-btn" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium">
            Cancel
          </button>
          <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-medium">
            Save License
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { escapeHtml } from '../utils/html';
    import { getApiUrl } from '../utils/api';
    import { toast } from '../utils/toast';

    const API_URL = getApiUrl();
    const token = localStorage.getItem('jbs_token');

    if (!token) {
      window.location.href = '/';
    }

    const modal = document.getElementById('license-modal')!;
    const form = document.getElementById('license-form') as HTMLFormElement;
    const container = document.getElementById('licenses-container')!;
    const loading = document.getElementById('loading')!;

    interface License {
      id: number;
      state: string;
      license_type: string;
      license_number: string | null;
      entity_name: string | null;
      issue_date: string | null;
      expiration_date: string | null;
      status: string;
      renewal_fee: number;
      notes: string | null;
      city: string | null;
      is_city_license: boolean;
      is_active: boolean;
    }

    // Track current licenses globally
    let currentLicenses: License[] = [];

    // Load licenses
    async function loadLicenses() {
      try {
        const response = await fetch(`${API_URL}/licenses`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (!response.ok) throw new Error('Failed to load licenses');

        const licenses: License[] = await response.json();
        currentLicenses = licenses; // Store for later access
        loading.classList.add('hidden');

        if (licenses.length === 0) {
          container.innerHTML = '<div class="text-center py-12 text-gray-500">No licenses yet. Add your first license to get started!</div>';
          return;
        }

        // Render table
        container.innerHTML = `
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">State</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">City</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">License #</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expiration</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              ${licenses.map((license: License) => `
                <tr class="${license.is_city_license ? 'bg-blue-50' : ''}">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${escapeHtml(license.state)}</td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ${license.is_city_license ? `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">${escapeHtml(license.city || 'City')}</span>` : '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${escapeHtml(license.license_type)}</td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${escapeHtml(license.license_number || '-')}</td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${escapeHtml(license.expiration_date || '-')}</td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                      ${license.status === 'active' ? 'bg-green-100 text-green-800' : 
                        license.status === 'expiring' ? 'bg-yellow-100 text-yellow-800' : 
                        'bg-red-100 text-red-800'}">
                      ${escapeHtml(license.status || 'unknown')}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-3">
                    <button onclick="window.editLicenseRow(${license.id})" class="text-primary-600 hover:text-primary-900">Edit</button>
                    <button onclick="deleteLicense(${license.id})" class="text-red-600 hover:text-red-900">Delete</button>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;

        // Update stats
        updateStats(licenses);
        
        // Update map
        renderUSMap(licenses);

      } catch (error: any) {
        loading.classList.add('hidden');
        container.innerHTML = '<div class="text-center py-12 text-red-500">Failed to load licenses</div>';
        
        // Still render empty grid even if API fails
        renderUSMap([]);
      }
    }

    function updateStats(licenses: License[]) {
      const statesWithLicenses = new Set(licenses.map((l: License) => l.state)).size;
      const active = licenses.filter((l: License) => l.status === 'active').length;
      const expiring = licenses.filter((l: License) => l.status === 'expiring').length;
      const expired = licenses.filter((l: License) => l.status === 'expired').length;

      document.getElementById('total-states')!.textContent = String(statesWithLicenses);
      document.getElementById('active-count')!.textContent = String(active);
      document.getElementById('expiring-count')!.textContent = String(expiring);
      document.getElementById('expired-count')!.textContent = String(expired);
    }

    // Map full state names to abbreviations
    const stateToAbbr: {[key: string]: string} = {
      'Alabama': 'AL', 'Alaska': 'AK', 'Arizona': 'AZ', 'Arkansas': 'AR', 'California': 'CA',
      'Colorado': 'CO', 'Connecticut': 'CT', 'Delaware': 'DE', 'Florida': 'FL', 'Georgia': 'GA',
      'Hawaii': 'HI', 'Idaho': 'ID', 'Illinois': 'IL', 'Indiana': 'IN', 'Iowa': 'IA',
      'Kansas': 'KS', 'Kentucky': 'KY', 'Louisiana': 'LA', 'Maine': 'ME', 'Maryland': 'MD',
      'Massachusetts': 'MA', 'Michigan': 'MI', 'Minnesota': 'MN', 'Mississippi': 'MS', 'Missouri': 'MO',
      'Montana': 'MT', 'Nebraska': 'NE', 'Nevada': 'NV', 'New Hampshire': 'NH', 'New Jersey': 'NJ',
      'New Mexico': 'NM', 'New York': 'NY', 'North Carolina': 'NC', 'North Dakota': 'ND', 'Ohio': 'OH',
      'Oklahoma': 'OK', 'Oregon': 'OR', 'Pennsylvania': 'PA', 'Rhode Island': 'RI', 'South Carolina': 'SC',
      'South Dakota': 'SD', 'Tennessee': 'TN', 'Texas': 'TX', 'Utah': 'UT', 'Vermont': 'VT',
      'Virginia': 'VA', 'Washington': 'WA', 'West Virginia': 'WV', 'Wisconsin': 'WI', 'Wyoming': 'WY'
    };

    function renderUSMap(licenses: License[]) {
      if (typeof (window as any).renderCleanMap === 'function') {
        (window as any).renderCleanMap(licenses);
      }
    }
    
    // Make editLicenseRow globally accessible for table Edit buttons
    (window as any).editLicenseRow = function(licenseId: number) {
      const license = currentLicenses.find(l => l.id === licenseId);
      if (!license) return;
      editLicense(license);
    };

    // Make editLicense globally accessible for state cards
    (window as any).editLicense = function(stateCode: string, stateName: string) {
      const licenseMap = new Map<string, License>();
      currentLicenses.forEach(l => licenseMap.set(l.state, l));
      
      const license = licenseMap.get(stateCode);
      
      if (license) {
        // Edit existing license
        (document.getElementById('license-id') as HTMLInputElement).value = String(license.id);
        (document.getElementById('state') as HTMLSelectElement).value = license.state;
        (document.getElementById('license-type') as HTMLInputElement).value = license.license_type;
        (document.getElementById('license-number') as HTMLInputElement).value = license.license_number || '';
        (document.getElementById('entity-name') as HTMLInputElement).value = license.entity_name || '';
        (document.getElementById('issue-date') as HTMLInputElement).value = license.issue_date || '';
        (document.getElementById('expiration-date') as HTMLInputElement).value = license.expiration_date || '';
        (document.getElementById('status') as HTMLSelectElement).value = license.status;
        (document.getElementById('renewal-fee') as HTMLInputElement).value = String(license.renewal_fee || 0);
        (document.getElementById('notes') as HTMLTextAreaElement).value = license.notes || '';
        (document.getElementById('city') as HTMLInputElement).value = license.city || '';
        (document.getElementById('is-city-license') as HTMLInputElement).checked = license.is_city_license || false;
        
        document.getElementById('modal-title')!.textContent = `Edit License - ${stateName}`;
      } else {
        // Add new license for this state
        form.reset();
        (document.getElementById('license-id') as HTMLInputElement).value = '';
        (document.getElementById('state') as HTMLSelectElement).value = stateCode;
        document.getElementById('modal-title')!.textContent = `Add License - ${stateName}`;
      }
      
      modal.classList.remove('hidden');
    };
    
    function editLicense(license: License) {
      (document.getElementById('license-id') as HTMLInputElement).value = String(license.id);
      (document.getElementById('state') as HTMLSelectElement).value = license.state;
      (document.getElementById('license-type') as HTMLInputElement).value = license.license_type;
      (document.getElementById('license-number') as HTMLInputElement).value = license.license_number || '';
      (document.getElementById('entity-name') as HTMLInputElement).value = license.entity_name || '';
      (document.getElementById('issue-date') as HTMLInputElement).value = license.issue_date || '';
      (document.getElementById('expiration-date') as HTMLInputElement).value = license.expiration_date || '';
      (document.getElementById('status') as HTMLSelectElement).value = license.status;
      (document.getElementById('renewal-fee') as HTMLInputElement).value = String(license.renewal_fee || 0);
      (document.getElementById('notes') as HTMLTextAreaElement).value = license.notes || '';
      (document.getElementById('city') as HTMLInputElement).value = license.city || '';
      (document.getElementById('is-city-license') as HTMLInputElement).checked = license.is_city_license || false;
      
      document.getElementById('modal-title')!.textContent = `Edit License - ${license.state}`;
      modal.classList.remove('hidden');
    }

    // Open modal
    document.getElementById('add-license-btn')!.addEventListener('click', () => {
      form.reset();
      (document.getElementById('license-id') as HTMLInputElement).value = '';
      (document.getElementById('is-city-license') as HTMLInputElement).checked = false;
      document.getElementById('modal-title')!.textContent = 'Add License';
      modal.classList.remove('hidden');
    });

    // Close modal
    document.getElementById('close-modal')!.addEventListener('click', () => modal.classList.add('hidden'));
    document.getElementById('cancel-btn')!.addEventListener('click', () => modal.classList.add('hidden'));

    // Submit form
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = {
        state: (document.getElementById('state') as HTMLInputElement).value,
        license_type: (document.getElementById('license-type') as HTMLInputElement).value,
        license_number: (document.getElementById('license-number') as HTMLInputElement).value,
        entity_name: (document.getElementById('entity-name') as HTMLInputElement).value,
        issue_date: (document.getElementById('issue-date') as HTMLInputElement).value,
        expiration_date: (document.getElementById('expiration-date') as HTMLInputElement).value,
        status: (document.getElementById('status') as HTMLSelectElement).value,
        renewal_fee: parseFloat((document.getElementById('renewal-fee') as HTMLInputElement).value) || 0,
        notes: (document.getElementById('notes') as HTMLTextAreaElement).value,
        city: (document.getElementById('city') as HTMLInputElement).value,
        is_city_license: (document.getElementById('is-city-license') as HTMLInputElement).checked,
        is_active: true
      };

      const licenseId = (document.getElementById('license-id') as HTMLInputElement).value;
      const isEdit = licenseId !== '';

      try {
        const url = isEdit ? `${API_URL}/licenses/${licenseId}` : `${API_URL}/licenses`;
        const method = isEdit ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(data)
        });

        if (!response.ok) throw new Error('Failed to save license');

        modal.classList.add('hidden');
        loadLicenses();
      } catch (error: any) {
        toast.error('Failed to save license: ' + error.message);
      }
    });

    // Delete license
    (window as any).deleteLicense = async (id: number) => {
      if (!confirm('Are you sure you want to delete this license?')) return;

      try {
        const response = await fetch(`${API_URL}/licenses/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (!response.ok) throw new Error('Failed to delete');

        loadLicenses();
      } catch (error) {
        toast.error('Failed to delete license');
      }
    };

    // Initial load
    loadLicenses();
    
    // Render empty map immediately
    if (typeof (window as any).renderCleanMap === 'function') {
      (window as any).renderCleanMap([]);
    }

    // ═══════════════════════════════════════════════════════════
    // SharePoint Document Browser
    // ═══════════════════════════════════════════════════════════

    const spConnectBtn = document.getElementById('sp-connect-btn')!;
    const spDisconnectBtn = document.getElementById('sp-disconnect-btn')!;
    const spStatusBadge = document.getElementById('sp-status-badge')!;
    const spBreadcrumb = document.getElementById('sp-breadcrumb')!;
    const spBrowser = document.getElementById('sp-browser')!;
    const spLoading = document.getElementById('sp-loading')!;
    const spItems = document.getElementById('sp-items')!;
    const spEmpty = document.getElementById('sp-empty')!;
    const spNotConnected = document.getElementById('sp-not-connected')!;
    const spNotConfigured = document.getElementById('sp-not-configured')!;
    const spCrumbTrail = document.getElementById('sp-crumb-trail')!;

    let spCurrentPath = '';

    // Handle ?sp= query param after OAuth redirect
    const urlParams = new URLSearchParams(window.location.search);
    const spParam = urlParams.get('sp');
    if (spParam) {
      // Clean up URL
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, '', cleanUrl);
      if (spParam === 'error') {
        toast.error('SharePoint connection failed. Please try again.');
      }
    }

    // Check SharePoint status on load
    async function checkSharePointStatus() {
      try {
        const res = await fetch(`${API_URL}/sharepoint/status`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) {
          // User may not have permission — hide section
          return;
        }
        const data = await res.json();

        if (!data.configured) {
          spStatusBadge.textContent = 'Not Configured';
          spStatusBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700';
          spNotConfigured.classList.remove('hidden');
          return;
        }

        if (data.connected) {
          showConnectedState();
          browseSP('');
        } else {
          showDisconnectedState();
        }
      } catch {
        // Silently fail — sharepoint is optional
      }
    }

    function showConnectedState() {
      spStatusBadge.textContent = 'Connected';
      spStatusBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700';
      spConnectBtn.classList.add('hidden');
      spDisconnectBtn.classList.remove('hidden');
      spBreadcrumb.classList.remove('hidden');
      spBrowser.classList.remove('hidden');
      spNotConnected.classList.add('hidden');
      spNotConfigured.classList.add('hidden');
    }

    function showDisconnectedState() {
      spStatusBadge.textContent = 'Not Connected';
      spStatusBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600';
      spConnectBtn.classList.remove('hidden');
      spDisconnectBtn.classList.add('hidden');
      spBreadcrumb.classList.add('hidden');
      spBrowser.classList.add('hidden');
      spNotConnected.classList.remove('hidden');
      spNotConfigured.classList.add('hidden');
      spItems.innerHTML = '';
    }

    // Connect button → start OAuth
    spConnectBtn.addEventListener('click', async () => {
      try {
        const res = await fetch(`${API_URL}/sharepoint/auth`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) throw new Error('Failed to start auth');
        const data = await res.json();
        window.location.href = data.auth_url;
      } catch {
        toast.error('Failed to start SharePoint connection');
      }
    });

    // Disconnect button
    spDisconnectBtn.addEventListener('click', async () => {
      if (!confirm('Disconnect from SharePoint?')) return;
      try {
        await fetch(`${API_URL}/sharepoint/disconnect`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch { /* ignore */ }
      showDisconnectedState();
    });

    // Browse a SharePoint folder
    async function browseSP(path: string) {
      spCurrentPath = path;
      spLoading.classList.remove('hidden');
      spItems.innerHTML = '';
      spEmpty.classList.add('hidden');
      updateBreadcrumb(path);

      try {
        const res = await fetch(`${API_URL}/sharepoint/browse?path=${encodeURIComponent(path)}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (res.status === 401) {
          showDisconnectedState();
          return;
        }

        if (!res.ok) throw new Error('Browse failed');

        const data = await res.json();
        spLoading.classList.add('hidden');

        if (!data.items || data.items.length === 0) {
          spEmpty.classList.remove('hidden');
          return;
        }

        renderItems(data.items);
      } catch (err) {
        spLoading.classList.add('hidden');
        spItems.innerHTML = '<div class="px-6 py-4 text-sm text-red-500">Failed to load folder contents</div>';
      }
    }

    // Update breadcrumb navigation
    function updateBreadcrumb(path: string) {
      if (!path) {
        spCrumbTrail.innerHTML = '';
        return;
      }

      const parts = path.split('/');
      let html = '';
      let buildPath = '';
      for (const part of parts) {
        buildPath = buildPath ? buildPath + '/' + part : part;
        html += `
          <svg class="w-4 h-4 mx-1 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
          <button class="sp-crumb hover:text-blue-600" data-path="${escapeHtml(buildPath)}">${escapeHtml(part)}</button>
        `;
      }
      spCrumbTrail.innerHTML = html;
    }

    // Breadcrumb click delegation
    spBreadcrumb.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.sp-crumb') as HTMLElement | null;
      if (btn) {
        browseSP(btn.dataset.path || '');
      }
    });

    interface SPItem {
      id: string;
      name: string;
      size: number;
      web_url: string;
      is_folder: boolean;
      mime_type?: string;
      child_count?: number;
      modified_at: string;
      modified_by?: string;
    }

    function renderItems(items: SPItem[]) {
      // Sort: folders first, then files, alphabetical
      const sorted = [...items].sort((a, b) => {
        if (a.is_folder !== b.is_folder) return a.is_folder ? -1 : 1;
        return a.name.localeCompare(b.name);
      });

      spItems.innerHTML = sorted.map(item => {
        const modDate = item.modified_at ? new Date(item.modified_at).toLocaleDateString() : '';
        const sizeStr = item.is_folder ? `${item.child_count || 0} items` : formatFileSize(item.size);

        if (item.is_folder) {
          return `
            <button class="sp-folder-btn w-full flex items-center px-6 py-3 hover:bg-blue-50 transition-colors text-left group"
                    data-path="${escapeHtml(spCurrentPath ? spCurrentPath + '/' + item.name : item.name)}">
              <svg class="w-5 h-5 text-blue-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/>
              </svg>
              <div class="flex-1 min-w-0">
                <span class="text-sm font-medium text-gray-900 group-hover:text-blue-700">${escapeHtml(item.name)}</span>
              </div>
              <span class="text-xs text-gray-400 mr-4">${sizeStr}</span>
              <span class="text-xs text-gray-400 mr-4">${modDate}</span>
              <svg class="w-4 h-4 text-gray-300 group-hover:text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          `;
        } else {
          const icon = getFileIcon(item.name, item.mime_type);
          return `
            <div class="flex items-center px-6 py-3 hover:bg-gray-50 transition-colors group">
              ${icon}
              <div class="flex-1 min-w-0">
                <span class="text-sm text-gray-700">${escapeHtml(item.name)}</span>
              </div>
              <span class="text-xs text-gray-400 mr-4">${sizeStr}</span>
              <span class="text-xs text-gray-400 mr-4">${modDate}</span>
              <a href="${escapeHtml(item.web_url)}" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition-colors opacity-0 group-hover:opacity-100">
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                Open
              </a>
            </div>
          `;
        }
      }).join('');
    }

    // Folder click delegation
    spItems.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.sp-folder-btn') as HTMLElement | null;
      if (btn) {
        browseSP(btn.dataset.path || '');
      }
    });

    function formatFileSize(bytes: number): string {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function getFileIcon(name: string, mimeType?: string): string {
      const ext = name.split('.').pop()?.toLowerCase() || '';
      const iconClass = 'w-5 h-5 mr-3 flex-shrink-0';

      // PDF
      if (ext === 'pdf') {
        return `<svg class="${iconClass} text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>`;
      }
      // Images
      if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'svg'].includes(ext)) {
        return `<svg class="${iconClass} text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/></svg>`;
      }
      // Word docs
      if (['doc', 'docx'].includes(ext)) {
        return `<svg class="${iconClass} text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>`;
      }
      // Excel
      if (['xls', 'xlsx', 'csv'].includes(ext)) {
        return `<svg class="${iconClass} text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>`;
      }
      // Default
      return `<svg class="${iconClass} text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>`;
    }

    // Check status on page load
    checkSharePointStatus();
  </script>
</Layout>
