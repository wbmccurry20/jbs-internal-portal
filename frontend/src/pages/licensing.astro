---
import Layout from '../layouts/Layout.astro';
import USMapClean from '../components/USMapClean.astro';
---

<Layout>
  <div class="space-y-6">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">State Licensing</h1>
        <p class="mt-2 text-sm text-gray-600">Manage licenses across all states</p>
      </div>
      <button id="add-license-btn" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 shadow-sm transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        Add License
      </button>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
        <div class="text-sm text-gray-600">Total Licenses</div>
        <div id="total-licenses" class="text-2xl font-bold text-gray-900">-</div>
        <div id="total-licenses-sub" class="text-xs text-gray-400 mt-0.5">— states licensed</div>
      </div>
      <div class="bg-green-50 p-4 rounded-lg shadow-sm border border-green-200">
        <div class="text-sm text-green-700">Active</div>
        <div id="active-count" class="text-2xl font-bold text-green-900">-</div>
      </div>
      <div class="bg-yellow-50 p-4 rounded-lg shadow-sm border border-yellow-200">
        <div class="text-sm text-yellow-700">Expiring Soon</div>
        <div id="expiring-count" class="text-2xl font-bold text-yellow-900">-</div>
      </div>
      <div class="bg-red-50 p-4 rounded-lg shadow-sm border border-red-200">
        <div class="text-sm text-red-700">Expired</div>
        <div id="expired-count" class="text-2xl font-bold text-red-900">-</div>
      </div>
    </div>

    <!-- License Dashboard -->
    <div>
      <USMapClean />
    </div>

    <!-- Auto-Discover from SharePoint -->
    <div id="scan-section" class="hidden bg-white rounded-lg shadow-sm border border-blue-200">
      <div class="px-6 py-4 border-b border-blue-100 flex justify-between items-center bg-blue-50/50">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <div>
            <h2 class="text-base font-semibold text-gray-900">Auto-Discover from SharePoint</h2>
            <p class="text-xs text-gray-500">Scan state folders to create license records</p>
          </div>
        </div>
      </div>
      <div class="px-6 py-4">
        <!-- Scan Controls -->
        <div class="flex items-center gap-3 mb-4">
          <select id="scan-state-select" class="flex-1 max-w-xs rounded-lg border-gray-300 text-sm focus:ring-blue-500 focus:border-blue-500">
            <option value="">Select a state to scan...</option>
          </select>
          <button id="scan-btn" class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            Scan
          </button>
        </div>

        <!-- Scan spinner -->
        <div id="scan-loading" class="hidden text-center py-6">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
          <p class="mt-2 text-sm text-gray-500">Scanning SharePoint folder...</p>
        </div>

        <!-- Scan Results -->
        <div id="scan-results" class="hidden">
          <div id="scan-summary" class="text-sm text-gray-600 mb-3"></div>

          <!-- Suggestions table -->
          <div id="scan-suggestions" class="space-y-2 mb-4"></div>

          <!-- Already tracked (collapsed) -->
          <div id="scan-tracked-section" class="hidden mb-4">
            <button id="scan-tracked-toggle" class="text-xs text-gray-500 hover:text-gray-700 flex items-center gap-1">
              <svg id="scan-tracked-chevron" class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              <span id="scan-tracked-label">Already tracked</span>
            </button>
            <div id="scan-tracked-list" class="hidden mt-2 space-y-1"></div>
          </div>

          <!-- Skipped folders (collapsed) -->
          <div id="scan-skipped-section" class="hidden mb-4">
            <button id="scan-skipped-toggle" class="text-xs text-gray-400 hover:text-gray-600 flex items-center gap-1">
              <svg id="scan-skipped-chevron" class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              <span id="scan-skipped-label">Skipped folders</span>
            </button>
            <div id="scan-skipped-list" class="hidden mt-2 text-xs text-gray-400"></div>
          </div>

          <!-- Approve button -->
          <div id="scan-actions" class="flex items-center gap-3 pt-3 border-t border-gray-200">
            <button id="scan-select-all" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Select All</button>
            <div class="flex-1"></div>
            <button id="scan-approve-btn" class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
              Approve Selected (<span id="scan-selected-count">0</span>)
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- License List -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div id="licenses-container" class="overflow-x-auto">
        <div id="loading" class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600"></div>
          <p class="mt-4 text-gray-600">Loading licenses...</p>
        </div>
      </div>
    </div>

    <!-- SharePoint Document Browser -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.5 3.5l-8 4.04v8.92l8 4.04 8-4.04V7.54l-8-4.04zm0 2.08l5.53 2.79-5.53 2.79L6.97 8.37l5.53-2.79zM6.5 9.73l5 2.53v5.01l-5-2.53V9.73zm11 5.01l-5 2.53v-5.01l5-2.53v5.01z"/>
          </svg>
          <div>
            <h2 class="text-lg font-semibold text-gray-900">SharePoint Documents</h2>
            <p class="text-xs text-gray-500">Browse licensing documents on SharePoint</p>
          </div>
        </div>
        <div id="sp-connection" class="flex items-center gap-3">
          <span id="sp-status-badge" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
            Checking...
          </span>
          <button id="sp-connect-btn" class="hidden inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors">
            <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            Connect Microsoft
          </button>
          <button id="sp-disconnect-btn" class="hidden inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 transition-colors">
            Disconnect
          </button>
        </div>
      </div>

      <!-- Breadcrumb -->
      <div id="sp-breadcrumb" class="hidden px-6 py-2 bg-gray-50 border-b border-gray-200">
        <nav class="flex items-center text-sm text-gray-500">
          <button class="sp-crumb hover:text-blue-600 font-medium" data-path="">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/></svg>
            Licensing
          </button>
          <span id="sp-crumb-trail"></span>
        </nav>
      </div>

      <!-- File browser content -->
      <div id="sp-browser" class="hidden">
        <div id="sp-loading" class="hidden text-center py-8">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
          <p class="mt-2 text-sm text-gray-500">Loading files...</p>
        </div>
        <div id="sp-items" class="divide-y divide-gray-100"></div>
        <div id="sp-empty" class="hidden text-center py-8 text-gray-400 text-sm">
          This folder is empty
        </div>
      </div>

      <!-- Not connected state -->
      <div id="sp-not-connected" class="hidden text-center py-10 px-6">
        <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
        </svg>
        <p class="mt-3 text-sm text-gray-600">Connect your Microsoft account to browse licensing documents on SharePoint</p>
        <p class="mt-1 text-xs text-gray-400">Files stay on SharePoint — nothing is downloaded or copied</p>
      </div>

      <!-- Not configured state -->
      <div id="sp-not-configured" class="hidden text-center py-10 px-6">
        <svg class="mx-auto h-12 w-12 text-yellow-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
        </svg>
        <p class="mt-3 text-sm text-gray-600">SharePoint integration is not configured</p>
        <p class="mt-1 text-xs text-gray-400">Azure environment variables need to be set by an administrator</p>
      </div>
    </div>
  </div>

  <!-- State Detail Panel (right drawer) -->
  <div id="state-panel" class="fixed inset-y-0 right-0 w-full max-w-lg bg-white shadow-2xl z-50 flex flex-col" style="transform: translateX(100%); transition: transform 0.3s ease;">
    <!-- Panel Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-gray-200">
      <div>
        <h2 id="panel-state-name" class="text-xl font-bold text-gray-900">—</h2>
        <p id="panel-license-meta" class="text-sm text-gray-500 mt-0.5">Loading...</p>
      </div>
      <button id="close-state-panel" class="p-2 text-gray-400 hover:text-gray-600 rounded-lg hover:bg-gray-100 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <!-- Panel Action -->
    <div class="px-6 py-3 bg-gray-50 border-b border-gray-200">
      <button id="panel-add-btn" class="w-full inline-flex items-center justify-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-lg hover:bg-primary-700 transition-colors">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        Add License for this State
      </button>
    </div>
    <!-- Panel License List -->
    <div id="panel-license-list" class="flex-1 overflow-y-auto p-6">
      <div class="text-center text-gray-400 py-12">
        <svg class="mx-auto h-10 w-10 mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <p class="text-sm">Select a state to view its licenses</p>
      </div>
    </div>
  </div>
  <!-- Panel overlay -->
  <div id="state-panel-overlay" class="fixed inset-0 bg-black bg-opacity-40 hidden z-40"></div>

  <!-- Add/Edit License Modal -->
  <div id="license-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-full max-w-2xl shadow-lg rounded-lg bg-white">
      <div class="flex justify-between items-center mb-4">
        <h3 id="modal-title" class="text-2xl font-bold text-gray-900">Add License</h3>
        <button id="close-modal" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="license-form" class="space-y-4">
        <input type="hidden" id="license-id">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="state" class="block text-sm font-medium text-gray-700 mb-1">State *</label>
            <select id="state" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="">Select State</option>
              <option value="AL">Alabama</option>
              <option value="AK">Alaska</option>
              <option value="AZ">Arizona</option>
              <option value="AR">Arkansas</option>
              <option value="CA">California</option>
              <option value="CO">Colorado</option>
              <option value="CT">Connecticut</option>
              <option value="DE">Delaware</option>
              <option value="FL">Florida</option>
              <option value="GA">Georgia</option>
              <option value="HI">Hawaii</option>
              <option value="ID">Idaho</option>
              <option value="IL">Illinois</option>
              <option value="IN">Indiana</option>
              <option value="IA">Iowa</option>
              <option value="KS">Kansas</option>
              <option value="KY">Kentucky</option>
              <option value="LA">Louisiana</option>
              <option value="ME">Maine</option>
              <option value="MD">Maryland</option>
              <option value="MA">Massachusetts</option>
              <option value="MI">Michigan</option>
              <option value="MN">Minnesota</option>
              <option value="MS">Mississippi</option>
              <option value="MO">Missouri</option>
              <option value="MT">Montana</option>
              <option value="NE">Nebraska</option>
              <option value="NV">Nevada</option>
              <option value="NH">New Hampshire</option>
              <option value="NJ">New Jersey</option>
              <option value="NM">New Mexico</option>
              <option value="NY">New York</option>
              <option value="NC">North Carolina</option>
              <option value="ND">North Dakota</option>
              <option value="OH">Ohio</option>
              <option value="OK">Oklahoma</option>
              <option value="OR">Oregon</option>
              <option value="PA">Pennsylvania</option>
              <option value="RI">Rhode Island</option>
              <option value="SC">South Carolina</option>
              <option value="SD">South Dakota</option>
              <option value="TN">Tennessee</option>
              <option value="TX">Texas</option>
              <option value="UT">Utah</option>
              <option value="VT">Vermont</option>
              <option value="VA">Virginia</option>
              <option value="WA">Washington</option>
              <option value="WV">West Virginia</option>
              <option value="WI">Wisconsin</option>
              <option value="WY">Wyoming</option>
            </select>
          </div>
          <div>
            <label for="license-type" class="block text-sm font-medium text-gray-700 mb-1">License Type *</label>
            <input type="text" id="license-type" required placeholder="e.g., General Contractor" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City</label>
            <input type="text" id="city" placeholder="Leave blank for state-level license" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div class="flex items-end pb-2">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="is-city-license" class="w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500">
              <span class="text-sm font-medium text-gray-700">City License</span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="license-number" class="block text-sm font-medium text-gray-700 mb-1">License Number</label>
            <input type="text" id="license-number" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="entity-name" class="block text-sm font-medium text-gray-700 mb-1">Entity Name</label>
            <input type="text" id="entity-name" placeholder="JBS Construction Group" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="issue-date" class="block text-sm font-medium text-gray-700 mb-1">Issue Date</label>
            <input type="date" id="issue-date" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="expiration-date" class="block text-sm font-medium text-gray-700 mb-1">Expiration Date</label>
            <input type="date" id="expiration-date" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
            <select id="status" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="">Auto-calculate</option>
              <option value="active">Active</option>
              <option value="expiring">Expiring Soon</option>
              <option value="expired">Expired</option>
            </select>
          </div>
          <div>
            <label for="renewal-fee" class="block text-sm font-medium text-gray-700 mb-1">Renewal Fee ($)</label>
            <input type="number" id="renewal-fee" step="0.01" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
          <textarea id="notes" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"></textarea>
        </div>

        <div class="flex justify-end space-x-3 pt-4">
          <button type="button" id="cancel-btn" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium">
            Cancel
          </button>
          <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-medium">
            Save License
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { escapeHtml } from '../utils/html';
    import { getApiUrl } from '../utils/api';
    import { toast } from '../utils/toast';

    const API_URL = getApiUrl();
    const token = localStorage.getItem('jbs_token');

    if (!token) {
      window.location.href = '/';
    }

    const modal = document.getElementById('license-modal')!;
    const form = document.getElementById('license-form') as HTMLFormElement;
    const container = document.getElementById('licenses-container')!;
    const loading = document.getElementById('loading')!;

    interface License {
      id: number;
      state: string;
      license_type: string;
      license_number: string | null;
      entity_name: string | null;
      issue_date: string | null;
      expiration_date: string | null;
      status: string;
      renewal_fee: number;
      notes: string | null;
      city: string | null;
      is_city_license: boolean;
      is_active: boolean;
      document_count?: number;
    }

    // State code → full name lookup
    const STATE_NAMES: { [key: string]: string } = {
      'AL': 'Alabama', 'AK': 'Alaska', 'AZ': 'Arizona', 'AR': 'Arkansas',
      'CA': 'California', 'CO': 'Colorado', 'CT': 'Connecticut', 'DE': 'Delaware',
      'FL': 'Florida', 'GA': 'Georgia', 'HI': 'Hawaii', 'ID': 'Idaho',
      'IL': 'Illinois', 'IN': 'Indiana', 'IA': 'Iowa', 'KS': 'Kansas',
      'KY': 'Kentucky', 'LA': 'Louisiana', 'ME': 'Maine', 'MD': 'Maryland',
      'MA': 'Massachusetts', 'MI': 'Michigan', 'MN': 'Minnesota', 'MS': 'Mississippi',
      'MO': 'Missouri', 'MT': 'Montana', 'NE': 'Nebraska', 'NV': 'Nevada',
      'NH': 'New Hampshire', 'NJ': 'New Jersey', 'NM': 'New Mexico', 'NY': 'New York',
      'NC': 'North Carolina', 'ND': 'North Dakota', 'OH': 'Ohio', 'OK': 'Oklahoma',
      'OR': 'Oregon', 'PA': 'Pennsylvania', 'RI': 'Rhode Island', 'SC': 'South Carolina',
      'SD': 'South Dakota', 'TN': 'Tennessee', 'TX': 'Texas', 'UT': 'Utah',
      'VT': 'Vermont', 'VA': 'Virginia', 'WA': 'Washington', 'WV': 'West Virginia',
      'WI': 'Wisconsin', 'WY': 'Wyoming'
    };

    // Track current licenses globally
    let currentLicenses: License[] = [];
    // Track which state panel is open
    let currentPanelState = '';
    let currentPanelStateName = '';

    // Returns worst-case status across a group of licenses
    function getWorstStatus(licenses: License[]): string {
      if (licenses.some(l => l.status === 'expired')) return 'expired';
      if (licenses.some(l => l.status === 'expiring')) return 'expiring';
      if (licenses.some(l => l.status === 'active')) return 'active';
      return 'active';
    }

    function statusBadgeClasses(status: string): string {
      if (status === 'active') return 'bg-green-100 text-green-800';
      if (status === 'expiring') return 'bg-yellow-100 text-yellow-800';
      return 'bg-red-100 text-red-800';
    }

    function formatDate(dateStr: string): string {
      try {
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      } catch {
        return dateStr;
      }
    }

    // Render a single license row for the accordion table
    function renderLicenseRow(license: License): string {
      const sc = statusBadgeClasses(license.status);
      const expiry = license.expiration_date ? formatDate(license.expiration_date) : null;
      return `
        <div class="bg-white rounded-lg border border-gray-200 px-4 py-3 flex items-center justify-between gap-4">
          <div class="flex items-center gap-4 min-w-0 flex-1 flex-wrap">
            <div class="min-w-0">
              <div class="text-sm font-medium text-gray-900">${escapeHtml(license.license_type)}</div>
              ${license.license_number ? `<div class="text-xs text-gray-400 font-mono">${escapeHtml(license.license_number)}</div>` : ''}
            </div>
            ${expiry ? `<span class="text-xs text-gray-500 flex-shrink-0">${license.status === 'expired' ? 'Expired' : 'Expires'}: ${escapeHtml(expiry)}</span>` : ''}
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${sc} flex-shrink-0 capitalize">${escapeHtml(license.status || 'unknown')}</span>
            ${(license.document_count && license.document_count > 0) ? `<span class="inline-flex items-center gap-0.5 text-xs text-gray-400 flex-shrink-0" title="${license.document_count} doc${license.document_count > 1 ? 's' : ''} linked"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>${license.document_count}</span>` : ''}
          </div>
          <div class="flex items-center gap-1 flex-shrink-0">
            <button onclick="window.editLicenseRow(${license.id})" class="text-xs text-primary-600 hover:text-primary-900 font-medium px-2 py-1 rounded hover:bg-primary-50 transition-colors">Edit</button>
            <button onclick="deleteLicense(${license.id})" class="text-xs text-red-500 hover:text-red-700 font-medium px-2 py-1 rounded hover:bg-red-50 transition-colors">Delete</button>
          </div>
        </div>
      `;
    }

    // Render a license card for the state detail panel
    function renderPanelLicenseCard(license: License): string {
      const expiry = license.expiration_date ? formatDate(license.expiration_date) : null;
      const expiryColor = license.status === 'expired' ? 'text-red-600 font-medium' :
                          license.status === 'expiring' ? 'text-yellow-600 font-medium' : 'text-gray-500';
      const docCount = license.document_count || 0;
      const docsBtn = docCount > 0
        ? `<button onclick="window.toggleLicenseDocs(${license.id})" class="inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-800 font-medium mt-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
            ${docCount} document${docCount > 1 ? 's' : ''}
          </button>` : '';
      return `
        <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <span class="font-semibold text-gray-900 text-sm">${escapeHtml(license.license_type)}</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${statusBadgeClasses(license.status)} capitalize">${escapeHtml(license.status || 'unknown')}</span>
              </div>
              ${license.license_number ? `<div class="text-xs text-gray-500 font-mono mb-1"># ${escapeHtml(license.license_number)}</div>` : ''}
              ${license.entity_name ? `<div class="text-xs text-gray-500 mb-1">${escapeHtml(license.entity_name)}</div>` : ''}
              ${expiry ? `<div class="text-xs ${expiryColor}">${license.status === 'expired' ? 'Expired' : 'Expires'}: ${escapeHtml(expiry)}</div>` : ''}
              ${docsBtn}
            </div>
            <div class="flex flex-col gap-1.5 flex-shrink-0">
              <button onclick="window.editLicenseRow(${license.id})" class="text-xs text-primary-600 font-medium px-3 py-1.5 rounded-lg hover:bg-primary-50 border border-primary-200 transition-colors">Edit</button>
              <button onclick="deleteLicense(${license.id})" class="text-xs text-red-500 font-medium px-3 py-1.5 rounded-lg hover:bg-red-50 border border-red-200 transition-colors">Delete</button>
            </div>
          </div>
          ${license.notes ? `<div class="mt-2 pt-2 border-t border-gray-100 text-xs text-gray-400 italic">${escapeHtml(license.notes)}</div>` : ''}
          <div id="license-docs-${license.id}" class="hidden mt-2 pt-2 border-t border-gray-100"></div>
        </div>
      `;
    }

    // Render the grouped accordion table
    function renderGroupedTable(licenses: License[]) {
      if (licenses.length === 0) {
        container.innerHTML = '<div class="text-center py-12 text-gray-500">No licenses yet. Add your first license to get started!</div>';
        return;
      }

      // Group by state
      const byState = new Map<string, License[]>();
      licenses.forEach(l => {
        if (!byState.has(l.state)) byState.set(l.state, []);
        byState.get(l.state)!.push(l);
      });

      const sortedStates = [...byState.keys()].sort();

      const rows = sortedStates.map(stateCode => {
        const stateLicenses = byState.get(stateCode)!;
        const fullName = STATE_NAMES[stateCode] || stateCode;
        const worstStatus = getWorstStatus(stateLicenses);
        const sc = statusBadgeClasses(worstStatus);

        const stateLevelLicenses = stateLicenses.filter(l => !l.is_city_license);
        const cityLicenses = stateLicenses.filter(l => l.is_city_license);
        const cities = [...new Set(cityLicenses.map(l => l.city || 'Unknown'))].sort();

        const stateSectionHtml = stateLevelLicenses.length > 0 ? `
          <div class="mb-4">
            <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">State License</div>
            <div class="space-y-1.5">${stateLevelLicenses.map(renderLicenseRow).join('')}</div>
          </div>
        ` : '';

        const citySectionsHtml = cities.map(city => {
          const cityLics = cityLicenses.filter(l => (l.city || 'Unknown') === city);
          return `
            <div class="mb-4">
              <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                ${escapeHtml(city)}
              </div>
              <div class="space-y-1.5">${cityLics.map(renderLicenseRow).join('')}</div>
            </div>
          `;
        }).join('');

        const cityCountLabel = cities.length > 0
          ? `<span class="text-xs text-blue-500">${cities.length} cit${cities.length !== 1 ? 'ies' : 'y'}</span>`
          : '';

        return `
          <div class="border-b border-gray-100 last:border-b-0">
            <div class="flex items-center justify-between px-6 py-4 cursor-pointer hover:bg-gray-50 select-none" onclick="window.toggleStateGroup('${escapeHtml(stateCode)}')">
              <div class="flex items-center gap-3 min-w-0 flex-wrap">
                <svg id="chevron-${escapeHtml(stateCode)}" class="w-4 h-4 text-gray-400 flex-shrink-0 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <span class="font-semibold text-gray-900 text-sm">${escapeHtml(fullName)}</span>
                <span class="text-xs text-gray-400 font-mono">${escapeHtml(stateCode)}</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">${stateLicenses.length} license${stateLicenses.length !== 1 ? 's' : ''}</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${sc} capitalize">${escapeHtml(worstStatus)}</span>
                ${cityCountLabel}
              </div>
              <button
                class="flex-shrink-0 ml-4 inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg text-primary-700 bg-primary-50 hover:bg-primary-100 border border-primary-200 transition-colors"
                onclick="event.stopPropagation(); window.openAddLicenseForState('${escapeHtml(stateCode)}', '${escapeHtml(fullName)}')"
              >
                + Add
              </button>
            </div>
            <div id="group-${escapeHtml(stateCode)}" class="hidden bg-gray-50 border-t border-gray-100 px-8 py-4">
              ${stateSectionHtml}${citySectionsHtml}
            </div>
          </div>
        `;
      }).join('');

      container.innerHTML = `
        <div class="px-6 py-3 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
          <h3 class="text-sm font-medium text-gray-700">${licenses.length} license${licenses.length !== 1 ? 's' : ''} across ${byState.size} state${byState.size !== 1 ? 's' : ''}</h3>
          <p class="text-xs text-gray-400">Click a state row to expand</p>
        </div>
        <div class="divide-y divide-gray-100">${rows}</div>
      `;
    }

    // Load licenses
    async function loadLicenses() {
      try {
        const response = await fetch(`${API_URL}/licenses`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (!response.ok) throw new Error('Failed to load licenses');

        const licenses: License[] = await response.json();
        currentLicenses = licenses;
        loading.classList.add('hidden');

        renderGroupedTable(licenses);
        updateStats(licenses);
        renderUSMap(licenses);

        // Refresh the panel if it's currently open
        if (currentPanelState) {
          updatePanelContent(currentPanelState, licenses.filter(l => l.state === currentPanelState));
        }

      } catch (error: any) {
        loading.classList.add('hidden');
        container.innerHTML = '<div class="text-center py-12 text-red-500">Failed to load licenses</div>';
        renderUSMap([]);
      }
    }

    function updateStats(licenses: License[]) {
      const total = licenses.length;
      const statesWithLicenses = new Set(licenses.map(l => l.state)).size;
      const active = licenses.filter(l => l.status === 'active').length;
      const expiring = licenses.filter(l => l.status === 'expiring').length;
      const expired = licenses.filter(l => l.status === 'expired').length;

      document.getElementById('total-licenses')!.textContent = String(total);
      document.getElementById('total-licenses-sub')!.textContent =
        `${statesWithLicenses} state${statesWithLicenses !== 1 ? 's' : ''} licensed`;
      document.getElementById('active-count')!.textContent = String(active);
      document.getElementById('expiring-count')!.textContent = String(expiring);
      document.getElementById('expired-count')!.textContent = String(expired);
    }

    function renderUSMap(licenses: License[]) {
      if (typeof (window as any).renderCleanMap === 'function') {
        (window as any).renderCleanMap(licenses);
      }
    }

    // ─── State Detail Panel ────────────────────────────────────────────

    function updatePanelContent(stateCode: string, stateLicenses: License[]) {
      const metaEl = document.getElementById('panel-license-meta')!;
      const listEl = document.getElementById('panel-license-list')!;
      const count = stateLicenses.length;

      metaEl.textContent = count === 0
        ? 'No licenses yet'
        : `${count} license${count !== 1 ? 's' : ''}`;

      if (count === 0) {
        listEl.innerHTML = `
          <div class="text-center text-gray-400 py-12">
            <svg class="mx-auto h-10 w-10 mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <p class="text-sm">No licenses for this state yet</p>
            <p class="text-xs text-gray-400 mt-1">Click "Add License" above to get started</p>
          </div>
        `;
        return;
      }

      const stateLevelLicenses = stateLicenses.filter(l => !l.is_city_license);
      const cityLicenses = stateLicenses.filter(l => l.is_city_license);
      const cities = [...new Set(cityLicenses.map(l => l.city || 'Unknown'))].sort();

      let html = '';

      if (stateLevelLicenses.length > 0) {
        html += `
          <div class="mb-5">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">State License</h3>
            <div class="space-y-3">${stateLevelLicenses.map(renderPanelLicenseCard).join('')}</div>
          </div>
        `;
      }

      cities.forEach(city => {
        const cityLics = cityLicenses.filter(l => (l.city || 'Unknown') === city);
        html += `
          <div class="mb-5">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              ${escapeHtml(city)}
            </h3>
            <div class="space-y-3">${cityLics.map(renderPanelLicenseCard).join('')}</div>
          </div>
        `;
      });

      listEl.innerHTML = html;
    }

    function openPanelState() {
      const panel = document.getElementById('state-panel')!;
      const overlay = document.getElementById('state-panel-overlay')!;
      panel.style.transform = 'translateX(0)';
      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closePanelState() {
      const panel = document.getElementById('state-panel')!;
      const overlay = document.getElementById('state-panel-overlay')!;
      panel.style.transform = 'translateX(100%)';
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
    }

    document.getElementById('close-state-panel')!.addEventListener('click', closePanelState);
    document.getElementById('state-panel-overlay')!.addEventListener('click', closePanelState);

    document.getElementById('panel-add-btn')!.addEventListener('click', () => {
      closePanelState();
      (window as any).openAddLicenseForState(currentPanelState, currentPanelStateName);
    });

    // ─── Global functions called from map + table ───────────────────────

    // Open state panel — called by map tile click
    (window as any).openStatePanel = function(stateCode: string, stateName: string) {
      currentPanelState = stateCode;
      currentPanelStateName = stateName;
      document.getElementById('panel-state-name')!.textContent = stateName;
      updatePanelContent(stateCode, currentLicenses.filter(l => l.state === stateCode));
      openPanelState();
    };

    // Backward-compat: old map click used window.editLicense → now opens panel
    (window as any).editLicense = function(stateCode: string, stateName: string) {
      (window as any).openStatePanel(stateCode, stateName);
    };

    // Toggle accordion row open/closed
    (window as any).toggleStateGroup = function(stateCode: string) {
      const group = document.getElementById(`group-${stateCode}`);
      const chevron = document.getElementById(`chevron-${stateCode}`);
      if (!group) return;
      const isOpen = !group.classList.contains('hidden');
      group.classList.toggle('hidden', isOpen);
      if (chevron) chevron.style.transform = isOpen ? '' : 'rotate(90deg)';
    };

    // Open add modal pre-filled with state (called from accordion "+ Add" and panel button)
    (window as any).openAddLicenseForState = function(stateCode: string, stateName: string) {
      form.reset();
      (document.getElementById('license-id') as HTMLInputElement).value = '';
      (document.getElementById('state') as HTMLSelectElement).value = stateCode;
      (document.getElementById('is-city-license') as HTMLInputElement).checked = false;
      document.getElementById('modal-title')!.textContent = `Add License — ${stateName}`;
      modal.classList.remove('hidden');
    };

    // Edit a specific license by id (called from row Edit buttons everywhere)
    (window as any).editLicenseRow = function(licenseId: number) {
      const license = currentLicenses.find(l => l.id === licenseId);
      if (!license) return;
      editLicense(license);
    };

    function editLicense(license: License) {
      (document.getElementById('license-id') as HTMLInputElement).value = String(license.id);
      (document.getElementById('state') as HTMLSelectElement).value = license.state;
      (document.getElementById('license-type') as HTMLInputElement).value = license.license_type;
      (document.getElementById('license-number') as HTMLInputElement).value = license.license_number || '';
      (document.getElementById('entity-name') as HTMLInputElement).value = license.entity_name || '';
      (document.getElementById('issue-date') as HTMLInputElement).value = license.issue_date || '';
      (document.getElementById('expiration-date') as HTMLInputElement).value = license.expiration_date || '';
      (document.getElementById('status') as HTMLSelectElement).value = license.status;
      (document.getElementById('renewal-fee') as HTMLInputElement).value = String(license.renewal_fee || 0);
      (document.getElementById('notes') as HTMLTextAreaElement).value = license.notes || '';
      (document.getElementById('city') as HTMLInputElement).value = license.city || '';
      (document.getElementById('is-city-license') as HTMLInputElement).checked = license.is_city_license || false;
      const fullName = STATE_NAMES[license.state] || license.state;
      document.getElementById('modal-title')!.textContent = `Edit License — ${fullName}`;
      modal.classList.remove('hidden');
    }

    // Open modal for blank new license
    document.getElementById('add-license-btn')!.addEventListener('click', () => {
      form.reset();
      (document.getElementById('license-id') as HTMLInputElement).value = '';
      (document.getElementById('is-city-license') as HTMLInputElement).checked = false;
      document.getElementById('modal-title')!.textContent = 'Add License';
      modal.classList.remove('hidden');
    });

    // Close modal
    document.getElementById('close-modal')!.addEventListener('click', () => modal.classList.add('hidden'));
    document.getElementById('cancel-btn')!.addEventListener('click', () => modal.classList.add('hidden'));

    // Submit form
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = {
        state: (document.getElementById('state') as HTMLInputElement).value,
        license_type: (document.getElementById('license-type') as HTMLInputElement).value,
        license_number: (document.getElementById('license-number') as HTMLInputElement).value,
        entity_name: (document.getElementById('entity-name') as HTMLInputElement).value,
        issue_date: (document.getElementById('issue-date') as HTMLInputElement).value,
        expiration_date: (document.getElementById('expiration-date') as HTMLInputElement).value,
        status: (document.getElementById('status') as HTMLSelectElement).value,
        renewal_fee: parseFloat((document.getElementById('renewal-fee') as HTMLInputElement).value) || 0,
        notes: (document.getElementById('notes') as HTMLTextAreaElement).value,
        city: (document.getElementById('city') as HTMLInputElement).value,
        is_city_license: (document.getElementById('is-city-license') as HTMLInputElement).checked,
        is_active: true
      };

      const licenseId = (document.getElementById('license-id') as HTMLInputElement).value;
      const isEdit = licenseId !== '';

      try {
        const url = isEdit ? `${API_URL}/licenses/${licenseId}` : `${API_URL}/licenses`;
        const method = isEdit ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(data)
        });

        if (!response.ok) throw new Error('Failed to save license');

        modal.classList.add('hidden');
        loadLicenses();
      } catch (error: any) {
        toast.error('Failed to save license: ' + error.message);
      }
    });

    // Delete license
    (window as any).deleteLicense = async (id: number) => {
      if (!confirm('Are you sure you want to delete this license?')) return;

      try {
        const response = await fetch(`${API_URL}/licenses/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (!response.ok) throw new Error('Failed to delete');

        loadLicenses();
      } catch (error) {
        toast.error('Failed to delete license');
      }
    };

    // Initial load
    loadLicenses();

    // Render empty map immediately while data loads
    if (typeof (window as any).renderCleanMap === 'function') {
      (window as any).renderCleanMap([]);
    }

    // ═══════════════════════════════════════════════════════════
    // SharePoint Document Browser
    // ═══════════════════════════════════════════════════════════

    const spConnectBtn = document.getElementById('sp-connect-btn')!;
    const spDisconnectBtn = document.getElementById('sp-disconnect-btn')!;
    const spStatusBadge = document.getElementById('sp-status-badge')!;
    const spBreadcrumb = document.getElementById('sp-breadcrumb')!;
    const spBrowser = document.getElementById('sp-browser')!;
    const spLoading = document.getElementById('sp-loading')!;
    const spItems = document.getElementById('sp-items')!;
    const spEmpty = document.getElementById('sp-empty')!;
    const spNotConnected = document.getElementById('sp-not-connected')!;
    const spNotConfigured = document.getElementById('sp-not-configured')!;
    const spCrumbTrail = document.getElementById('sp-crumb-trail')!;

    let spCurrentPath = '';

    // Handle ?sp= query param after OAuth redirect
    const urlParams = new URLSearchParams(window.location.search);
    const spParam = urlParams.get('sp');
    if (spParam) {
      // Clean up URL
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, '', cleanUrl);
      if (spParam === 'error') {
        toast.error('SharePoint connection failed. Please try again.');
      }
    }

    // Check SharePoint status on load
    async function checkSharePointStatus() {
      try {
        const res = await fetch(`${API_URL}/sharepoint/status`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) {
          // User may not have permission — hide section
          return;
        }
        const data = await res.json();

        if (!data.configured) {
          spStatusBadge.textContent = 'Not Configured';
          spStatusBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700';
          spNotConfigured.classList.remove('hidden');
          return;
        }

        if (data.connected) {
          showConnectedState();
          browseSP('');
        } else {
          showDisconnectedState();
        }
      } catch {
        // Silently fail — sharepoint is optional
      }
    }

    function showConnectedState() {
      spStatusBadge.textContent = 'Connected';
      spStatusBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700';
      spConnectBtn.classList.add('hidden');
      spDisconnectBtn.classList.remove('hidden');
      spBreadcrumb.classList.remove('hidden');
      spBrowser.classList.remove('hidden');
      spNotConnected.classList.add('hidden');
      spNotConfigured.classList.add('hidden');
      // Show auto-discover section when SharePoint is connected
      scanSection.classList.remove('hidden');
      loadScanStates();
    }

    function showDisconnectedState() {
      spStatusBadge.textContent = 'Not Connected';
      spStatusBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600';
      spConnectBtn.classList.remove('hidden');
      spDisconnectBtn.classList.add('hidden');
      spBreadcrumb.classList.add('hidden');
      spBrowser.classList.add('hidden');
      spNotConnected.classList.remove('hidden');
      spNotConfigured.classList.add('hidden');
      spItems.innerHTML = '';
      // Hide auto-discover when not connected
      scanSection.classList.add('hidden');
    }

    // Connect button → start OAuth
    spConnectBtn.addEventListener('click', async () => {
      try {
        const res = await fetch(`${API_URL}/sharepoint/auth`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) throw new Error('Failed to start auth');
        const data = await res.json();
        window.location.href = data.auth_url;
      } catch {
        toast.error('Failed to start SharePoint connection');
      }
    });

    // Disconnect button
    spDisconnectBtn.addEventListener('click', async () => {
      if (!confirm('Disconnect from SharePoint?')) return;
      try {
        await fetch(`${API_URL}/sharepoint/disconnect`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch { /* ignore */ }
      showDisconnectedState();
    });

    // Browse a SharePoint folder
    async function browseSP(path: string) {
      spCurrentPath = path;
      spLoading.classList.remove('hidden');
      spItems.innerHTML = '';
      spEmpty.classList.add('hidden');
      updateBreadcrumb(path);

      try {
        const res = await fetch(`${API_URL}/sharepoint/browse?path=${encodeURIComponent(path)}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (res.status === 401) {
          showDisconnectedState();
          return;
        }

        if (!res.ok) throw new Error('Browse failed');

        const data = await res.json();
        spLoading.classList.add('hidden');

        if (!data.items || data.items.length === 0) {
          spEmpty.classList.remove('hidden');
          return;
        }

        renderItems(data.items);
      } catch (err) {
        spLoading.classList.add('hidden');
        spItems.innerHTML = '<div class="px-6 py-4 text-sm text-red-500">Failed to load folder contents</div>';
      }
    }

    // Update breadcrumb navigation
    function updateBreadcrumb(path: string) {
      if (!path) {
        spCrumbTrail.innerHTML = '';
        return;
      }

      const parts = path.split('/');
      let html = '';
      let buildPath = '';
      for (const part of parts) {
        buildPath = buildPath ? buildPath + '/' + part : part;
        html += `
          <svg class="w-4 h-4 mx-1 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
          <button class="sp-crumb hover:text-blue-600" data-path="${escapeHtml(buildPath)}">${escapeHtml(part)}</button>
        `;
      }
      spCrumbTrail.innerHTML = html;
    }

    // Breadcrumb click delegation
    spBreadcrumb.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.sp-crumb') as HTMLElement | null;
      if (btn) {
        browseSP(btn.dataset.path || '');
      }
    });

    interface SPItem {
      id: string;
      name: string;
      size: number;
      web_url: string;
      is_folder: boolean;
      mime_type?: string;
      child_count?: number;
      modified_at: string;
      modified_by?: string;
    }

    function renderItems(items: SPItem[]) {
      // Sort: folders first, then files, alphabetical
      const sorted = [...items].sort((a, b) => {
        if (a.is_folder !== b.is_folder) return a.is_folder ? -1 : 1;
        return a.name.localeCompare(b.name);
      });

      spItems.innerHTML = sorted.map(item => {
        const modDate = item.modified_at ? new Date(item.modified_at).toLocaleDateString() : '';
        const sizeStr = item.is_folder ? `${item.child_count || 0} items` : formatFileSize(item.size);

        if (item.is_folder) {
          return `
            <button class="sp-folder-btn w-full flex items-center px-6 py-3 hover:bg-blue-50 transition-colors text-left group"
                    data-path="${escapeHtml(spCurrentPath ? spCurrentPath + '/' + item.name : item.name)}">
              <svg class="w-5 h-5 text-blue-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/>
              </svg>
              <div class="flex-1 min-w-0">
                <span class="text-sm font-medium text-gray-900 group-hover:text-blue-700">${escapeHtml(item.name)}</span>
              </div>
              <span class="text-xs text-gray-400 mr-4">${sizeStr}</span>
              <span class="text-xs text-gray-400 mr-4">${modDate}</span>
              <svg class="w-4 h-4 text-gray-300 group-hover:text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          `;
        } else {
          const icon = getFileIcon(item.name, item.mime_type);
          return `
            <div class="flex items-center px-6 py-3 hover:bg-gray-50 transition-colors group">
              ${icon}
              <div class="flex-1 min-w-0">
                <span class="text-sm text-gray-700">${escapeHtml(item.name)}</span>
              </div>
              <span class="text-xs text-gray-400 mr-4">${sizeStr}</span>
              <span class="text-xs text-gray-400 mr-4">${modDate}</span>
              <a href="${escapeHtml(item.web_url)}" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition-colors opacity-0 group-hover:opacity-100">
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                Open
              </a>
              <button class="sp-link-btn inline-flex items-center px-2.5 py-1 text-xs font-medium rounded text-green-700 bg-green-50 hover:bg-green-100 border border-green-200 transition-colors opacity-0 group-hover:opacity-100 ml-1"
                      data-name="${escapeHtml(item.name)}" data-url="${escapeHtml(item.web_url)}" data-id="${escapeHtml(item.id)}">
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                </svg>
                Link
              </button>
            </div>
          `;
        }
      }).join('');
    }

    // Folder click delegation
    spItems.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.sp-folder-btn') as HTMLElement | null;
      if (btn) {
        browseSP(btn.dataset.path || '');
        return;
      }
      // Link button delegation
      const linkBtn = (e.target as HTMLElement).closest('.sp-link-btn') as HTMLElement | null;
      if (linkBtn) {
        const fileName = linkBtn.dataset.name || '';
        const fileUrl = linkBtn.dataset.url || '';
        const itemId = linkBtn.dataset.id || '';
        showLinkDocumentPopover(fileName, fileUrl, itemId, linkBtn);
      }
    });

    function formatFileSize(bytes: number): string {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function getFileIcon(name: string, mimeType?: string): string {
      const ext = name.split('.').pop()?.toLowerCase() || '';
      const iconClass = 'w-5 h-5 mr-3 flex-shrink-0';

      // PDF
      if (ext === 'pdf') {
        return `<svg class="${iconClass} text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>`;
      }
      // Images
      if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'svg'].includes(ext)) {
        return `<svg class="${iconClass} text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/></svg>`;
      }
      // Word docs
      if (['doc', 'docx'].includes(ext)) {
        return `<svg class="${iconClass} text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>`;
      }
      // Excel
      if (['xls', 'xlsx', 'csv'].includes(ext)) {
        return `<svg class="${iconClass} text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>`;
      }
      // Default
      return `<svg class="${iconClass} text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>`;
    }

    // ═══════════════════════════════════════════════════════════
    // Auto-Discover from SharePoint
    // ═══════════════════════════════════════════════════════════

    const scanSection = document.getElementById('scan-section')!;
    const scanStateSelect = document.getElementById('scan-state-select') as HTMLSelectElement;
    const scanBtn = document.getElementById('scan-btn')!;
    const scanLoading = document.getElementById('scan-loading')!;
    const scanResults = document.getElementById('scan-results')!;
    const scanSummary = document.getElementById('scan-summary')!;
    const scanSuggestions = document.getElementById('scan-suggestions')!;
    const scanTrackedSection = document.getElementById('scan-tracked-section')!;
    const scanTrackedToggle = document.getElementById('scan-tracked-toggle')!;
    const scanTrackedChevron = document.getElementById('scan-tracked-chevron')!;
    const scanTrackedLabel = document.getElementById('scan-tracked-label')!;
    const scanTrackedList = document.getElementById('scan-tracked-list')!;
    const scanSkippedSection = document.getElementById('scan-skipped-section')!;
    const scanSkippedToggle = document.getElementById('scan-skipped-toggle')!;
    const scanSkippedChevron = document.getElementById('scan-skipped-chevron')!;
    const scanSkippedLabel = document.getElementById('scan-skipped-label')!;
    const scanSkippedList = document.getElementById('scan-skipped-list')!;
    const scanSelectAllBtn = document.getElementById('scan-select-all')!;
    const scanApproveBtn = document.getElementById('scan-approve-btn')!;
    const scanSelectedCount = document.getElementById('scan-selected-count')!;

    interface ScanSuggestion {
      state: string;
      state_name: string;
      city: string;
      folder_path: string;
      web_url: string;
      is_city_license: boolean;
    }

    let scanStates: { name: string; web_url: string }[] = [];
    let currentSuggestions: ScanSuggestion[] = [];

    async function loadScanStates() {
      try {
        const res = await fetch(`${API_URL}/licenses/scan/states`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) return;
        scanStates = await res.json();
        scanStateSelect.innerHTML = '<option value="">Select a state to scan...</option>';
        for (const s of scanStates) {
          const opt = document.createElement('option');
          opt.value = s.name;
          opt.textContent = s.name;
          scanStateSelect.appendChild(opt);
        }
      } catch {
        // Silently fail
      }
    }

    scanBtn.addEventListener('click', async () => {
      const folderName = scanStateSelect.value;
      if (!folderName) {
        toast.warning('Please select a state to scan');
        return;
      }

      const stateInfo = scanStates.find(s => s.name === folderName);
      scanBtn.setAttribute('disabled', '');
      scanResults.classList.add('hidden');
      scanLoading.classList.remove('hidden');

      try {
        const res = await fetch(`${API_URL}/licenses/scan`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ folder_name: folderName, web_url: stateInfo?.web_url || '' })
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error || 'Scan failed');
        }

        const data = await res.json();
        currentSuggestions = data.suggestions || [];
        const tracked = data.already_tracked || [];
        const skipped = data.skipped_folders || [];

        // Summary
        const parts = [];
        if (currentSuggestions.length > 0) parts.push(`<span class="font-semibold text-blue-700">${currentSuggestions.length} new</span>`);
        if (tracked.length > 0) parts.push(`<span class="text-gray-500">${tracked.length} already tracked</span>`);
        scanSummary.innerHTML = parts.join(', ') || 'No folders found';

        // Render new suggestions
        scanSuggestions.innerHTML = '';
        for (let i = 0; i < currentSuggestions.length; i++) {
          const s = currentSuggestions[i];
          const label = s.is_city_license ? s.city : 'State License';
          const badge = s.is_city_license
            ? '<span class="text-xs px-1.5 py-0.5 rounded bg-blue-100 text-blue-700">City</span>'
            : '<span class="text-xs px-1.5 py-0.5 rounded bg-purple-100 text-purple-700">State</span>';

          scanSuggestions.innerHTML += `
            <div class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 border border-gray-100">
              <input type="checkbox" class="scan-cb rounded border-gray-300 text-blue-600 focus:ring-blue-500" data-idx="${i}" checked>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-bold bg-gray-100 text-gray-700">${escapeHtml(s.state)}</span>
              ${badge}
              <span class="text-sm font-medium text-gray-800 flex-1">${escapeHtml(label)}</span>
              <input type="text" class="scan-type-input text-xs border border-gray-200 rounded px-2 py-1 w-40" data-idx="${i}" value="General Contractor" placeholder="License type">
              <input type="text" class="scan-entity-input text-xs border border-gray-200 rounded px-2 py-1 w-44" data-idx="${i}" value="JBS Construction Group" placeholder="Entity name">
            </div>
          `;
        }

        // Already tracked
        if (tracked.length > 0) {
          scanTrackedSection.classList.remove('hidden');
          scanTrackedLabel.textContent = `Already tracked (${tracked.length})`;
          scanTrackedList.innerHTML = tracked.map((t: ScanSuggestion) => {
            const label = t.is_city_license ? t.city : 'State License';
            return `<div class="flex items-center gap-2 text-xs text-gray-400 py-0.5">
              <span class="font-mono">${escapeHtml(t.state)}</span>
              <span>${escapeHtml(label)}</span>
              <svg class="w-3.5 h-3.5 text-green-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>`;
          }).join('');
        } else {
          scanTrackedSection.classList.add('hidden');
        }

        // Skipped folders
        if (skipped.length > 0) {
          scanSkippedSection.classList.remove('hidden');
          scanSkippedLabel.textContent = `Skipped folders (${skipped.length})`;
          scanSkippedList.innerHTML = skipped.map((name: string) =>
            `<span class="inline-block mr-2 text-gray-400">${escapeHtml(name)}</span>`
          ).join('');
        } else {
          scanSkippedSection.classList.add('hidden');
        }

        updateScanSelection();
        scanResults.classList.remove('hidden');
      } catch (err: any) {
        toast.error(err.message || 'Failed to scan SharePoint');
      } finally {
        scanLoading.classList.add('hidden');
        scanBtn.removeAttribute('disabled');
      }
    });

    // Toggle tracked list
    scanTrackedToggle.addEventListener('click', () => {
      scanTrackedList.classList.toggle('hidden');
      scanTrackedChevron.style.transform = scanTrackedList.classList.contains('hidden') ? '' : 'rotate(90deg)';
    });

    // Toggle skipped list
    scanSkippedToggle.addEventListener('click', () => {
      scanSkippedList.classList.toggle('hidden');
      scanSkippedChevron.style.transform = scanSkippedList.classList.contains('hidden') ? '' : 'rotate(90deg)';
    });

    // Select all
    scanSelectAllBtn.addEventListener('click', () => {
      const cbs = scanSuggestions.querySelectorAll<HTMLInputElement>('.scan-cb');
      const allChecked = Array.from(cbs).every(cb => cb.checked);
      cbs.forEach(cb => cb.checked = !allChecked);
      scanSelectAllBtn.textContent = allChecked ? 'Select All' : 'Deselect All';
      updateScanSelection();
    });

    // Update selection count on checkbox change
    scanSuggestions.addEventListener('change', (e) => {
      if ((e.target as HTMLElement).classList.contains('scan-cb')) {
        updateScanSelection();
      }
    });

    function updateScanSelection() {
      const cbs = scanSuggestions.querySelectorAll<HTMLInputElement>('.scan-cb:checked');
      const count = cbs.length;
      scanSelectedCount.textContent = String(count);
      if (count === 0) {
        scanApproveBtn.setAttribute('disabled', '');
      } else {
        scanApproveBtn.removeAttribute('disabled');
      }
    }

    // Approve selected suggestions
    scanApproveBtn.addEventListener('click', async () => {
      const cbs = scanSuggestions.querySelectorAll<HTMLInputElement>('.scan-cb:checked');
      if (cbs.length === 0) return;

      const toApprove = Array.from(cbs).map(cb => {
        const idx = parseInt(cb.dataset.idx || '0');
        const s = currentSuggestions[idx];
        const typeInput = scanSuggestions.querySelector<HTMLInputElement>(`.scan-type-input[data-idx="${idx}"]`);
        const entityInput = scanSuggestions.querySelector<HTMLInputElement>(`.scan-entity-input[data-idx="${idx}"]`);
        return {
          state: s.state,
          city: s.city,
          is_city_license: s.is_city_license,
          folder_path: s.folder_path,
          license_type: typeInput?.value || 'General Contractor',
          entity_name: entityInput?.value || 'JBS Construction Group',
        };
      });

      scanApproveBtn.setAttribute('disabled', '');
      try {
        const res = await fetch(`${API_URL}/licenses/approve-suggestions`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ suggestions: toApprove })
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error || 'Failed to approve');
        }

        const data = await res.json();
        toast.success(`Created ${data.created} license${data.created !== 1 ? 's' : ''}`);
        scanResults.classList.add('hidden');
        currentSuggestions = [];
        loadLicenses();
      } catch (err: any) {
        toast.error(err.message || 'Failed to approve suggestions');
        scanApproveBtn.removeAttribute('disabled');
      }
    });

    // ═══════════════════════════════════════════════════════════
    // Document Linking
    // ═══════════════════════════════════════════════════════════

    // Infer state code from current SharePoint browsing path
    function inferStateFromPath(): { code: string; name: string } | null {
      if (!spCurrentPath) return null;
      const match = spCurrentPath.match(/^([^/]+?)\s*\(([A-Z]{2})\)/);
      if (!match) return null;
      return { name: match[1].trim(), code: match[2] };
    }

    // Infer document type from filename/path
    function inferDocType(fileName: string): string {
      const lower = fileName.toLowerCase();
      if (lower.includes('application') || spCurrentPath.includes('.Application')) return 'application';
      if (lower.includes('renewal') || spCurrentPath.includes('.Renewal')) return 'renewal';
      if (lower.includes('bond')) return 'bond';
      if (lower.includes('coi') || lower.includes('insurance')) return 'coi';
      if (lower.includes('license') || lower.includes('certificate')) return 'certificate';
      return 'other';
    }

    const DOC_TYPES = ['application', 'bond', 'certificate', 'coi', 'renewal', 'license_copy', 'other'];

    // Show a popover to select which license to link a file to
    function showLinkDocumentPopover(fileName: string, fileUrl: string, itemId: string, anchorEl: HTMLElement) {
      // Remove any existing popover
      document.getElementById('link-doc-popover')?.remove();

      const stateInfo = inferStateFromPath();
      const inferredType = inferDocType(fileName);

      // Filter licenses to the current state being browsed
      const filteredLicenses = stateInfo
        ? currentLicenses.filter(l => l.state === stateInfo.code)
        : currentLicenses;

      if (filteredLicenses.length === 0) {
        toast.warning('No licenses found for this state. Create a license first or use Auto-Discover.');
        return;
      }

      const popover = document.createElement('div');
      popover.id = 'link-doc-popover';
      popover.className = 'fixed z-50 bg-white rounded-lg shadow-xl border border-gray-200 p-4 w-80';
      popover.style.top = `${anchorEl.getBoundingClientRect().bottom + 4}px`;
      popover.style.right = `${window.innerWidth - anchorEl.getBoundingClientRect().right}px`;

      popover.innerHTML = `
        <div class="text-xs text-gray-500 mb-2">Link <strong>${escapeHtml(fileName)}</strong> to:</div>
        <select id="link-license-select" class="w-full text-sm border border-gray-300 rounded-md px-2 py-1.5 mb-2 focus:ring-blue-500 focus:border-blue-500">
          ${filteredLicenses.map(l => {
            const label = l.is_city_license ? `${l.city} (City)` : 'State License';
            return `<option value="${l.id}">${escapeHtml(l.state)} — ${escapeHtml(label)} — ${escapeHtml(l.license_type)}</option>`;
          }).join('')}
        </select>
        <select id="link-doc-type" class="w-full text-sm border border-gray-300 rounded-md px-2 py-1.5 mb-3 focus:ring-blue-500 focus:border-blue-500">
          ${DOC_TYPES.map(t => `<option value="${t}" ${t === inferredType ? 'selected' : ''}>${t.charAt(0).toUpperCase() + t.slice(1).replace('_', ' ')}</option>`).join('')}
        </select>
        <div class="flex justify-end gap-2">
          <button id="link-cancel" class="px-3 py-1.5 text-xs text-gray-600 hover:text-gray-800 rounded-md hover:bg-gray-100">Cancel</button>
          <button id="link-confirm" class="px-3 py-1.5 text-xs text-white bg-green-600 hover:bg-green-700 rounded-md font-medium">Link Document</button>
        </div>
      `;

      document.body.appendChild(popover);

      // Close on cancel or outside click
      const close = () => popover.remove();
      popover.querySelector('#link-cancel')!.addEventListener('click', close);

      popover.querySelector('#link-confirm')!.addEventListener('click', async () => {
        const licenseId = (popover.querySelector('#link-license-select') as HTMLSelectElement).value;
        const docType = (popover.querySelector('#link-doc-type') as HTMLSelectElement).value;

        try {
          const res = await fetch(`${API_URL}/licenses/${licenseId}/documents`, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              document_name: fileName,
              document_url: fileUrl,
              document_type: docType,
              sharepoint_item_id: itemId,
              folder_path: spCurrentPath,
            })
          });
          if (!res.ok) throw new Error('Failed to link document');
          toast.success('Document linked');
          close();
          loadLicenses(); // Refresh to update doc counts
        } catch (err: any) {
          toast.error(err.message || 'Failed to link document');
        }
      });

      // Close on outside click
      setTimeout(() => {
        document.addEventListener('click', function handler(e) {
          if (!popover.contains(e.target as Node) && e.target !== anchorEl && !anchorEl.contains(e.target as Node)) {
            close();
            document.removeEventListener('click', handler);
          }
        });
      }, 10);
    }

    // Toggle document list in the state panel for a license
    (window as any).toggleLicenseDocs = async function(licenseId: number) {
      const container = document.getElementById(`license-docs-${licenseId}`);
      if (!container) return;

      if (!container.classList.contains('hidden')) {
        container.classList.add('hidden');
        return;
      }

      container.innerHTML = '<div class="text-xs text-gray-400 py-1">Loading...</div>';
      container.classList.remove('hidden');

      try {
        const res = await fetch(`${API_URL}/licenses/${licenseId}/documents`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) throw new Error('Failed to load documents');
        const docs = await res.json();

        if (docs.length === 0) {
          container.innerHTML = '<div class="text-xs text-gray-400 py-1">No documents linked</div>';
          return;
        }

        container.innerHTML = docs.map((doc: any) => `
          <div class="flex items-center gap-2 py-1.5 group/doc">
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-gray-100 text-gray-600 capitalize">${escapeHtml(doc.document_type || 'other')}</span>
            <a href="${escapeHtml(doc.document_url)}" target="_blank" rel="noopener noreferrer"
               class="text-xs text-blue-600 hover:text-blue-800 hover:underline truncate flex-1" title="${escapeHtml(doc.document_name)}">
              ${escapeHtml(doc.document_name)}
            </a>
            <button onclick="window.unlinkDocument(${licenseId}, ${doc.id})"
                    class="text-xs text-red-400 hover:text-red-600 opacity-0 group-hover/doc:opacity-100 transition-opacity flex-shrink-0"
                    title="Unlink document">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
        `).join('');
      } catch {
        container.innerHTML = '<div class="text-xs text-red-400 py-1">Failed to load documents</div>';
      }
    };

    // Unlink a document from a license
    (window as any).unlinkDocument = async function(licenseId: number, docId: number) {
      if (!confirm('Remove this document link?')) return;
      try {
        const res = await fetch(`${API_URL}/licenses/${licenseId}/documents/${docId}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) throw new Error('Failed to unlink');
        toast.success('Document unlinked');
        // Refresh the doc list for this license
        (window as any).toggleLicenseDocs(licenseId);
        (window as any).toggleLicenseDocs(licenseId);
        loadLicenses(); // Refresh doc counts
      } catch (err: any) {
        toast.error(err.message || 'Failed to unlink document');
      }
    };

    // Check status on page load
    checkSharePointStatus();
  </script>
</Layout>
