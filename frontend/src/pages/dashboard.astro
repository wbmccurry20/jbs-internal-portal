---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="space-y-6">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Dashboard</h1>
        <p class="mt-1 text-sm text-gray-500">Welcome to JBS Internal Portal</p>
      </div>
      <a href="/change-password" class="text-sm text-primary-600 hover:text-primary-700 font-medium">
        Change Password
      </a>
    </div>
    
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Jobs -->
      <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-10 w-10 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dt class="text-sm font-medium text-gray-500 truncate">Active Jobs</dt>
              <dd class="flex items-baseline">
                <div class="text-3xl font-semibold text-gray-900" id="active-jobs">-</div>
                <div class="ml-2 text-sm text-gray-500" id="total-jobs"></div>
              </dd>
            </div>
          </div>
          <div class="mt-4">
            <a href="/jobs" class="text-sm font-medium text-primary-600 hover:text-primary-700">View all jobs →</a>
          </div>
        </div>
      </div>

      <!-- Bids -->
      <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-10 w-10 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dt class="text-sm font-medium text-gray-500 truncate">Pipeline Value</dt>
              <dd class="flex items-baseline">
                <div class="text-3xl font-semibold text-gray-900" id="pipeline-value">-</div>
              </dd>
            </div>
          </div>
          <div class="mt-4">
            <div class="text-sm text-gray-600" id="bid-breakdown"></div>
            <a href="/bids" class="text-sm font-medium text-primary-600 hover:text-primary-700">View pipeline →</a>
          </div>
        </div>
      </div>

      <!-- Lodging -->
      <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-10 w-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dt class="text-sm font-medium text-gray-500 truncate">Active Lodging</dt>
              <dd class="flex items-baseline">
                <div class="text-3xl font-semibold text-gray-900" id="active-lodging">-</div>
              </dd>
            </div>
          </div>
          <div class="mt-4">
            <div class="text-sm text-gray-600" id="upcoming-checkouts"></div>
            <a href="/lodging" class="text-sm font-medium text-primary-600 hover:text-primary-700">View lodging →</a>
          </div>
        </div>
      </div>

      <!-- Finance Tools -->
      <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-10 w-10 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dt class="text-sm font-medium text-gray-500 truncate">Finance Activity</dt>
              <dd class="flex items-baseline">
                <div class="text-3xl font-semibold text-gray-900" id="finance-activity">-</div>
              </dd>
            </div>
          </div>
          <div class="mt-4">
            <div class="text-sm text-gray-600" id="finance-breakdown"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white shadow-sm rounded-lg border border-gray-200">
      <div class="px-6 py-5">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
          <a
            href="/jobs"
            class="inline-flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            New Job
          </a>
          <a
            href="/bids"
            class="inline-flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-yellow-600 hover:bg-yellow-700 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            New Bid
          </a>
          <a
            href="/lodging"
            class="inline-flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add Lodging
          </a>
          <a
            href="/concur"
            class="inline-flex items-center justify-center px-4 py-3 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition-colors"
          >
            Concur Converter
          </a>
          <a
            href="/reconciliation"
            class="inline-flex items-center justify-center px-4 py-3 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition-colors"
          >
            Reconciliation
          </a>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Recent Jobs -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-5">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Recent Jobs</h2>
          <div id="recent-jobs" class="space-y-3">
            <div class="animate-pulse space-y-3">
              <div class="h-16 bg-gray-200 rounded"></div>
              <div class="h-16 bg-gray-200 rounded"></div>
              <div class="h-16 bg-gray-200 rounded"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Active Bids -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-5">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Active Bids</h2>
          <div id="active-bids" class="space-y-3">
            <div class="animate-pulse space-y-3">
              <div class="h-16 bg-gray-200 rounded"></div>
              <div class="h-16 bg-gray-200 rounded"></div>
              <div class="h-16 bg-gray-200 rounded"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL || (import.meta.env.DEV ? 'http://localhost:8080/api' : '');
    const token = localStorage.getItem('jbs_token');

    async function loadDashboard() {
      try {
        // Fetch all data in parallel
        const [jobsRes, bidsRes, lodgingRes, concurRes, reconRes] = await Promise.all([
          fetch(`${API_URL}/jobs`, { headers: { 'Authorization': `Bearer ${token}` } }),
          fetch(`${API_URL}/bids`, { headers: { 'Authorization': `Bearer ${token}` } }),
          fetch(`${API_URL}/lodging`, { headers: { 'Authorization': `Bearer ${token}` } }),
          fetch(`${API_URL}/concur/history`, { headers: { 'Authorization': `Bearer ${token}` } }),
          fetch(`${API_URL}/reconciliation/history`, { headers: { 'Authorization': `Bearer ${token}` } })
        ]);

        const jobs = jobsRes.ok ? await jobsRes.json() : [];
        const bids = bidsRes.ok ? await bidsRes.json() : [];
        const lodging = lodgingRes.ok ? await lodgingRes.json() : [];
        const concurHistory = concurRes.ok ? await concurRes.json() : [];
        const reconHistory = reconRes.ok ? await reconRes.json() : [];

        // Update Jobs stats
        const activeJobs = jobs.filter((j: any) => j.status === 'active').length;
        document.getElementById('active-jobs')!.textContent = activeJobs.toString();
        document.getElementById('total-jobs')!.textContent = `of ${jobs.length} total`;

        // Update Bids stats
        const activeBids = bids.filter((b: any) => b.status === 'prospecting' || b.status === 'submitted');
        const pipelineValue = activeBids.reduce((sum: number, b: any) => sum + (parseFloat(b.bid_amount) || 0), 0);
        document.getElementById('pipeline-value')!.textContent = `$${(pipelineValue / 1000).toFixed(0)}K`;
        
        const bidsByStatus = {
          prospecting: bids.filter((b: any) => b.status === 'prospecting').length,
          submitted: bids.filter((b: any) => b.status === 'submitted').length,
          won: bids.filter((b: any) => b.status === 'won').length
        };
        document.getElementById('bid-breakdown')!.textContent = 
          `${bidsByStatus.prospecting} prospecting, ${bidsByStatus.submitted} submitted, ${bidsByStatus.won} won`;

        // Update Lodging stats
        const now = new Date();
        const activeLodging = lodging.filter((l: any) => {
          const checkIn = new Date(l.check_in_date);
          const checkOut = l.check_out_date ? new Date(l.check_out_date) : null;
          return now >= checkIn && (!checkOut || now <= checkOut);
        });
        document.getElementById('active-lodging')!.textContent = activeLodging.length.toString();

        // Find upcoming checkouts (within 7 days)
        const upcomingCheckouts = lodging.filter((l: any) => {
          if (!l.check_out_date) return false;
          const checkOut = new Date(l.check_out_date);
          const daysUntil = Math.ceil((checkOut.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
          return daysUntil >= 0 && daysUntil <= 7;
        });
        document.getElementById('upcoming-checkouts')!.textContent = 
          upcomingCheckouts.length > 0 ? `${upcomingCheckouts.length} checkout${upcomingCheckouts.length > 1 ? 's' : ''} this week` : 'No upcoming checkouts';

        // Update Finance stats
        const totalFinance = concurHistory.length + reconHistory.length;
        document.getElementById('finance-activity')!.textContent = totalFinance.toString();
        document.getElementById('finance-breakdown')!.textContent = 
          `${concurHistory.length} Concur, ${reconHistory.length} Reconciliation`;

        // Render Recent Jobs
        const recentJobs = jobs
          .sort((a: any, b: any) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime())
          .slice(0, 3);
        
        const recentJobsEl = document.getElementById('recent-jobs');
        if (recentJobs.length === 0) {
          recentJobsEl!.innerHTML = '<p class="text-sm text-gray-500 text-center py-8">No jobs yet</p>';
        } else {
          recentJobsEl!.innerHTML = recentJobs.map((job: any) => `
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate">${job.job_number}</p>
                <p class="text-sm text-gray-600 truncate">${job.project_name || 'Untitled'}</p>
              </div>
              <span class="ml-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                job.status === 'active' ? 'bg-green-100 text-green-800' : 
                job.status === 'completed' ? 'bg-blue-100 text-blue-800' : 
                'bg-yellow-100 text-yellow-800'
              }">${job.status}</span>
            </div>
          `).join('');
        }

        // Render Active Bids
        const activeBidsList = bids
          .filter((b: any) => b.status === 'prospecting' || b.status === 'submitted')
          .sort((a: any, b: any) => {
            if (!a.due_date) return 1;
            if (!b.due_date) return -1;
            return new Date(a.due_date).getTime() - new Date(b.due_date).getTime();
          })
          .slice(0, 3);
        
        const activeBidsEl = document.getElementById('active-bids');
        if (activeBidsList.length === 0) {
          activeBidsEl!.innerHTML = '<p class="text-sm text-gray-500 text-center py-8">No active bids</p>';
        } else {
          activeBidsEl!.innerHTML = activeBidsList.map((bid: any) => `
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate">${bid.project_name}</p>
                <p class="text-sm text-gray-600 truncate">${bid.client_name}</p>
              </div>
              <div class="ml-3 text-right">
                <p class="text-sm font-semibold text-primary-600">$${(parseFloat(bid.bid_amount) / 1000).toFixed(0)}K</p>
                ${bid.due_date ? `<p class="text-xs text-gray-500">${formatDate(bid.due_date)}</p>` : ''}
              </div>
            </div>
          `).join('');
        }

      } catch (error) {
        console.error('Error loading dashboard:', error);
      }
    }

    function formatDate(dateStr: string): string {
      const date = new Date(dateStr);
      const now = new Date();
      const diffDays = Math.ceil((date.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
      
      if (diffDays === 0) return 'Today';
      if (diffDays === 1) return 'Tomorrow';
      if (diffDays < 0) return 'Overdue';
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    // Load dashboard on page load
    loadDashboard();
  </script>
</Layout>

