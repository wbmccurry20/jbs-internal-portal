---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Change Password · JBS Portal">
  <div class="mx-auto max-w-md py-12">
    <div class="mb-8 text-center">
      <p class="page-header__eyebrow">Account</p>
      <h1 class="page-title text-4xl">Change Password</h1>
      <p class="mt-2 text-sm text-slate-600">Update your account password</p>
    </div>

    <div class="card p-6">
      <form id="change-password-form" class="space-y-5">
        <div>
          <label for="current-password" class="field-label">Current password</label>
          <input
            type="password"
            id="current-password"
            required
            class="form-input"
          />
        </div>

        <div>
          <label for="new-password" class="field-label">New password</label>
          <input
            type="password"
            id="new-password"
            required
            minlength="10"
            class="form-input"
          />
          <p class="mt-1 text-xs text-slate-500">At least 10 characters with uppercase, lowercase, and a number</p>
        </div>

        <div>
          <label for="confirm-password" class="field-label">Confirm new password</label>
          <input
            type="password"
            id="confirm-password"
            required
            minlength="10"
            class="form-input"
          />
        </div>

        <div class="flex gap-3 pt-2">
          <button type="submit" id="submit-btn" class="btn-primary flex-1">
            Change Password
          </button>
          <a href="/dashboard" class="btn-secondary flex-1">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { changePassword } from '../lib/api';
    import { toast } from '../utils/toast';
    import { ErrorHandler } from '../utils/errorHandler';
    import { setButtonLoading } from '../utils/loading';

    const token = localStorage.getItem('jbs_token');
    if (!token) {
      window.location.href = '/';
    }

    const form = document.getElementById('change-password-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const currentPassword = (document.getElementById('current-password') as HTMLInputElement).value;
      const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;

      // Validate passwords match
      if (newPassword !== confirmPassword) {
        ErrorHandler.handleValidationError('Passwords', 'New passwords do not match');
        return;
      }

      // Validate password strength
      if (newPassword.length < 10) {
        ErrorHandler.handleValidationError('Password', 'Must be at least 10 characters');
        return;
      }
      if (!/[A-Z]/.test(newPassword) || !/[a-z]/.test(newPassword) || !/[0-9]/.test(newPassword)) {
        ErrorHandler.handleValidationError('Password', 'Must contain uppercase, lowercase, and a number');
        return;
      }

      setButtonLoading(submitBtn, true);

      try {
        await changePassword(currentPassword, newPassword);
        
        toast.success('Password changed successfully! Redirecting...');
        
        // Clear form
        form.reset();

        // Redirect after 2 seconds
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 2000);
      } catch (error) {
        ErrorHandler.handle(error, 'Failed to change password');
      } finally {
        setButtonLoading(submitBtn, false);
      }
    });
  </script>
</Layout>
