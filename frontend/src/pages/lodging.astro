---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="space-y-6">
    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Superintendent Lodging</h1>
        <p class="mt-2 text-sm text-gray-600">Track housing and accommodations for field staff</p>
      </div>
      <button id="create-lodging-btn" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 shadow-sm transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        Add Lodging
      </button>
    </div>

    <!-- Filters and view toggle -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
          <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search</label>
          <input 
            type="text" 
            id="search" 
            placeholder="Search superintendent, location..." 
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
          >
        </div>
        <div>
          <label for="status-filter" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
          <select id="status-filter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="">All</option>
            <option value="active">Active</option>
            <option value="upcoming">Upcoming</option>
            <option value="completed">Completed</option>
          </select>
        </div>
        <div>
          <label for="sort" class="block text-sm font-medium text-gray-700 mb-1">Sort By</label>
          <select id="sort" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="checkin">Check-in Date</option>
            <option value="checkout">Check-out Date</option>
            <option value="super">Superintendent</option>
            <option value="cost">Cost</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">View</label>
          <div class="flex space-x-2">
            <button id="view-list" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 font-medium bg-primary-50 text-primary-600 border-primary-300">
              List
            </button>
            <button id="view-calendar" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 font-medium">
              Calendar
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- List view -->
    <div id="list-view" class="space-y-4">
      <!-- Loading state -->
      <div id="loading" class="text-center py-12">
        <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600"></div>
        <p class="mt-4 text-gray-600">Loading lodging...</p>
      </div>
    </div>

    <!-- Calendar view (simplified placeholder) -->
    <div id="calendar-view" class="hidden">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center">
        <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <h3 class="mt-4 text-lg font-medium text-gray-900">Calendar View Coming Soon</h3>
        <p class="mt-2 text-sm text-gray-500">Use the list view to manage lodging for now.</p>
      </div>
    </div>
  </div>

  <!-- Lodging Modal -->
  <div id="lodging-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-full max-w-2xl shadow-lg rounded-lg bg-white">
      <div class="flex justify-between items-center mb-4">
        <h3 id="modal-title" class="text-2xl font-bold text-gray-900">Add Lodging</h3>
        <button id="close-modal" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="lodging-form" class="space-y-4">
        <input type="hidden" id="lodging-id">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="superintendent" class="block text-sm font-medium text-gray-700 mb-1">Superintendent *</label>
            <input type="text" id="superintendent" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="job-number" class="block text-sm font-medium text-gray-700 mb-1">Job Number</label>
            <input type="text" id="job-number" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div>
          <label for="location" class="block text-sm font-medium text-gray-700 mb-1">Location/Property Name *</label>
          <input type="text" id="location" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div>
          <label for="address" class="block text-sm font-medium text-gray-700 mb-1">Address</label>
          <input type="text" id="address" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div>
            <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City</label>
            <input type="text" id="city" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="state" class="block text-sm font-medium text-gray-700 mb-1">State</label>
            <input type="text" id="state" maxlength="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="zip" class="block text-sm font-medium text-gray-700 mb-1">ZIP</label>
            <input type="text" id="zip" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="check-in" class="block text-sm font-medium text-gray-700 mb-1">Check-in Date *</label>
            <input type="date" id="check-in" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="check-out" class="block text-sm font-medium text-gray-700 mb-1">Check-out Date</label>
            <input type="date" id="check-out" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="cost-per-night" class="block text-sm font-medium text-gray-700 mb-1">Cost per Night</label>
            <input type="number" id="cost-per-night" step="0.01" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Contact Phone</label>
            <input type="tel" id="phone" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
          <textarea id="notes" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"></textarea>
        </div>

        <div class="flex justify-end space-x-3 pt-4">
          <button type="button" id="cancel-btn" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium">
            Cancel
          </button>
          <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-medium">
            Save Lodging
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function escapeHtml(str: string): string {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    const API_URL = import.meta.env.PUBLIC_API_URL || (import.meta.env.DEV ? 'http://localhost:8080/api' : '');
    const token = localStorage.getItem('jbs_token');
    const userStr = localStorage.getItem('jbs_user');
    let currentUser: any = null;

    if (userStr) {
      try {
        currentUser = JSON.parse(userStr);
      } catch (error) {
        console.error('Error parsing user:', error);
      }
    }

    let lodgings: any[] = [];
    let filteredLodgings: any[] = [];
    let editingLodgingId: number | null = null;

    // Fetch lodging
    async function fetchLodging() {
      try {
        const response = await fetch(`${API_URL}/lodging`, {
          headers: {
            'Authorization': `Bearer ${token}`
          }
        });

        if (!response.ok) throw new Error('Failed to fetch lodging');
        
        lodgings = await response.json();
        filteredLodgings = lodgings;
        renderLodging();
      } catch (error) {
        console.error('Error fetching lodging:', error);
        showError('Failed to load lodging');
      }
    }

    // Determine status based on dates
    function getLodgingStatus(checkIn: string, checkOut: string | null): string {
      const now = new Date();
      const checkInDate = new Date(checkIn);
      const checkOutDate = checkOut ? new Date(checkOut) : null;

      if (checkOutDate && now > checkOutDate) {
        return 'completed';
      } else if (now >= checkInDate && (!checkOutDate || now <= checkOutDate)) {
        return 'active';
      } else {
        return 'upcoming';
      }
    }

    // Render lodging list
    function renderLodging() {
      const container = document.getElementById('list-view');
      const loading = document.getElementById('loading');
      
      if (loading) loading.classList.add('hidden');
      
      if (!container) return;

      if (filteredLodgings.length === 0) {
        container.innerHTML = `
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
            <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            <h3 class="mt-4 text-lg font-medium text-gray-900">No lodging records found</h3>
            <p class="mt-2 text-sm text-gray-500">Add housing information for your superintendents.</p>
          </div>
        `;
        return;
      }

      const canDelete = currentUser?.role === 'executive' || currentUser?.role === 'support';

      container.innerHTML = filteredLodgings.map(lodging => {
        const status = getLodgingStatus(lodging.check_in_date, lodging.check_out_date);
        const statusColors: any = {
          'active': 'bg-green-100 text-green-800',
          'upcoming': 'bg-blue-100 text-blue-800',
          'completed': 'bg-gray-100 text-gray-800'
        };

        return `
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <h3 class="text-xl font-semibold text-gray-900">${escapeHtml(lodging.superintendent_name)}</h3>
                  <span class="px-3 py-1 text-xs font-semibold rounded-full ${statusColors[status]}">${escapeHtml(status)}</span>
                  ${lodging.job_number ? `<span class="text-sm text-gray-500">#${escapeHtml(lodging.job_number)}</span>` : ''}
                </div>
                <p class="text-lg text-gray-700 mb-2">🏨 ${escapeHtml(lodging.location)}</p>
                <div class="text-sm text-gray-600 space-y-1">
                  ${lodging.address ? `<p>📍 ${escapeHtml(lodging.address)}${lodging.city ? `, ${escapeHtml(lodging.city)}` : ''}${lodging.state ? `, ${escapeHtml(lodging.state)}` : ''}</p>` : ''}
                  <p>📅 ${formatDate(lodging.check_in_date)} → ${lodging.check_out_date ? formatDate(lodging.check_out_date) : 'Ongoing'}</p>
                  ${lodging.cost_per_night ? `<p>💵 $${parseFloat(lodging.cost_per_night).toFixed(2)}/night</p>` : ''}
                  ${lodging.contact_phone ? `<p>📞 ${escapeHtml(lodging.contact_phone)}</p>` : ''}
                </div>
                ${lodging.notes ? `<p class="mt-3 text-sm text-gray-500 italic">${escapeHtml(lodging.notes)}</p>` : ''}
              </div>
              <div class="flex space-x-2 ml-4">
                <button onclick="editLodging(${lodging.id})" class="p-2 text-primary-600 hover:bg-primary-50 rounded-lg transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                </button>
                ${canDelete ? `
                  <button onclick="deleteLodging(${lodging.id})" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  </button>
                ` : ''}
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function formatDate(dateStr: string): string {
      const date = new Date(dateStr);
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    // Filter and search
    document.getElementById('search')?.addEventListener('input', applyFilters);
    document.getElementById('status-filter')?.addEventListener('change', applyFilters);
    document.getElementById('sort')?.addEventListener('change', applyFilters);

    function applyFilters() {
      const search = (document.getElementById('search') as HTMLInputElement)?.value.toLowerCase() || '';
      const statusFilter = (document.getElementById('status-filter') as HTMLSelectElement)?.value || '';
      const sort = (document.getElementById('sort') as HTMLSelectElement)?.value || 'checkin';

      filteredLodgings = lodgings.filter(lodging => {
        const matchesSearch = !search || 
          lodging.superintendent_name?.toLowerCase().includes(search) ||
          lodging.location?.toLowerCase().includes(search) ||
          lodging.job_number?.toLowerCase().includes(search);
        
        const status = getLodgingStatus(lodging.check_in_date, lodging.check_out_date);
        const matchesStatus = !statusFilter || status === statusFilter;
        
        return matchesSearch && matchesStatus;
      });

      // Sort
      filteredLodgings.sort((a, b) => {
        if (sort === 'checkin') return new Date(a.check_in_date).getTime() - new Date(b.check_in_date).getTime();
        if (sort === 'checkout') {
          const aDate = a.check_out_date ? new Date(a.check_out_date).getTime() : Infinity;
          const bDate = b.check_out_date ? new Date(b.check_out_date).getTime() : Infinity;
          return aDate - bDate;
        }
        if (sort === 'super') return (a.superintendent_name || '').localeCompare(b.superintendent_name || '');
        if (sort === 'cost') return (parseFloat(b.cost_per_night || 0) - parseFloat(a.cost_per_night || 0));
        return 0;
      });

      renderLodging();
    }

    // View toggle
    document.getElementById('view-list')?.addEventListener('click', () => {
      document.getElementById('list-view')?.classList.remove('hidden');
      document.getElementById('calendar-view')?.classList.add('hidden');
      document.getElementById('view-list')?.classList.add('bg-primary-50', 'text-primary-600', 'border-primary-300');
      document.getElementById('view-calendar')?.classList.remove('bg-primary-50', 'text-primary-600', 'border-primary-300');
    });

    document.getElementById('view-calendar')?.addEventListener('click', () => {
      document.getElementById('list-view')?.classList.add('hidden');
      document.getElementById('calendar-view')?.classList.remove('hidden');
      document.getElementById('view-calendar')?.classList.add('bg-primary-50', 'text-primary-600', 'border-primary-300');
      document.getElementById('view-list')?.classList.remove('bg-primary-50', 'text-primary-600', 'border-primary-300');
    });

    // Modal handling
    const modal = document.getElementById('lodging-modal');
    const form = document.getElementById('lodging-form');

    document.getElementById('create-lodging-btn')?.addEventListener('click', () => {
      editingLodgingId = null;
      (document.getElementById('modal-title') as HTMLElement).textContent = 'Add Lodging';
      (form as HTMLFormElement)?.reset();
      modal?.classList.remove('hidden');
    });

    document.getElementById('close-modal')?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    document.getElementById('cancel-btn')?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    // Edit lodging
    (window as any).editLodging = function(id: number) {
      const lodging = lodgings.find(l => l.id === id);
      if (!lodging) return;

      editingLodgingId = id;
      (document.getElementById('modal-title') as HTMLElement).textContent = 'Edit Lodging';
      (document.getElementById('superintendent') as HTMLInputElement).value = lodging.superintendent_name || '';
      (document.getElementById('job-number') as HTMLInputElement).value = lodging.job_number || '';
      (document.getElementById('location') as HTMLInputElement).value = lodging.location || '';
      (document.getElementById('address') as HTMLInputElement).value = lodging.address || '';
      (document.getElementById('city') as HTMLInputElement).value = lodging.city || '';
      (document.getElementById('state') as HTMLInputElement).value = lodging.state || '';
      (document.getElementById('zip') as HTMLInputElement).value = lodging.zip || '';
      (document.getElementById('check-in') as HTMLInputElement).value = lodging.check_in_date ? lodging.check_in_date.split('T')[0] : '';
      (document.getElementById('check-out') as HTMLInputElement).value = lodging.check_out_date ? lodging.check_out_date.split('T')[0] : '';
      (document.getElementById('cost-per-night') as HTMLInputElement).value = lodging.cost_per_night || '';
      (document.getElementById('phone') as HTMLInputElement).value = lodging.contact_phone || '';
      (document.getElementById('notes') as HTMLTextAreaElement).value = lodging.notes || '';

      modal?.classList.remove('hidden');
    };

    // Delete lodging
    (window as any).deleteLodging = async function(id: number) {
      if (!confirm('Are you sure you want to delete this lodging record?')) return;

      try {
        const response = await fetch(`${API_URL}/lodging/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${token}`
          }
        });

        if (!response.ok) throw new Error('Failed to delete lodging');
        
        showSuccess('Lodging deleted successfully');
        await fetchLodging();
      } catch (error) {
        console.error('Error deleting lodging:', error);
        showError('Failed to delete lodging');
      }
    };

    // Submit form
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = {
        superintendent_name: (document.getElementById('superintendent') as HTMLInputElement).value,
        job_number: (document.getElementById('job-number') as HTMLInputElement).value || null,
        location: (document.getElementById('location') as HTMLInputElement).value,
        address: (document.getElementById('address') as HTMLInputElement).value || null,
        city: (document.getElementById('city') as HTMLInputElement).value || null,
        state: (document.getElementById('state') as HTMLInputElement).value || null,
        zip: (document.getElementById('zip') as HTMLInputElement).value || null,
        check_in_date: (document.getElementById('check-in') as HTMLInputElement).value,
        check_out_date: (document.getElementById('check-out') as HTMLInputElement).value || null,
        cost_per_night: (document.getElementById('cost-per-night') as HTMLInputElement).value || null,
        contact_phone: (document.getElementById('phone') as HTMLInputElement).value || null,
        notes: (document.getElementById('notes') as HTMLTextAreaElement).value || null
      };

      try {
        const url = editingLodgingId ? `${API_URL}/lodging/${editingLodgingId}` : `${API_URL}/lodging`;
        const method = editingLodgingId ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method,
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        if (!response.ok) throw new Error(`Failed to ${editingLodgingId ? 'update' : 'create'} lodging`);
        
        showSuccess(`Lodging ${editingLodgingId ? 'updated' : 'created'} successfully`);
        modal?.classList.add('hidden');
        await fetchLodging();
      } catch (error) {
        console.error('Error saving lodging:', error);
        showError(`Failed to ${editingLodgingId ? 'update' : 'create'} lodging`);
      }
    });

    function showSuccess(message: string) {
      alert(message);
    }

    function showError(message: string) {
      alert(message);
    }

    // Initial load
    fetchLodging();
  </script>
</Layout>
