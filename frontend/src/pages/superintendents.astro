---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Superintendents">
  <div class="space-y-6">
    <!-- Page header -->
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Superintendents</h1>
      <p class="mt-2 text-sm text-gray-600">Manage superintendent lodging and schedules</p>
    </div>

    <!-- Tab navigation -->
    <div class="border-b border-gray-200">
      <nav class="-mb-px flex space-x-8">
        <button id="tab-lodging" class="tab-btn border-primary-500 text-primary-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" data-tab="lodging">
          <svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          Lodging
        </button>
        <button id="tab-schedule" class="tab-btn border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" data-tab="schedule">
          <svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          Schedule
        </button>
      </nav>
    </div>

    <!-- ====== Lodging Tab ====== -->
    <div id="content-lodging" class="tab-content">
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <h2 class="text-xl font-semibold text-gray-900">Superintendent Lodging</h2>
          <button id="create-lodging-btn" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 shadow-sm transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
            Add Lodging
          </button>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search</label>
              <input type="text" id="search" placeholder="Search superintendent, location..." class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            </div>
            <div>
              <label for="status-filter" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
              <select id="status-filter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                <option value="">All</option>
                <option value="active">Active</option>
                <option value="upcoming">Upcoming</option>
                <option value="completed">Completed</option>
              </select>
            </div>
            <div>
              <label for="super-filter" class="block text-sm font-medium text-gray-700 mb-1">Superintendent</label>
              <select id="super-filter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                <option value="">All</option>
              </select>
            </div>
          </div>
        </div>

        <!-- List -->
        <div id="lodging-list" class="space-y-4">
          <div id="loading" class="text-center py-12">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600"></div>
            <p class="mt-4 text-gray-600">Loading lodging...</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ====== Schedule Tab ====== -->
    <div id="content-schedule" class="tab-content hidden">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
        <svg class="mx-auto h-20 w-20 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        <h3 class="mt-6 text-xl font-semibold text-gray-900">Superintendent Schedule</h3>
        <p class="mt-2 text-sm text-gray-600 max-w-md mx-auto">Schedule view coming soon. Track superintendent assignments, project timelines, and availability.</p>
      </div>
    </div>
  </div>

  <!-- ====== Lodging Modal ====== -->
  <div id="lodging-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-full max-w-2xl shadow-lg rounded-lg bg-white">
      <div class="flex justify-between items-center mb-4">
        <h3 id="modal-title" class="text-2xl font-bold text-gray-900">Add Lodging</h3>
        <button id="close-modal" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <form id="lodging-form" class="space-y-4">
        <input type="hidden" id="lodging-id">

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="superintendent-id" class="block text-sm font-medium text-gray-700 mb-1">Superintendent *</label>
            <select id="superintendent-id" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="">Select superintendent...</option>
            </select>
          </div>
          <div>
            <label for="job-id" class="block text-sm font-medium text-gray-700 mb-1">Job</label>
            <select id="job-id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="">No job linked</option>
            </select>
          </div>
        </div>

        <div>
          <label for="location" class="block text-sm font-medium text-gray-700 mb-1">Location / Property Name *</label>
          <input type="text" id="location" required placeholder="e.g. Marriott Courtyard Downtown" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div>
          <label for="address" class="block text-sm font-medium text-gray-700 mb-1">Address</label>
          <input type="text" id="address" placeholder="123 Main St, City, State" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div>
          <label for="jobsite-address" class="block text-sm font-medium text-gray-700 mb-1">Jobsite Address</label>
          <input type="text" id="jobsite-address" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="check-in" class="block text-sm font-medium text-gray-700 mb-1">Check-in Date</label>
            <input type="date" id="check-in" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="check-out" class="block text-sm font-medium text-gray-700 mb-1">Check-out Date</label>
            <input type="date" id="check-out" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="cost-per-night" class="block text-sm font-medium text-gray-700 mb-1">Cost per Night</label>
            <input type="number" id="cost-per-night" step="0.01" placeholder="0.00" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="total-cost" class="block text-sm font-medium text-gray-700 mb-1">Total Cost</label>
            <input type="number" id="total-cost" step="0.01" placeholder="0.00" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="property-link" class="block text-sm font-medium text-gray-700 mb-1">Property Link</label>
            <input type="url" id="property-link" placeholder="https://..." class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label for="booking-confirmation" class="block text-sm font-medium text-gray-700 mb-1">Booking Confirmation #</label>
            <input type="text" id="booking-confirmation" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>

        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
          <textarea id="notes" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"></textarea>
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t">
          <button type="button" id="cancel-btn" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium">Cancel</button>
          <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-medium">Save Lodging</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { escapeHtml } from '../utils/html';
    import { getApiUrl } from '../utils/api';
    import { toast } from '../utils/toast';

    const API_URL = getApiUrl();
    const token = localStorage.getItem('jbs_token');

    interface Superintendent { id: number; name: string; }
    interface Job { id: number; job_number: string; job_name: string; }
    interface Lodging {
      id: number;
      superintendent_id: number;
      job_id: number | null;
      location: string;
      address: string;
      jobsite_address: string;
      check_in_date: string | null;
      check_out_date: string | null;
      property_link: string;
      cost_per_night: number | null;
      total_cost: number | null;
      booking_confirmation: string;
      notes: string;
      superintendent?: { id: number; name: string };
      job?: { id: number; job_number: string; job_name: string };
    }

    let supers: Superintendent[] = [];
    let jobs: Job[] = [];
    let lodgings: Lodging[] = [];
    let filtered: Lodging[] = [];
    let editingId: number | null = null;

    // ---- Tab switching ----
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab')!;
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.toggle('border-primary-500', b === btn);
          b.classList.toggle('text-primary-600', b === btn);
          b.classList.toggle('border-transparent', b !== btn);
          b.classList.toggle('text-gray-500', b !== btn);
        });
        document.querySelectorAll('.tab-content').forEach(c => {
          c.classList.toggle('hidden', c.id !== `content-${tab}`);
        });
      });
    });

    // ---- Load reference data ----
    async function loadReferenceData() {
      try {
        const [supersRes, jobsRes] = await Promise.all([
          fetch(`${API_URL}/superintendents`, { headers: { 'Authorization': `Bearer ${token}` } }),
          fetch(`${API_URL}/jobs`, { headers: { 'Authorization': `Bearer ${token}` } }),
        ]);
        if (supersRes.ok) supers = await supersRes.json();
        if (jobsRes.ok) jobs = await jobsRes.json();
        populateDropdowns();
      } catch (e) {
        console.error('Failed to load reference data:', e);
      }
    }

    function populateDropdowns() {
      // Superintendent select in form
      const superSelect = document.getElementById('superintendent-id') as HTMLSelectElement;
      if (superSelect) {
        superSelect.innerHTML = '<option value="">Select superintendent...</option>' +
          supers.map(s => `<option value="${s.id}">${escapeHtml(s.name)}</option>`).join('');
      }

      // Superintendent filter
      const superFilter = document.getElementById('super-filter') as HTMLSelectElement;
      if (superFilter) {
        superFilter.innerHTML = '<option value="">All</option>' +
          supers.map(s => `<option value="${s.id}">${escapeHtml(s.name)}</option>`).join('');
      }

      // Job select in form
      const jobSelect = document.getElementById('job-id') as HTMLSelectElement;
      if (jobSelect) {
        jobSelect.innerHTML = '<option value="">No job linked</option>' +
          jobs.map(j => `<option value="${(j as any).id}">${escapeHtml((j as any).job_number || '')} — ${escapeHtml((j as any).job_name || '')}</option>`).join('');
      }
    }

    // ---- Fetch lodging ----
    async function fetchLodging() {
      try {
        const res = await fetch(`${API_URL}/lodging`, { headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) throw new Error('Failed');
        lodgings = await res.json();
        applyFilters();
        document.getElementById('loading')?.classList.add('hidden');
      } catch (e) {
        console.error('Error fetching lodging:', e);
        toast.error('Failed to load lodging');
      }
    }

    // ---- Filtering ----
    document.getElementById('search')?.addEventListener('input', applyFilters);
    document.getElementById('status-filter')?.addEventListener('change', applyFilters);
    document.getElementById('super-filter')?.addEventListener('change', applyFilters);

    function getLodgingStatus(checkIn: string | null, checkOut: string | null): string {
      if (!checkIn) return 'upcoming';
      const now = new Date();
      const cin = new Date(checkIn);
      const cout = checkOut ? new Date(checkOut) : null;
      if (cout && now > cout) return 'completed';
      if (now >= cin && (!cout || now <= cout)) return 'active';
      return 'upcoming';
    }

    function applyFilters() {
      const search = (document.getElementById('search') as HTMLInputElement)?.value.toLowerCase() || '';
      const statusVal = (document.getElementById('status-filter') as HTMLSelectElement)?.value || '';
      const superVal = (document.getElementById('super-filter') as HTMLSelectElement)?.value || '';

      filtered = lodgings.filter(l => {
        const matchSearch = !search ||
          l.superintendent?.name?.toLowerCase().includes(search) ||
          l.location?.toLowerCase().includes(search) ||
          l.address?.toLowerCase().includes(search) ||
          l.job?.job_name?.toLowerCase().includes(search);
        const matchStatus = !statusVal || getLodgingStatus(l.check_in_date, l.check_out_date) === statusVal;
        const matchSuper = !superVal || String(l.superintendent_id) === superVal;
        return matchSearch && matchStatus && matchSuper;
      });

      renderLodging();
    }

    // ---- Render ----
    function renderLodging() {
      const container = document.getElementById('lodging-list')!;
      if (filtered.length === 0) {
        container.innerHTML = `<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
          <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          <h3 class="mt-4 text-lg font-medium text-gray-900">No lodging records</h3>
          <p class="mt-2 text-sm text-gray-500">Add housing information for superintendents.</p>
        </div>`;
        return;
      }

      const statusColors: Record<string, string> = {
        active: 'bg-green-100 text-green-800',
        upcoming: 'bg-blue-100 text-blue-800',
        completed: 'bg-gray-100 text-gray-800',
      };

      container.innerHTML = filtered.map(l => {
        const status = getLodgingStatus(l.check_in_date, l.check_out_date);
        return `
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <h3 class="text-lg font-semibold text-gray-900">${escapeHtml(l.superintendent?.name || 'Unknown')}</h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-medium ${statusColors[status]} capitalize">${escapeHtml(status)}</span>
                  ${l.job ? `<span class="text-sm text-gray-500">#${escapeHtml(l.job.job_number)}</span>` : ''}
                </div>
                <p class="text-gray-700 mb-2">🏨 ${escapeHtml(l.location || 'No location')}</p>
                <div class="text-sm text-gray-600 space-y-1">
                  ${l.address ? `<p>📍 ${escapeHtml(l.address)}</p>` : ''}
                  <p>📅 ${l.check_in_date ? formatDate(l.check_in_date) : 'TBD'} → ${l.check_out_date ? formatDate(l.check_out_date) : 'Ongoing'}</p>
                  ${l.cost_per_night ? `<p>💵 $${Number(l.cost_per_night).toFixed(2)}/night${l.total_cost ? ` (Total: $${Number(l.total_cost).toFixed(2)})` : ''}</p>` : ''}
                  ${l.booking_confirmation ? `<p>🔖 Confirmation: ${escapeHtml(l.booking_confirmation)}</p>` : ''}
                  ${l.property_link ? `<p>🔗 <a href="${escapeHtml(l.property_link)}" target="_blank" class="text-primary-600 hover:underline">Property link</a></p>` : ''}
                </div>
                ${l.notes ? `<p class="mt-3 text-sm text-gray-500 italic">${escapeHtml(l.notes)}</p>` : ''}
              </div>
              <div class="flex space-x-2 ml-4">
                <button onclick="editLodging(${l.id})" class="p-2 text-primary-600 hover:bg-primary-50 rounded-lg transition-colors" title="Edit">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                </button>
                <button onclick="deleteLodging(${l.id})" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Delete">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
              </div>
            </div>
          </div>`;
      }).join('');
    }

    function formatDate(d: string): string {
      return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    // ---- Modal ----
    const modal = document.getElementById('lodging-modal')!;
    const form = document.getElementById('lodging-form') as HTMLFormElement;

    document.getElementById('create-lodging-btn')?.addEventListener('click', () => {
      editingId = null;
      (document.getElementById('modal-title') as HTMLElement).textContent = 'Add Lodging';
      form.reset();
      modal.classList.remove('hidden');
    });
    document.getElementById('close-modal')?.addEventListener('click', () => modal.classList.add('hidden'));
    document.getElementById('cancel-btn')?.addEventListener('click', () => modal.classList.add('hidden'));

    // ---- Edit ----
    (window as any).editLodging = function(id: number) {
      const l = lodgings.find(x => x.id === id);
      if (!l) return;
      editingId = id;
      (document.getElementById('modal-title') as HTMLElement).textContent = 'Edit Lodging';
      (document.getElementById('superintendent-id') as HTMLSelectElement).value = String(l.superintendent_id);
      (document.getElementById('job-id') as HTMLSelectElement).value = l.job_id ? String(l.job_id) : '';
      (document.getElementById('location') as HTMLInputElement).value = l.location || '';
      (document.getElementById('address') as HTMLInputElement).value = l.address || '';
      (document.getElementById('jobsite-address') as HTMLInputElement).value = l.jobsite_address || '';
      (document.getElementById('check-in') as HTMLInputElement).value = l.check_in_date ? l.check_in_date.split('T')[0] : '';
      (document.getElementById('check-out') as HTMLInputElement).value = l.check_out_date ? l.check_out_date.split('T')[0] : '';
      (document.getElementById('cost-per-night') as HTMLInputElement).value = l.cost_per_night ? String(l.cost_per_night) : '';
      (document.getElementById('total-cost') as HTMLInputElement).value = l.total_cost ? String(l.total_cost) : '';
      (document.getElementById('property-link') as HTMLInputElement).value = l.property_link || '';
      (document.getElementById('booking-confirmation') as HTMLInputElement).value = l.booking_confirmation || '';
      (document.getElementById('notes') as HTMLTextAreaElement).value = l.notes || '';
      modal.classList.remove('hidden');
    };

    // ---- Delete ----
    (window as any).deleteLodging = async function(id: number) {
      if (!confirm('Delete this lodging record?')) return;
      try {
        const res = await fetch(`${API_URL}/lodging/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) throw new Error('Failed');
        await fetchLodging();
      } catch (e) {
        console.error(e);
        toast.error('Failed to delete lodging');
      }
    };

    // ---- Submit — fields match backend CreateLodgingRequest / UpdateLodgingRequest ----
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const superIdVal = (document.getElementById('superintendent-id') as HTMLSelectElement).value;
      const jobIdVal = (document.getElementById('job-id') as HTMLSelectElement).value;
      const checkInVal = (document.getElementById('check-in') as HTMLInputElement).value;
      const checkOutVal = (document.getElementById('check-out') as HTMLInputElement).value;
      const costVal = (document.getElementById('cost-per-night') as HTMLInputElement).value;
      const totalVal = (document.getElementById('total-cost') as HTMLInputElement).value;

      const data: Record<string, any> = {
        superintendent_id: parseInt(superIdVal),
        job_id: jobIdVal ? parseInt(jobIdVal) : null,
        location: (document.getElementById('location') as HTMLInputElement).value,
        address: (document.getElementById('address') as HTMLInputElement).value || '',
        jobsite_address: (document.getElementById('jobsite-address') as HTMLInputElement).value || '',
        check_in_date: checkInVal ? checkInVal + 'T00:00:00Z' : null,
        check_out_date: checkOutVal ? checkOutVal + 'T00:00:00Z' : null,
        cost_per_night: costVal ? parseFloat(costVal) : null,
        total_cost: totalVal ? parseFloat(totalVal) : null,
        property_link: (document.getElementById('property-link') as HTMLInputElement).value || '',
        booking_confirmation: (document.getElementById('booking-confirmation') as HTMLInputElement).value || '',
        notes: (document.getElementById('notes') as HTMLTextAreaElement).value || '',
      };

      try {
        const url = editingId ? `${API_URL}/lodging/${editingId}` : `${API_URL}/lodging`;
        const method = editingId ? 'PUT' : 'POST';
        const res = await fetch(url, {
          method,
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || 'Failed to save');
        }
        modal.classList.add('hidden');
        await fetchLodging();
      } catch (e: any) {
        console.error(e);
        toast.error(e.message || 'Failed to save lodging');
      }
    });

    // ---- Init ----
    loadReferenceData();
    fetchLodging();
  </script>
</Layout>
